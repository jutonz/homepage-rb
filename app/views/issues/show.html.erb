<%= render(
  HeaderComponent.new(title: "#{@issue.identifier} #{@issue.title}")
) do |header| %>
  <%= header.with_crumb("Home", home_path) %>
  <%= header.with_crumb("Projects", projects_path) %>
  <%= header.with_crumb(@issue.project.name, project_path(@issue.project)) %>

  <%= header.with_action do %>
    <%= link_to("Edit", edit_issue_path(@issue), class: "button") %>
  <% end %>

  <%= header.with_action do %>
    <%= button_to(
      "Delete",
      issue_path(@issue),
      method: :delete,
      data: {turbo_confirm: "Are you sure?"},
      class: "button button--danger"
    ) %>
  <% end %>
<% end %>

<div class="mb-4">
  <%= render(IssueStatusPillComponent.new(issue: @issue)) %>

  <% if @issue.pr_url %>
    <%= link_to(
      "Pull request",
      @issue.pr_url,
      target: "_blank",
      rel: "noopener noreferrer",
      class: "ml-3 text-blue-600 hover:text-blue-800"
    ) %>
  <% end %>
</div>

<% if @issue.description.present? %>
  <div class="prose prose-gray max-w-none">
    <%= @issue.description %>
  </div>
<% end %>
