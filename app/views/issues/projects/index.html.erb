<%= render(HeaderComponent.new(title: "Projects")) do |header| %>
  <%= header.with_crumb("Home", home_path) %>
  <%= header.with_crumb("Issues", issues_path) %>

  <%= header.with_action do %>
    <%= link_to("New Project", new_project_path, class: "button") %>
  <% end %>
<% end %>

<div class="flex flex-col gap-2">
  <% @projects.each do |project| %>
    <%= link_to(
      project_path(project),
      data: {role: "project"},
      class: "
        flex gap-3 p-4 break-words border border-gray-200 rounded-lg
        font-medium text-gray-900 hover:bg-gray-50 hover:border-gray-300
      "
    ) do %>
      <span class="min-w-0 text-gray-500"><%= project.key %></span>
      <span class="min-w-0"><%= project.name %></span>
    <% end %>
  <% end %>
</div>

<% if @projects.empty? %>
  <div class="text-center py-12 text-gray-500">
    <div class="text-lg font-medium mb-2">No projects yet</div>
  </div>
<% end %>
