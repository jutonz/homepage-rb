  # @return [Integer]
  #
  # pkg:gem/mutineer#lib/mutineer/kill_matrix.rb:64
  def kill_count(test); end

  # Tests that killed a mutant, where every mutant they killed has another killer.
  #
  # @return [Array<Array(String, String, String)>] sorted.
  #
  # pkg:gem/mutineer#lib/mutineer/kill_matrix.rb:81
