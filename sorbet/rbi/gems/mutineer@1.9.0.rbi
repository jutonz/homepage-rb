    # pkg:gem/mutineer#lib/mutineer/output_filter.rb:275
    def silence_stdio; end

    # `args` for spawn or system, with stdout and stderr sent to the null
    # device when the program's env hash sets a DATABASE_URL this process
    # does not know. The caller's own redirects of stdout and stderr are
    # dropped too: a target such as `err: :out` or `err: STDOUT` would still
    # reach this pipe, and Ruby refuses a stream given twice.
    #
    # @param args [Array] the arguments given to spawn or system.
    # @return [Array]
    #
    # pkg:gem/mutineer#lib/mutineer/output_filter.rb:246
    def spawn_args(args); end

    # The real stream for `name`.
    #
    # @param name [Symbol] `:stdout` or `:stderr`.
    # @return [IO]
    #
    # pkg:gem/mutineer#lib/mutineer/output_filter.rb:288
    def stream_io(name); end

    # Put the descriptors back and write every byte already queued. Does
    # nothing when {install} is not on. Safe to call twice. Does not kill the
    # copier: a slow stdout must still receive the report. A grandchild that
    # holds the pipe does not add a wait past {QUIET_POLL}, because the
    # copier stops reading once the pipe is empty.
    #
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/output_filter.rb:153
    def uninstall; end

    # Write to `$stdout` or `$stderr` when the caller replaced that variable
    # (a test capture). Otherwise write to the descriptor saved before
    # {install}, never back into the pipe.
    #
    # @param stream [Symbol]
    # @param data [String]
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/output_filter.rb:427
    def write_out(stream, data); end
  end
end

# Stops a fork child's copier before exec. The copier thread and its read
# end do not survive exec, so the program would write to a pipe nobody
# reads. Kernel#exec, Kernel.exec, and Process.exec are separate, so all
# three are wrapped.
#
# pkg:gem/mutineer#lib/mutineer/output_filter.rb:47
module Mutineer::OutputFilter::ExecHook
  # @return [void] does not return when exec succeeds.
  #
  # pkg:gem/mutineer#lib/mutineer/output_filter.rb:49
  def exec(*args); end
end

# Flushes the copier before exit!. exit! skips at_exit, and a forked
# test exits that way.
#
# pkg:gem/mutineer#lib/mutineer/output_filter.rb:76
module Mutineer::OutputFilter::ExitHook
  # @param status [Boolean, Integer]
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/output_filter.rb:79
  def exit!(status = T.unsafe(nil)); end
end

# Runs {after_fork!} in the child. Kernel#fork, Kernel.fork, and
# Process.fork are separate, so all three are wrapped.
#
# pkg:gem/mutineer#lib/mutineer/output_filter.rb:26
module Mutineer::OutputFilter::ForkHook
  # @return [Integer, nil] the child pid in the parent; nil in the child
  #   when no block is given.
  #
  # pkg:gem/mutineer#lib/mutineer/output_filter.rb:29
  def fork(*); end
end

# Seconds to wait for a last buffered chunk after {uninstall} closes this
# process's write end. A grandchild that still holds the pipe does not
# extend the wait. Bytes already read are written before the copier
# returns; a slow reader blocks that write, and the bytes are not dropped.
#
# pkg:gem/mutineer#lib/mutineer/output_filter.rb:22
Mutineer::OutputFilter::QUIET_POLL = T.let(T.unsafe(nil), Float)

# Drops a spawned program's output when its env hash sets a DATABASE_URL
# this process's copier does not know. A URL set in ENV first is known:
# the copier reads ENV. Process has no `system`, so it gets {SpawnHook}
# only.
#
# pkg:gem/mutineer#lib/mutineer/output_filter.rb:59
module Mutineer::OutputFilter::SpawnHook
  # @return [Integer] the child pid.
  #
  # pkg:gem/mutineer#lib/mutineer/output_filter.rb:61
  def spawn(*args); end
end

# The `system` form of {SpawnHook}, for Kernel#system and Kernel.system.
#
# pkg:gem/mutineer#lib/mutineer/output_filter.rb:67
module Mutineer::OutputFilter::SystemHook
  # @return [Boolean, nil] as Kernel#system.
  #
  # pkg:gem/mutineer#lib/mutineer/output_filter.rb:69
  def system(*args); end
end

# Source -> test pairing by path convention (#11). Pure stdlib path logic:
# no Rails, no class loading, no process. Six jobs:
#   * expand_sources — a directory argument becomes its sorted **/*.rb files;
#                     a file inside the root becomes its root-relative path.
#   * expand_test: one --test value (#380). A directory becomes the test
#                     files under it. A glob becomes the files it matches.
#                     An existing file stays as typed.
#   * resolve_test_map — expand each `tests:` map entry's source and test
#                     patterns (#382), clean and dedupe the file lists, and
#                     record every pattern that matched no file.
#   * mapped_tests_for — the mapped tests for one source from a resolved
#                     map, concatenated in entry order (#382).
#   * infer_tests    — a source's test files by convention (app/ and lib/
#                     sources map to test/.../_test.rb, test/.../<name>_*_test.rb,
#                     test/.../test_*.rb or spec/.../_spec.rb), preserving
#                     namespaced subdirectories. The first EXISTING exact
#                     candidate stays first. Split Minitest files join a
#                     Minitest match. A matched spec is left as that one file.
#                     A concern at app/<dir>/concerns/<rest>.rb with no test
#                     there also tries exact and split names at <dir>/<rest>.
#                     A longer source keeps its file. A model keeps a split
#                     file it already pairs with (#408).
#   * test_given_as_source? — whether a positional argument is a test file
#                     by these same names, given as a source by mistake
#                     after `--test` (#293).
#
# Independently unit-testable: every method is pure in/out over the
# filesystem, so the pairing contract is exercised with plain fixtures, no
# Rails, no fork.
#
# pkg:gem/mutineer#lib/mutineer/pairing.rb:35
module Mutineer::Pairing
  private

  # Ordered candidate test paths: _test.rb, then Minitest's test_*.rb, then
  # _spec.rb. lib/ sources also get the test/lib/... and spec/lib/... layouts.
  #
  # @param base [String] logical source path without extension.
  # @param lib [Boolean] whether the source originated from lib/.
  # @param prefer [String] preferred framework name.
  # @return [Array<String>] candidate test paths in preferred order.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:500
  def candidates(base, lib, prefer); end

  # True when a longer concern pairs with this split name.
  # The file sits under `app/<dir>/concerns/`, a directory
  # {longer_source_exists?} does not search for a namespace base.
  # The longer concern claims the name only when its `concerns/` path has
  # no test, because only then does it look at the namespace path.
  # A model keeps a split file it already pairs with (#408).
  #
  # @param root [String] expanded project root.
  # @param ns_base [String] namespace base, such as `models/storage/totaled`.
  # @param entry [String] test file basename.
  # @return [Boolean]
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:688
  def claimed_by_longer_concern?(root, ns_base, entry); end

  # True when a longer source file on disk owns this split test. `user.rb`
  # does not take `user_session_test.rb` when `user_session.rb` exists in the
  # same directory, under `app/`, or under `lib/`. An intermediate file
  # counts: `bar_upsert.rb` owns `bar_upsert_guards_test.rb`, so `bar.rb`
  # does not.
  #
  # @param root [String] expanded project root.
  # @param base [String] logical source path without extension.
  # @param entry [String] test file basename.
  # @param scanned_dir [String, nil] relative test directory being scanned.
  #   When set, a longer source claims the file only if that source searches
  #   this directory. An `app/` source does not take a `test/lib/` file.
  # @return [Boolean]
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:670
  def claimed_by_longer_source?(root, base, entry, scanned_dir = T.unsafe(nil)); end

  # How one --test value is read. Blank is not a directory: File.expand_path
  # of "" is the project root, and that would select every test.
  #
  # @param value [String] one --test value, as typed.
  # @param project_root [String] repository root.
  # @return [Symbol] :blank, :directory, :file, :glob, or :plain.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:84
  def classify_test_value(value, project_root:); end

  # Test files under a directory. The name rule is {TEST_NAME}. Dot entries
  # stay out, because Dir.glob skips them. The result is sorted.
  # The directory name is literal, even when it contains a pattern character.
  #
  # @param abs [String] absolute directory path.
  # @param root [String] expanded project root.
  # @param roots [Array<String>] the project root, expanded and real.
  # @return [Array<String>] root-relative paths, or absolute paths outside the root.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:198
  def directory_test_files(abs, root, roots); end

  # An existing file's root-relative path, or nil outside the root. Tries the
  # path as given, then with its directory resolved, so a path typed through
  # a symlinked parent (or macOS `/var` under a `/private/var` root) matches.
  # The file's own name is kept, so a symlinked file is not renamed.
  #
  # @param abs [String] expanded absolute path of an existing file.
  # @param roots [Array<String>] the project root, expanded and real.
  # @return [String, nil] root-relative path, or nil outside the root.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:363
  def existing_relative(abs, roots); end

  # Expand each pattern for one map key. An empty expansion records the
  # pattern under `unmatched`. Results are deduped and sorted.
  #
  # @api private
  # @param patterns [Array<String>] source or test patterns from one entry.
  # @param number [Integer] 1-based entry index.
  # @param key [String] `"sources"` or `"tests"`.
  # @param unmatched [Array<Hash>] accumulator for patterns with no file.
  # @yieldparam pattern [String] one pattern to expand.
  # @yieldreturn [Array<String>] matching file paths.
  # @return [Array<String>] cleaned, deduped, sorted paths.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:262
  def expand_map_patterns(patterns, number, key, unmatched); end

  # One map source pattern: Dir.glob then {expand_sources}, so a matched
  # directory becomes its `.rb` files and path spellings clean the same way.
  # Matches outside the project root are dropped (brace patterns like
  # `{..,app}/x.rb` can escape a text-only `..` check).
  #
  # @api private
  # @param pattern [String] relative source pattern.
  # @param root [String] expanded project root.
  # @param roots [Array<String>] the project root, expanded and real.
  # @return [Array<String>] matching source paths, sorted.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:280
  def expand_map_source_pattern(pattern, root, roots); end

  # Glob matches for a map `tests:` pattern. A matched directory expands with
  # {directory_test_files}; a matched file is kept as-is (no name filter).
  # `--test` globs still drop directories; only the map expands them (#382).
  #
  # @api private
  # @param pattern [String] relative or absolute glob.
  # @param root [String] expanded project root.
  # @param roots [Array<String>] the project root, expanded and real.
  # @return [Array<String>] matching test paths (may include outside-root paths).
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:337
  def expand_map_test_glob(pattern, root, roots); end

  # One map test pattern. Directories (typed or matched by a glob) expand
  # with the {TEST_NAME} filter, matching a typed `--test` directory. Files
  # a glob matches stay unfiltered (including `test_helper.rb`), matching
  # `--test` globs. A missing plain path is not a match. Matches outside the
  # project root are dropped (#382 review).
  #
  # @api private
  # @param pattern [String] relative test pattern.
  # @param root [String] expanded project root.
  # @param roots [Array<String>] the project root, expanded and real.
  # @return [Array<String>] matching test paths, sorted.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:310
  def expand_map_test_pattern(pattern, root, roots); end

  # Expand each positional source: a directory -> its sorted **/*.rb files
  # (relative to project_root); a file (or glob, or anything non-directory)
  # -> its path relative to project_root, so `./lib/x.rb` and an absolute
  # path pair like `lib/x.rb` (#104). A missing file, or one outside the
  # root, stays as typed. Flattened, deduped, order-stable.
  #
  # @param args [Array<String>] source paths or directories.
  # @param project_root [String] repository root for relative expansion.
  # @return [Array<String>] flattened, deduped source file list.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:47
  def expand_sources(args, project_root:); end

  # One --test value, as paths. [] means a directory or glob matched nothing.
  # A file stays as typed. A missing plain path stays as typed, so the CLI
  # can still say "no such file". Paths from a directory or glob are sorted.
  # Inside the project they are root-relative. Outside it they are absolute.
  #
  # @param value [String] one --test value, as typed.
  # @param project_root [String] repository root.
  # @return [Array<String>] matching paths, or [value] when it is not expanded.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:103
  def expand_test(value, project_root:); end

  # `Dir.children` with each name read as UTF-8, or binary when it is not (#346).
  #
  # @param dir [String] directory to list.
  # @return [Array<String>]
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:186
  def fs_children(dir); end

  # `Dir.glob` with each path read as UTF-8, or binary when it is not (#346).
  #
  # @param args [Array] arguments forwarded to {Dir.glob}.
  # @return [Array<String>]
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:178
  def fs_glob(*args, **kwargs); end

  # A glob match that is a file, as a stored path. Directories are dropped.
  #
  # @param match [String] path from Dir.glob.
  # @param root [String] expanded project root.
  # @param roots [Array<String>] the project root, expanded and real.
  # @return [String, nil] stored path, or nil when the match is not a file.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:244
  def glob_file(match, root, roots); end

  # A path used as a literal prefix in Dir.glob.
  #
  # @param path [String] directory path, relative or absolute.
  # @return [String] the same path with pattern characters escaped.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:170
  def glob_literal(path); end

  # Files a glob matches from the project root. Directories are ignored.
  # There is no test-name filter. An absolute pattern ignores base.
  # Dir.glob keeps a leading "./"; the path is then made root-relative.
  #
  # @param pattern [String] glob as typed.
  # @param root [String] expanded project root.
  # @param roots [Array<String>] the project root, expanded and real.
  # @return [Array<String>] sorted matching file paths.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:215
  def glob_test_files(pattern, root, roots); end

  # The first test path {#infer_tests} would run for a source, or nil.
  # `prefer` is the resolved framework ("minitest" | "rspec"): its candidates
  # are tried first, the other framework's as fallback, so a minitest default
  # still finds a spec and vice-versa.
  #
  # @param source_rel [String] relative source path.
  # @param project_root [String] repository root for existence checks.
  # @param prefer [String] preferred framework name.
  # @return [String, nil] existing test path or nil.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:398
  def infer_test(source_rel, project_root:, prefer: T.unsafe(nil)); end

  # Every test file convention pairs with a source. The first existing exact
  # candidate from {#candidates} stays first. Each `<basename>_*_test.rb` in
  # the mirrored test directory is added after it (#87). A spec that the exact
  # rules already found is left alone: split Minitest names do not join it
  # and do not replace it. When that list is empty, a concern tries the same
  # exact and split names at its namespace path (#408). The `concerns/` path
  # still wins when it has any test. A longer source, including a longer
  # concern, keeps a split file. A model keeps a split file it already pairs
  # with: this fallback does not take one away.
  #
  # @param source_rel [String] relative source path.
  # @param project_root [String] repository root for existence checks.
  # @param prefer [String] preferred framework name.
  # @return [Array<String>] existing test paths, exact candidate first.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:416
  def infer_tests(source_rel, project_root:, prefer: T.unsafe(nil)); end

  # True when `dir_abs` is the project root or a directory inside it.
  # A source path such as `../../evil.rb` must not list tests outside the project.
  #
  # @param dir_abs [String] expanded directory.
  # @param root_abs [String] expanded project root.
  # @return [Boolean]
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:629
  def inside_project?(dir_abs, root_abs); end

  # Strip the source root to a logical path (no ".rb") and flag lib/
  # sources. app/foo/bar.rb and lib/foo/bar.rb both -> "foo/bar"; anything
  # else -> the path minus ".rb" (still attempted). Namespaced subdirs are
  # preserved verbatim — structural, never constant resolution.
  #
  # @param source_rel [String] relative source path.
  # @return [Array(String, Boolean)] logical base path and whether it came from lib/.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:482
  def logical_path(source_rel); end

  # Longer basenames that own `entry`, one per prefix of its pieces.
  # `user_session__test.rb` yields nothing for `user_session`.
  #
  # @param name [String] shorter source basename without extension.
  # @param entry [String] test file basename.
  # @return [Array<String>] owner basenames without extension.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:726
  def longer_owner_stems(name, entry); end

  # True when `entry` is the exact test, or a split test with a non-empty
  # piece, for `stem`. `user_session__test.rb` is neither for
  # `user_session`, so that source does not take it from `user.rb`.
  #
  # @param entry [String] test file basename.
  # @param stem [String] longer source basename without extension.
  # @return [Boolean]
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:752
  def longer_owns_entry?(entry, stem); end

  # True when a longer source file exists beside this logical path.
  # The logical directory itself is checked, so `src/user_session.rb` owns
  # `test/src/user_session_test.rb`. `app/` and `lib/` are checked too, so an
  # `app/` source still yields the name to a `lib/` sibling and the reverse.
  #
  # @param root [String] expanded project root.
  # @param dir [String] logical directory, or `.` when the source has none.
  # @param stem [String] longer source basename without extension.
  # @param scanned_dir [String, nil] relative test directory being scanned.
  # @return [Boolean]
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:766
  def longer_source_exists?(root, dir, stem, scanned_dir = T.unsafe(nil)); end

  # Mapped test files for one source from a resolved map. Each entry whose
  # expanded sources include `source` contributes its tests, in entry order.
  # An unmatched source returns `[]`. Does not dedupe across entries; the
  # CLI unions the run's test list (#382).
  #
  # @param source [String] root-relative source path, as in the resolved map.
  # @param resolved [Hash{Symbol => Array}] result of {resolve_test_map}.
  # @return [Array<String>] mapped test paths in entry order.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:156
  def mapped_tests_for(source, resolved); end

  # Relative test directory for a logical source path. A source with no
  # subdirectory (`calc`) maps to `prefix` itself, not `prefix/.`.
  #
  # @param prefix [String] `test` or `test/lib`.
  # @param base [String] logical source path without extension.
  # @return [String] relative directory.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:594
  def mirror_dir(prefix, base); end

  # A directory match whose basename is a test name, as a stored path.
  #
  # @param match [String] path from Dir.glob.
  # @param root [String] expanded project root.
  # @param roots [Array<String>] the project root, expanded and real.
  # @return [String, nil] stored path, or nil when the match is not a test file.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:230
  def named_test_file(match, root, roots); end

  # Namespace mirror for a concern, or nil.
  # `app/<dir>/concerns/<rest>.rb` returns `<dir>/<rest>`.
  # `concerns` must sit directly under `app/<dir>`.
  #
  # @param source_rel [String] relative source path.
  # @return [String, nil] logical base without extension, or nil.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:468
  def namespace_base(source_rel); end

  # `app/<dir>/concerns/<rest-dir>` for a namespace base `<dir>/<rest>`.
  #
  # @param ns_base [String] namespace base from {namespace_base}.
  # @return [String, nil] relative concerns directory, or nil when the base
  #   has no rest path.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:708
  def namespace_concerns_dir(ns_base); end

  # Namespace exact and split tests for a concern whose `concerns/` path
  # has none. A split is left out only when a longer concern has no test
  # of its own and therefore pairs with that split. A longer model is
  # already left out by {split_test_files}. A spec stays the only file.
  #
  # @param ns [String] namespace base from {namespace_base}.
  # @param root [String] expanded project root.
  # @param prefer [String] preferred framework name.
  # @return [Array<String>] existing test paths, exact candidate first.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:451
  def namespace_tests(ns, root, prefer); end

  # Expand every entry of a checked `test_map` into cleaned file lists.
  # Source patterns use Dir.glob then {expand_sources}, so a directory
  # match becomes its `.rb` files and `./lib/a.rb` / `lib//a.rb` clean to
  # the same path. Test patterns go through {expand_test}; a missing plain
  # path is dropped (no match). Overlapping patterns keep each file once,
  # sorted. Patterns with no file are listed under `:unmatched` with a
  # 1-based entry number and the key (`"sources"` or `"tests"`). Does not
  # print or exit; the CLI reports unmatched patterns (#382).
  #
  # @param test_map [Array<Hash{Symbol => Array<String>}>] checked map entries
  #   with `:sources` and `:tests` pattern lists.
  # @param project_root [String] repository root for relative expansion.
  # @return [Hash{Symbol => Array}] `:entries` is
  #   `[{sources: [...], tests: [...]}, ...]`; `:unmatched` is
  #   `[{entry: Integer, key: String, pattern: String}, ...]`.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:131
  def resolve_test_map(test_map, project_root:); end

  # `abs` relative to the first of `roots` it is under, or nil. Text only: a
  # symlinked source keeps its own name (realpath would rename it to its
  # target and pair the wrong test). `roots` holds the root's real path too,
  # so the macOS `/var` vs `/private/var` alias still matches.
  #
  # @param abs [String] expanded absolute path.
  # @param roots [Array<String>] the project root, expanded and real.
  # @return [String, nil] root-relative path, or nil outside the root.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:376
  def root_relative(abs, roots); end

  # True when pairing this source looks in `scanned_dir`.
  #
  # @param source_rel [String] project-relative source path.
  # @param scanned_dir [String] relative test directory.
  # @return [Boolean]
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:784
  def source_searches_dir?(source_rel, scanned_dir); end

  # True when `entry` is `<name>_<piece>_test.rb` and not the exact
  # `<name>_test.rb` file.
  #
  # @param entry [String] test file basename.
  # @param name [String] source basename without extension.
  # @return [Boolean]
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:644
  def split_entry?(entry, name); end

  # `<basename>_*_test.rb` files in each mirrored test directory (#87). The
  # exact `<basename>_test.rb` name is not included. `lib/` sources also look
  # under `test/lib/`. Names are matched as text, not as a glob, so a basename
  # that contains `*` stays literal. `test/` comes before `test/lib/`, and
  # each directory is sorted.
  #
  # @param base [String] logical source path without extension.
  # @param lib [Boolean] whether the source originated from lib/.
  # @param root [String] expanded project root.
  # @return [Array<String>] relative split-test paths.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:581
  def split_test_files(base, lib, root); end

  # Split test files directly inside `dir_rel` (not in subdirectories).
  #
  # @param root [String] expanded project root.
  # @param dir_rel [String] relative directory.
  # @param name [String] source basename without extension.
  # @param base [String] logical source path without extension.
  # @return [Array<String>] sorted relative paths.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:606
  def split_tests_in(root, dir_rel, name, base); end

  # Whether the `run` guard rejects a positional argument as a test file
  # given as a source (#293). Segments are read from the path relative to
  # the root, so a `test/` folder above the project never counts. A
  # `*_test.rb` / `*_spec.rb` path is flagged when it has a `test/` or
  # `spec/` segment (the guard's original rule), or when it sits in the same
  # directory as a given test, which catches root-level tests. A
  # `test_*.rb` path is flagged only under the
  # project's top-level `test/` or `spec/`, because real sources use the
  # prefix (`lib/mutineer/test_runners.rb`, `lib/foo/test/test_app.rb`). A
  # source whose own test (`<stem>_test.rb`, `test_<stem>.rb`,
  # `<stem>_spec.rb`, or a split `<stem>_*_test.rb` not claimed by a longer
  # source on disk) sits beside it in the test set is not flagged. Paths
  # compare relative to the root, as in
  # {expand_sources} (the root's real path counts too, for macOS `/var` vs
  # `/private/var`), so `./a_test.rb` and `a_test.rb` match. No file content
  # is read.
  #
  # @param path [String] positional argument as typed.
  # @param project_root [String] repository root for relative expansion.
  # @param tests [Array<String>] the explicit test files.
  # @return [Boolean] true when the argument looks like a misplaced test.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:538
  def test_given_as_source?(path, project_root:, tests:); end

  # Exact and split tests for one logical base. A spec stays the only file.
  #
  # @param base [String] logical source path without extension.
  # @param lib [Boolean] whether the source originated from lib/.
  # @param root [String] expanded project root.
  # @param prefer [String] preferred framework name.
  # @return [Array<String>] existing test paths, exact candidate first.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:435
  def tests_at(base, lib, root, prefer); end

  class << self
    # Ordered candidate test paths: _test.rb, then Minitest's test_*.rb, then
    # _spec.rb. lib/ sources also get the test/lib/... and spec/lib/... layouts.
    #
    # @param base [String] logical source path without extension.
    # @param lib [Boolean] whether the source originated from lib/.
    # @param prefer [String] preferred framework name.
    # @return [Array<String>] candidate test paths in preferred order.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:500
    def candidates(base, lib, prefer); end

    # True when a longer concern pairs with this split name.
    # The file sits under `app/<dir>/concerns/`, a directory
    # {longer_source_exists?} does not search for a namespace base.
    # The longer concern claims the name only when its `concerns/` path has
    # no test, because only then does it look at the namespace path.
    # A model keeps a split file it already pairs with (#408).
    #
    # @param root [String] expanded project root.
    # @param ns_base [String] namespace base, such as `models/storage/totaled`.
    # @param entry [String] test file basename.
    # @return [Boolean]
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:688
    def claimed_by_longer_concern?(root, ns_base, entry); end

    # True when a longer source file on disk owns this split test. `user.rb`
    # does not take `user_session_test.rb` when `user_session.rb` exists in the
    # same directory, under `app/`, or under `lib/`. An intermediate file
    # counts: `bar_upsert.rb` owns `bar_upsert_guards_test.rb`, so `bar.rb`
    # does not.
    #
    # @param root [String] expanded project root.
    # @param base [String] logical source path without extension.
    # @param entry [String] test file basename.
    # @param scanned_dir [String, nil] relative test directory being scanned.
    #   When set, a longer source claims the file only if that source searches
    #   this directory. An `app/` source does not take a `test/lib/` file.
    # @return [Boolean]
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:670
    def claimed_by_longer_source?(root, base, entry, scanned_dir = T.unsafe(nil)); end

    # How one --test value is read. Blank is not a directory: File.expand_path
    # of "" is the project root, and that would select every test.
    #
    # @param value [String] one --test value, as typed.
    # @param project_root [String] repository root.
    # @return [Symbol] :blank, :directory, :file, :glob, or :plain.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:84
    def classify_test_value(value, project_root:); end

    # Test files under a directory. The name rule is {TEST_NAME}. Dot entries
    # stay out, because Dir.glob skips them. The result is sorted.
    # The directory name is literal, even when it contains a pattern character.
    #
    # @param abs [String] absolute directory path.
    # @param root [String] expanded project root.
    # @param roots [Array<String>] the project root, expanded and real.
    # @return [Array<String>] root-relative paths, or absolute paths outside the root.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:198
    def directory_test_files(abs, root, roots); end

    # An existing file's root-relative path, or nil outside the root. Tries the
    # path as given, then with its directory resolved, so a path typed through
    # a symlinked parent (or macOS `/var` under a `/private/var` root) matches.
    # The file's own name is kept, so a symlinked file is not renamed.
    #
    # @param abs [String] expanded absolute path of an existing file.
    # @param roots [Array<String>] the project root, expanded and real.
    # @return [String, nil] root-relative path, or nil outside the root.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:363
    def existing_relative(abs, roots); end

    # Expand each pattern for one map key. An empty expansion records the
    # pattern under `unmatched`. Results are deduped and sorted.
    #
    # @api private
    # @param patterns [Array<String>] source or test patterns from one entry.
    # @param number [Integer] 1-based entry index.
    # @param key [String] `"sources"` or `"tests"`.
    # @param unmatched [Array<Hash>] accumulator for patterns with no file.
    # @yieldparam pattern [String] one pattern to expand.
    # @yieldreturn [Array<String>] matching file paths.
    # @return [Array<String>] cleaned, deduped, sorted paths.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:262
    def expand_map_patterns(patterns, number, key, unmatched); end

    # One map source pattern: Dir.glob then {expand_sources}, so a matched
    # directory becomes its `.rb` files and path spellings clean the same way.
    # Matches outside the project root are dropped (brace patterns like
    # `{..,app}/x.rb` can escape a text-only `..` check).
    #
    # @api private
    # @param pattern [String] relative source pattern.
    # @param root [String] expanded project root.
    # @param roots [Array<String>] the project root, expanded and real.
    # @return [Array<String>] matching source paths, sorted.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:280
    def expand_map_source_pattern(pattern, root, roots); end

    # Glob matches for a map `tests:` pattern. A matched directory expands with
    # {directory_test_files}; a matched file is kept as-is (no name filter).
    # `--test` globs still drop directories; only the map expands them (#382).
    #
    # @api private
    # @param pattern [String] relative or absolute glob.
    # @param root [String] expanded project root.
    # @param roots [Array<String>] the project root, expanded and real.
    # @return [Array<String>] matching test paths (may include outside-root paths).
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:337
    def expand_map_test_glob(pattern, root, roots); end

    # One map test pattern. Directories (typed or matched by a glob) expand
    # with the {TEST_NAME} filter, matching a typed `--test` directory. Files
    # a glob matches stay unfiltered (including `test_helper.rb`), matching
    # `--test` globs. A missing plain path is not a match. Matches outside the
    # project root are dropped (#382 review).
    #
    # @api private
    # @param pattern [String] relative test pattern.
    # @param root [String] expanded project root.
    # @param roots [Array<String>] the project root, expanded and real.
    # @return [Array<String>] matching test paths, sorted.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:310
    def expand_map_test_pattern(pattern, root, roots); end

    # Expand each positional source: a directory -> its sorted **/*.rb files
    # (relative to project_root); a file (or glob, or anything non-directory)
    # -> its path relative to project_root, so `./lib/x.rb` and an absolute
    # path pair like `lib/x.rb` (#104). A missing file, or one outside the
    # root, stays as typed. Flattened, deduped, order-stable.
    #
    # @param args [Array<String>] source paths or directories.
    # @param project_root [String] repository root for relative expansion.
    # @return [Array<String>] flattened, deduped source file list.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:47
    def expand_sources(args, project_root:); end

    # One --test value, as paths. [] means a directory or glob matched nothing.
    # A file stays as typed. A missing plain path stays as typed, so the CLI
    # can still say "no such file". Paths from a directory or glob are sorted.
    # Inside the project they are root-relative. Outside it they are absolute.
    #
    # @param value [String] one --test value, as typed.
    # @param project_root [String] repository root.
    # @return [Array<String>] matching paths, or [value] when it is not expanded.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:103
    def expand_test(value, project_root:); end

    # `Dir.children` with each name read as UTF-8, or binary when it is not (#346).
    #
    # @param dir [String] directory to list.
    # @return [Array<String>]
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:186
    def fs_children(dir); end

    # `Dir.glob` with each path read as UTF-8, or binary when it is not (#346).
    #
    # @param args [Array] arguments forwarded to {Dir.glob}.
    # @return [Array<String>]
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:178
    def fs_glob(*args, **kwargs); end

    # A glob match that is a file, as a stored path. Directories are dropped.
    #
    # @param match [String] path from Dir.glob.
    # @param root [String] expanded project root.
    # @param roots [Array<String>] the project root, expanded and real.
    # @return [String, nil] stored path, or nil when the match is not a file.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:244
    def glob_file(match, root, roots); end

    # A path used as a literal prefix in Dir.glob.
    #
    # @param path [String] directory path, relative or absolute.
    # @return [String] the same path with pattern characters escaped.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:170
    def glob_literal(path); end

    # Files a glob matches from the project root. Directories are ignored.
    # There is no test-name filter. An absolute pattern ignores base.
    # Dir.glob keeps a leading "./"; the path is then made root-relative.
    #
    # @param pattern [String] glob as typed.
    # @param root [String] expanded project root.
    # @param roots [Array<String>] the project root, expanded and real.
    # @return [Array<String>] sorted matching file paths.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:215
    def glob_test_files(pattern, root, roots); end

    # The first test path {#infer_tests} would run for a source, or nil.
    # `prefer` is the resolved framework ("minitest" | "rspec"): its candidates
    # are tried first, the other framework's as fallback, so a minitest default
    # still finds a spec and vice-versa.
    #
    # @param source_rel [String] relative source path.
    # @param project_root [String] repository root for existence checks.
    # @param prefer [String] preferred framework name.
    # @return [String, nil] existing test path or nil.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:398
    def infer_test(source_rel, project_root:, prefer: T.unsafe(nil)); end

    # Every test file convention pairs with a source. The first existing exact
    # candidate from {#candidates} stays first. Each `<basename>_*_test.rb` in
    # the mirrored test directory is added after it (#87). A spec that the exact
    # rules already found is left alone: split Minitest names do not join it
    # and do not replace it. When that list is empty, a concern tries the same
    # exact and split names at its namespace path (#408). The `concerns/` path
    # still wins when it has any test. A longer source, including a longer
    # concern, keeps a split file. A model keeps a split file it already pairs
    # with: this fallback does not take one away.
    #
    # @param source_rel [String] relative source path.
    # @param project_root [String] repository root for existence checks.
    # @param prefer [String] preferred framework name.
    # @return [Array<String>] existing test paths, exact candidate first.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:416
    def infer_tests(source_rel, project_root:, prefer: T.unsafe(nil)); end

    # True when `dir_abs` is the project root or a directory inside it.
    # A source path such as `../../evil.rb` must not list tests outside the project.
    #
    # @param dir_abs [String] expanded directory.
    # @param root_abs [String] expanded project root.
    # @return [Boolean]
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:629
    def inside_project?(dir_abs, root_abs); end

    # Strip the source root to a logical path (no ".rb") and flag lib/
    # sources. app/foo/bar.rb and lib/foo/bar.rb both -> "foo/bar"; anything
    # else -> the path minus ".rb" (still attempted). Namespaced subdirs are
    # preserved verbatim — structural, never constant resolution.
    #
    # @param source_rel [String] relative source path.
    # @return [Array(String, Boolean)] logical base path and whether it came from lib/.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:482
    def logical_path(source_rel); end

    # Longer basenames that own `entry`, one per prefix of its pieces.
    # `user_session__test.rb` yields nothing for `user_session`.
    #
    # @param name [String] shorter source basename without extension.
    # @param entry [String] test file basename.
    # @return [Array<String>] owner basenames without extension.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:726
    def longer_owner_stems(name, entry); end

    # True when `entry` is the exact test, or a split test with a non-empty
    # piece, for `stem`. `user_session__test.rb` is neither for
    # `user_session`, so that source does not take it from `user.rb`.
    #
    # @param entry [String] test file basename.
    # @param stem [String] longer source basename without extension.
    # @return [Boolean]
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:752
    def longer_owns_entry?(entry, stem); end

    # True when a longer source file exists beside this logical path.
    # The logical directory itself is checked, so `src/user_session.rb` owns
    # `test/src/user_session_test.rb`. `app/` and `lib/` are checked too, so an
    # `app/` source still yields the name to a `lib/` sibling and the reverse.
    #
    # @param root [String] expanded project root.
    # @param dir [String] logical directory, or `.` when the source has none.
    # @param stem [String] longer source basename without extension.
    # @param scanned_dir [String, nil] relative test directory being scanned.
    # @return [Boolean]
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:766
    def longer_source_exists?(root, dir, stem, scanned_dir = T.unsafe(nil)); end

    # Mapped test files for one source from a resolved map. Each entry whose
    # expanded sources include `source` contributes its tests, in entry order.
    # An unmatched source returns `[]`. Does not dedupe across entries; the
    # CLI unions the run's test list (#382).
    #
    # @param source [String] root-relative source path, as in the resolved map.
    # @param resolved [Hash{Symbol => Array}] result of {resolve_test_map}.
    # @return [Array<String>] mapped test paths in entry order.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:156
    def mapped_tests_for(source, resolved); end

    # Relative test directory for a logical source path. A source with no
    # subdirectory (`calc`) maps to `prefix` itself, not `prefix/.`.
    #
    # @param prefix [String] `test` or `test/lib`.
    # @param base [String] logical source path without extension.
    # @return [String] relative directory.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:594
    def mirror_dir(prefix, base); end

    # A directory match whose basename is a test name, as a stored path.
    #
    # @param match [String] path from Dir.glob.
    # @param root [String] expanded project root.
    # @param roots [Array<String>] the project root, expanded and real.
    # @return [String, nil] stored path, or nil when the match is not a test file.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:230
    def named_test_file(match, root, roots); end

    # Namespace mirror for a concern, or nil.
    # `app/<dir>/concerns/<rest>.rb` returns `<dir>/<rest>`.
    # `concerns` must sit directly under `app/<dir>`.
    #
    # @param source_rel [String] relative source path.
    # @return [String, nil] logical base without extension, or nil.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:468
    def namespace_base(source_rel); end

    # `app/<dir>/concerns/<rest-dir>` for a namespace base `<dir>/<rest>`.
    #
    # @param ns_base [String] namespace base from {namespace_base}.
    # @return [String, nil] relative concerns directory, or nil when the base
    #   has no rest path.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:708
    def namespace_concerns_dir(ns_base); end

    # Namespace exact and split tests for a concern whose `concerns/` path
    # has none. A split is left out only when a longer concern has no test
    # of its own and therefore pairs with that split. A longer model is
    # already left out by {split_test_files}. A spec stays the only file.
    #
    # @param ns [String] namespace base from {namespace_base}.
    # @param root [String] expanded project root.
    # @param prefer [String] preferred framework name.
    # @return [Array<String>] existing test paths, exact candidate first.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:451
    def namespace_tests(ns, root, prefer); end

    # Expand every entry of a checked `test_map` into cleaned file lists.
    # Source patterns use Dir.glob then {expand_sources}, so a directory
    # match becomes its `.rb` files and `./lib/a.rb` / `lib//a.rb` clean to
    # the same path. Test patterns go through {expand_test}; a missing plain
    # path is dropped (no match). Overlapping patterns keep each file once,
    # sorted. Patterns with no file are listed under `:unmatched` with a
    # 1-based entry number and the key (`"sources"` or `"tests"`). Does not
    # print or exit; the CLI reports unmatched patterns (#382).
    #
    # @param test_map [Array<Hash{Symbol => Array<String>}>] checked map entries
    #   with `:sources` and `:tests` pattern lists.
    # @param project_root [String] repository root for relative expansion.
    # @return [Hash{Symbol => Array}] `:entries` is
    #   `[{sources: [...], tests: [...]}, ...]`; `:unmatched` is
    #   `[{entry: Integer, key: String, pattern: String}, ...]`.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:131
    def resolve_test_map(test_map, project_root:); end

    # `abs` relative to the first of `roots` it is under, or nil. Text only: a
    # symlinked source keeps its own name (realpath would rename it to its
    # target and pair the wrong test). `roots` holds the root's real path too,
    # so the macOS `/var` vs `/private/var` alias still matches.
    #
    # @param abs [String] expanded absolute path.
    # @param roots [Array<String>] the project root, expanded and real.
    # @return [String, nil] root-relative path, or nil outside the root.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:376
    def root_relative(abs, roots); end

    # True when pairing this source looks in `scanned_dir`.
    #
    # @param source_rel [String] project-relative source path.
    # @param scanned_dir [String] relative test directory.
    # @return [Boolean]
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:784
    def source_searches_dir?(source_rel, scanned_dir); end

    # True when `entry` is `<name>_<piece>_test.rb` and not the exact
    # `<name>_test.rb` file.
    #
    # @param entry [String] test file basename.
    # @param name [String] source basename without extension.
    # @return [Boolean]
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:644
    def split_entry?(entry, name); end

    # `<basename>_*_test.rb` files in each mirrored test directory (#87). The
    # exact `<basename>_test.rb` name is not included. `lib/` sources also look
    # under `test/lib/`. Names are matched as text, not as a glob, so a basename
    # that contains `*` stays literal. `test/` comes before `test/lib/`, and
    # each directory is sorted.
    #
    # @param base [String] logical source path without extension.
    # @param lib [Boolean] whether the source originated from lib/.
    # @param root [String] expanded project root.
    # @return [Array<String>] relative split-test paths.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:581
    def split_test_files(base, lib, root); end

    # Split test files directly inside `dir_rel` (not in subdirectories).
    #
    # @param root [String] expanded project root.
    # @param dir_rel [String] relative directory.
    # @param name [String] source basename without extension.
    # @param base [String] logical source path without extension.
    # @return [Array<String>] sorted relative paths.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:606
    def split_tests_in(root, dir_rel, name, base); end

    # Whether the `run` guard rejects a positional argument as a test file
    # given as a source (#293). Segments are read from the path relative to
    # the root, so a `test/` folder above the project never counts. A
    # `*_test.rb` / `*_spec.rb` path is flagged when it has a `test/` or
    # `spec/` segment (the guard's original rule), or when it sits in the same
    # directory as a given test, which catches root-level tests. A
    # `test_*.rb` path is flagged only under the
    # project's top-level `test/` or `spec/`, because real sources use the
    # prefix (`lib/mutineer/test_runners.rb`, `lib/foo/test/test_app.rb`). A
    # source whose own test (`<stem>_test.rb`, `test_<stem>.rb`,
    # `<stem>_spec.rb`, or a split `<stem>_*_test.rb` not claimed by a longer
    # source on disk) sits beside it in the test set is not flagged. Paths
    # compare relative to the root, as in
    # {expand_sources} (the root's real path counts too, for macOS `/var` vs
    # `/private/var`), so `./a_test.rb` and `a_test.rb` match. No file content
    # is read.
    #
    # @param path [String] positional argument as typed.
    # @param project_root [String] repository root for relative expansion.
    # @param tests [Array<String>] the explicit test files.
    # @return [Boolean] true when the argument looks like a misplaced test.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:538
    def test_given_as_source?(path, project_root:, tests:); end

    # Exact and split tests for one logical base. A spec stays the only file.
    #
    # @param base [String] logical source path without extension.
    # @param lib [Boolean] whether the source originated from lib/.
    # @param root [String] expanded project root.
    # @param prefer [String] preferred framework name.
    # @return [Array<String>] existing test paths, exact candidate first.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:435
    def tests_at(base, lib, root, prefer); end
  end
end

# Characters Dir.glob reads as a pattern. A real directory name may
# contain them. They are escaped so the name stays a literal prefix.
#
# pkg:gem/mutineer#lib/mutineer/pairing.rb:164
Mutineer::Pairing::GLOB_META = T.let(T.unsafe(nil), Regexp)

# Characters that make a --test value a glob when no path has that name.
# An existing file is never read as a glob, so a name may contain these.
#
# pkg:gem/mutineer#lib/mutineer/pairing.rb:76
Mutineer::Pairing::TEST_GLOB_MARK = T.let(T.unsafe(nil), Regexp)

# Basenames that pair as tests in {candidates}: `*_test.rb`, `*_spec.rb`
# and Minitest's `test_*.rb`, but not its `test_helper.rb` support file.
#
# pkg:gem/mutineer#lib/mutineer/pairing.rb:515
Mutineer::Pairing::TEST_NAME = T.let(T.unsafe(nil), Regexp)

# Raised only for I/O failures while reading a source file.
#
# Prism syntax errors are NOT raised — they are in-band via ParseResult#errors.
#
# pkg:gem/mutineer#lib/mutineer/parser.rb:10
class Mutineer::ParseError < ::StandardError; end

# Thin boundary around Prism.
#
# The parse methods return a Prism::ParseResult so all callers use
# result.value, result.source.source (raw bytes), and result.errors
# uniformly. No wrapping struct.
#
# pkg:gem/mutineer#lib/mutineer/parser.rb:17
class Mutineer::Parser
  class << self
    # The comments of source text, without building its syntax tree: a few
    # times cheaper than {.parse_string} for a caller that needs only these.
    #
    # @param source [String] source text.
    # @return [Array<Prism::Comment>] its comments, in source order.
    #
    # pkg:gem/mutineer#lib/mutineer/parser.rb:94
    def comments(source); end

    # True when Ruby cannot load `source`: the loaded Prism reports a parse
    # error and the running Ruby cannot compile the text either. Prism alone is
    # not enough. Prism 2 reports a bare-constant operator write inside a
    # method (`T += 1`) as a dynamic constant assignment, while the Prism 1
    # that Ruby 3.4 and 4.0 load files with accepts it (#392). Compiling does
    # not run the code.
    #
    # @param source [String] source text.
    # @return [Boolean]
    #
    # pkg:gem/mutineer#lib/mutineer/parser.rb:59
    def invalid?(source); end

    # Parses a file with Prism.
    #
    # @param path [String] source file path.
    # @return [Prism::ParseResult] Prism parse result.
    # @raise [Mutineer::ParseError] when file I/O fails.
    #
    # pkg:gem/mutineer#lib/mutineer/parser.rb:23
    def parse_file(path); end

    # Parses source text with Prism.
    #
    # @param source [String] source text.
    # @return [Prism::ParseResult] Prism parse result.
    #
    # pkg:gem/mutineer#lib/mutineer/parser.rb:46
    def parse_string(source); end

    # Reads a Ruby source file in the encoding its magic comment names, or
    # UTF-8 when it names none (#346). The bytes are not transcoded, so
    # Prism's offsets still address them and a mutant written back stays
    # valid for that encoding. An unknown encoding name stays UTF-8, as
    # Ruby does. I/O errors propagate (`Errno::ENOENT` and the rest).
    #
    # @param path [String] source file path.
    # @return [String] source text, tagged with its encoding.
    #
    # pkg:gem/mutineer#lib/mutineer/parser.rb:37
    def read(path); end

    private

    # Whether the running Ruby compiles `source`, without running it. Mutineer
    # forks, so it runs on CRuby, which has RubyVM. Warnings are off for the
    # compile: a mutant can trigger one (`if a = 1`).
    #
    # @param source [String] source text.
    # @return [Boolean]
    #
    # pkg:gem/mutineer#lib/mutineer/parser.rb:75
    def compiles?(source); end
  end
end

# Serializes {.compiles?}: it swaps the process-wide `$VERBOSE`, and
# `--daemon` checks mutants on several threads.
#
# pkg:gem/mutineer#lib/mutineer/parser.rb:67
Mutineer::Parser::COMPILE_LOCK = T.let(T.unsafe(nil), Thread::Mutex)

# Coarse run progress on stderr: one line per 10% step of completed mutants
# (which means every completion on a run smaller than ten). Shared by every
# backend so a long run is never silent between config resolution and the
# report. Thread-safe so the daemon's parallel workers can share one instance.
# Writes only to stderr, keeping `--format json` stdout and `--output` files
# byte-exact per the Reporter's stream contract.
#
# pkg:gem/mutineer#lib/mutineer/progress.rb:10
class Mutineer::Progress
  # Builds a progress counter for a run of `total` mutants.
  #
  # @param total [Integer] number of mutants that will run.
  # @param io [IO] destination stream (defaults to stderr; injectable for tests).
  #
  # pkg:gem/mutineer#lib/mutineer/progress.rb:15
  def initialize(total, io: T.unsafe(nil)); end

  # Records one completed mutant and prints when a 10% boundary is crossed.
  # A zero-total counter never prints (guards the division, and an empty run
  # has nothing to report).
  #
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/progress.rb:28
  def tick; end
end

# Subject discovery: parse each path and walk its AST for method definitions,
# tracking the enclosing class/module namespace.
#
# pkg:gem/mutineer#lib/mutineer/project.rb:11
class Mutineer::Project
  class << self
    # Discovers subjects from source paths.
    #
    # @param paths [Array<String>] source file paths.
    # @param only [String, nil] optional qualified-name filter.
    # @return [Array<Mutineer::Subject>] discovered subjects.
    #
    # pkg:gem/mutineer#lib/mutineer/project.rb:17
    def discover(paths, only: T.unsafe(nil)); end

    private

    # The source line and names Ruby assigns to explicit method creators. A
    # block-defined method starts at the block opening and a literal lambda at
    # its arrow. A positional callable takes precedence over a supplied block.
    # Other positional bodies and block passes have an indirect source: the
    # caller checks possible block/lambda lines instead of the call line.
    # An attribute method starts at the message token, not its receiver line.
    # Literal symbol and string names are exact. A dynamic name, splat, or attr
    # writer flag may name any method on that line, represented by nil.
    #
    # @param node [Prism::CallNode] call to inspect.
    # @return [Array, nil] source line and names (a nil line means an indirect
    #   callable body), or nil for a call outside this built-in family.
    #
    # pkg:gem/mutineer#lib/mutineer/project.rb:88
    def created_method_locations(node); end

    # Keeps hook defs unplaceable when the raw AST can define another method
    # with the same name and source line. Count all defs, including bodies that
    # SubjectVisitor does not select, and Ruby's explicit method creators (see
    # {.created_method_locations}). Indirect callable bodies may come from any
    # block or lambda in this file, including a stored hook block. An unknown
    # creator name blocks only those possible source lines. Instance and
    # singleton definitions can both reach singleton-class hosts, so their
    # shared name and line are ambiguous too. Run before `only` so selecting
    # one subject cannot hide a collision.
    #
    # @param subjects [Array<Mutineer::Subject>] subjects from one source file.
    # @param program [Prism::ProgramNode] the complete parsed file.
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/project.rb:42
    def exclude_ambiguous_hook_defs!(subjects, program); end

    # A literal method name, or nil when it depends on a runtime value.
    #
    # @param node [Prism::Node, nil] name argument.
    # @return [Symbol, nil]
    #
    # pkg:gem/mutineer#lib/mutineer/project.rb:122
    def literal_method_name(node); end

    # The call statements that run each time the file loads, in order: each one
    # sits in the file's top-level statements or in a `module` or `class` body
    # reached only through such statements. A call under any `if`, `unless`,
    # `case`, `&&`, `rescue` or loop, an assignment, an argument, a def or a block
    # is not on this path. A file with a `return` outside any def or block may
    # stop before a call, so it has none (#297).
    #
    # @param program [Prism::ProgramNode] the parsed file.
    # @return [Set<Prism::CallNode>] compared by identity.
    #
    # pkg:gem/mutineer#lib/mutineer/project.rb:136
    def plain_path_calls(program); end

    # True when the node holds a `return` that is not inside a def, a block or a
    # lambda, so loading the file can stop early.
    #
    # @param node [Prism::Node] node to search.
    # @return [Boolean]
    #
    # pkg:gem/mutineer#lib/mutineer/project.rb:157
    def top_level_return?(node); end
  end
end

# Walks an AST, maintaining a namespace stack, emitting Subjects.
# Nested inside Project to signal its private role.
#
# pkg:gem/mutineer#lib/mutineer/project.rb:167
class Mutineer::Project::SubjectVisitor < ::Prism::Visitor
  # Builds a subject visitor.
  #
  # @param file [String] source file path being visited.
  # @param plain_calls [Set<Prism::CallNode>] the file's call statements on a
  #   plain path (see {Project.plain_path_calls}); only these hook calls can be placed.
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:206
  def initialize(file, plain_calls = T.unsafe(nil)); end

  # Promote `module_function :name` / `module_function def name` subjects to
  # singleton after the full walk — the naming call may appear before or after
  # the def, so it can't be decided at visit_def_node time (#20). Only methods
  # of the module that made the call are promoted (#98), matched by {#module_key}.
  #
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:241
  def promote_module_functions!; end

  # pkg:gem/mutineer#lib/mutineer/project.rb:199
  def subjects; end

  # A block that does not build a class may run with any `self` (`class_eval`,
  # `instance_eval`, a callback), so a `class << self` in it names a singleton
  # class Mutineer cannot be sure of (#216). A lambda is treated the same.
  #
  # @param node [Prism::BlockNode, Prism::LambdaNode] block or lambda node.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:335
  def visit_block_node(node); end

  # Track `module_function` so its methods are recorded as singletons (#20) —
  # the called form is the singleton method on the module object. Bareword
  # `module_function` flips all SUBSEQUENT defs in this body; the argument
  # forms (`:sym`, `def`) name methods promoted after the walk. A builder
  # block's defs belong to the class it builds; one not assigned to a
  # constant has no name, so its subjects are marked `owner_unknown`, and a
  # `module_function :name` in it promotes nothing. Elsewhere it promotes the
  # methods of the same module, matched by {#module_key}. A module that runs
  # `extend ActiveSupport::Concern` is a concern from then on in this file. A
  # `class_methods` block in its body (see {#concern_block}) is visited like a
  # builder block that builds the module's `ClassMethods`, so its defs belong to
  # that module (#252). The defs in any other such block have their owner unknown.
  #
  # @param node [Prism::CallNode] call node.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:284
  def visit_call_node(node); end

  # Visits class nodes and tracks namespace nesting.
  #
  # @param node [Prism::ClassNode] class node.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:257
  def visit_class_node(node); end

  # pkg:gem/mutineer#lib/mutineer/project.rb:369
  def visit_constant_and_write_node(node); end

  # pkg:gem/mutineer#lib/mutineer/project.rb:368
  def visit_constant_or_write_node(node); end

  # pkg:gem/mutineer#lib/mutineer/project.rb:371
  def visit_constant_path_and_write_node(node); end

  # pkg:gem/mutineer#lib/mutineer/project.rb:370
  def visit_constant_path_or_write_node(node); end

  # pkg:gem/mutineer#lib/mutineer/project.rb:367
  def visit_constant_path_write_node(node); end

  # Names the class a builder block assigned to this constant builds (see {#builds_class?}).
  #
  # `=`, `||=` and `&&=` store the class, so each names it; `+=` stores what `+`
  # returns, so its builder is left unnamed.
  #
  # @param node [Prism::ConstantWriteNode, Prism::ConstantPathWriteNode, Prism::ConstantOrWriteNode,
  #   Prism::ConstantAndWriteNode, Prism::ConstantPathOrWriteNode, Prism::ConstantPathAndWriteNode]
  #   constant assignment.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:355
  def visit_constant_write_node(node); end

  # Records a discovered method definition.
  #
  # @param node [Prism::DefNode] method definition node.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:398
  def visit_def_node(node); end

  # pkg:gem/mutineer#lib/mutineer/project.rb:344
  def visit_lambda_node(node); end

  # Visits module nodes and tracks namespace nesting.
  #
  # @param node [Prism::ModuleNode] module node.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:265
  def visit_module_node(node); end

  # Methods inside `class << self` are class methods of the enclosing
  # namespace, but their def nodes have no receiver — track the singleton
  # context so they're recorded as singleton (so redefine targets the
  # singleton_class, not instances). `class << some_other_obj` can't be
  # represented against the namespace, so its defs are skipped (not recursed).
  #
  # @param node [Prism::SingletonClassNode] singleton-class node.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:381
  def visit_singleton_class_node(node); end

  private

  # Resolves the constant an assignment writes the way Ruby does. `X` is in the
  # current namespace, `::X` and a path at the top level start from Object, and
  # `self::X` is under the current class (the built class inside a builder
  # block). In a block that does not build a class, `self` may be any object,
  # so `self::X` there has its owner unknown (#229). Any other path is
  # looked up at run time, so its owner is unknown
  # and the subject is named as written. Lexically inside `class << self`,
  # even within a builder block there, the constant belongs to the singleton
  # class, which has no constant path, so its owner is unknown too, as is
  # `X` or `self::X` in a class or module opened there (#208). A `::X` there
  # is named `X`, still unknown (see {#with_namespace}).
  #
  # @param node [Prism::Node] constant assignment.
  # @return [Array(String, Array<String>, Boolean)] owner, namespace, unknown.
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:548
  def assigned_owner(node); end

  # The value an assignment stores: the last statement inside parentheses or a
  # `begin` without `rescue`, which Ruby returns from them.
  #
  # @param node [Prism::Node] assigned expression.
  # @return [Prism::Node, nil]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:615
  def assigned_value(node); end

  # True when the node is `Data.define`, `Struct.new`, `Class.new` or `Module.new` with a block.
  #
  # @param node [Prism::Node, nil] node.
  # @return [Boolean]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:632
  def builds_class?(node); end

  # Sorts an ActiveSupport::Concern block by where redefine can load its defs.
  # ActiveSupport evaluates a `class_methods` block in the module's `ClassMethods`,
  # which it extends onto every includer, so the test calls `Includer.name` on
  # that module's method, not on the concern (#252). In a class or module body,
  # or a builder block, with a known owner, that module is `<namespace>::ClassMethods`.
  # The block keeps the lexical scope, so redefine reopens the concern's chain and
  # loads the mutant with `::Concern::ClassMethods.class_eval`. In a def, a block
  # that does not build a class (Rails' `concerning :Name do`), `class << self`, or
  # under an owner no constant names (an unassigned `Module.new`), no constant here
  # names that `ClassMethods`. ActiveSupport evaluates an `included` or `prepended`
  # block in each includer, which no constant names either. The call has no
  # receiver or `self`, no arguments, and a block.
  #
  # Another library can define methods with these names and run the block in
  # the module itself. So a `class_methods` block counts only in a module that ran
  # `extend ActiveSupport::Concern` earlier in this file, in this body or an earlier
  # one ({#module_key}). Any other block with these names is unplaceable: guessing
  # its owner would load a mutant where the tests never call it.
  #
  # @param node [Prism::CallNode] call node.
  # @return [Symbol, nil] `:class_methods` when redefine can name the module,
  #   `:owner_unknown` for any other Concern block, or nil for any other call.
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:659
  def concern_block(node); end

  # Extracts a constant name from a Prism constant node.
  #
  # @api private
  # @param node [Prism::Node] constant node.
  # @return [String, nil] constant name.
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:784
  def extract_constant_name(node); end

  # True for an `included` or `prepended` block of a module that ran `extend
  # ActiveSupport::Concern` earlier in this file (see {#concern_block}).
  # ActiveSupport runs the block only when a class first includes or prepends
  # the concern, so loading the file again stores the new block but never
  # runs it in a class that already has the concern (#256). Reload can still
  # place a def that sits directly in such a block (see {#placeable_hook} and
  # {#reload_hook_call_for}, #297); anything else the block defines, a nested
  # class or a builder block included, stays as the original wrote it.
  #
  # @param node [Prism::CallNode] a call {#concern_block} sorted as a concern block.
  # @return [Boolean]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:678
  def hook_block?(node); end

  # The module a `module_function` call and a def are matched by: its joined
  # namespace, so a module reopened later in the file matches (#216), and
  # `module A::B` matches nested `module A; module B`. An unknown owner that an
  # anonymous builder block owns, or whose name has no {WrittenName} segment
  # and is not built only from constant names (see {#named_segment?}), may be
  # shared by another module, so it is matched only within this body (#208).
  # Otherwise a name with a {WrittenName}
  # segment is matched by that segment's scope and text, so openings under one
  # `self` match each other, but not those under another, whether the owner is
  # known or not (#229).
  #
  # @return [String, Object]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:438
  def module_key; end

  # The owner for a resolved namespace, root-anchored so the redefine
  # wrapper loads onto that constant from any nesting.
  #
  # @param namespace [Array<String>] resolved namespace.
  # @return [Array(String, Array<String>, Boolean)]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:606
  def named_owner(namespace); end

  # True when a namespace segment is a constant name, or a singleton class
  # (`#<Class:App::M>`) of constant names. A written path or `#<anonymous>` is
  # not, nor is a singleton class name built on one ({WrittenName}).
  #
  # @param segment [String] namespace segment.
  # @return [Boolean]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:461
  def named_segment?(segment); end

  # The hook call and the names its block calls outside its def bodies, when
  # reload can place the block's defs (#297), else nil and an empty set. The
  # call must be on a plain path ({Project.plain_path_calls}), so the statement
  # the mutant file adds before it runs exactly when the call runs. An alias in
  # the block keeps the original body, so a block with any `alias` or
  # `alias_method` places nothing. The names come from bare calls, `self.`
  # calls and the name given to `method`, `instance_method`, `send`,
  # `public_send` or `__send__`, in every nested block and lambda too:
  # discovery cannot tell a block that runs at once from one that runs
  # later. A name such a call computes at runtime places nothing.
  #
  # @param node [Prism::CallNode] the hook call.
  # @return [Array(Prism::CallNode, Set<Symbol>), Array(nil, Set<Symbol>)]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:695
  def placeable_hook(node); end

  # Runs the block and then restores every {SCOPE_STATE} variable, so a
  # nested body's state never leaks out of it.
  #
  # @yield the nested visit.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:527
  def preserving_scope; end

  # The hook call of the block this def sits in directly, when reload can
  # place the def (#297), else nil. The def must be in the block itself, or
  # in its `class << self` without a receiver: not in a def, a nested class
  # or module, or another block. `module_function` gives the def a second,
  # private copy, and a name the block itself uses kept the original's
  # result, so neither is placeable. An explicit receiver other than `self`
  # can be bound only inside the hook, which the extracted def does not keep.
  #
  # @param node [Prism::DefNode] the def being recorded.
  # @return [Prism::CallNode, nil]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:730
  def reload_hook_call_for(node); end

  # True when a constant path starts with `::` (e.g. `::X` or `::A::B`).
  #
  # @param node [Prism::Node] constant path node.
  # @return [Boolean]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:774
  def root_anchored?(node); end

  # True when a constant path starts with `self` (e.g. `self::X`).
  #
  # @param node [Prism::Node] constant path node.
  # @return [Boolean]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:765
  def self_rooted?(node); end

  # Names the singleton class that owns the constants written here: `class << self`
  # opens that of the current class (the built class inside a builder block),
  # and a builder block inside `class << self` keeps the enclosing one. A block
  # not assigned to a constant builds a class with no name, written `#<anonymous>`.
  # Each nested `class << self` opens the singleton class of the one around it.
  # A name built on a written path or `#<anonymous>`, or opened where `self` may
  # be another object (in a def or a non-builder block), is a {WrittenName} (see {#module_key}).
  #
  # @return [String] e.g. `#<Class:App>`, or `#<Class:#<Class:App>>` two deep.
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:592
  def singleton_name; end

  # Runs the block with the defs it visits owned by the class a builder block builds.
  # The block body defines instance methods of that class, even inside `class << self`,
  # but its constants still land where the enclosing `class << self` puts them.
  #
  # @param owner [Array(String, Array<String>, Boolean)] the owner as written, its namespace,
  #   and whether that name is unknown.
  # @param anonymous [Boolean] true when the block is not assigned to a constant.
  # @yield the builder call visit.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:748
  def with_block_owner(owner, anonymous); end

  # Runs the block with `path` pushed as the current namespace. A
  # root-anchored path (`module ::X` / `class ::X`) names the top-level X,
  # not X nested in the enclosing scope, so the namespace restarts there.
  # Bareword `module_function` state does not cross a class or module
  # boundary: each body starts without it, and the outer state returns after.
  # A class or module `X` opened inside `class << self`, even within a builder
  # block there, is a constant of the singleton class, which has no constant
  # path. It and everything nested in it is named under `#<Class:...>` with
  # its owner unknown (#208), and its body defines instance methods again.
  # A compact `Foo::X` or a top-level `::X` there is named as written, and
  # its owner is unknown too: redefine reopens the lexical chain without the
  # singleton class, so constants the body looks up through it would not resolve.
  # A `self::X` in any block is under the block's `self`, not the namespace
  # around the block (#229). In a builder block that is the built class, so
  # it is named under the builder's constant; in any other block (`class_eval`,
  # a callback) `self` may be any object, so it is named under the innermost
  # enclosing builder's constant, or else the enclosing namespace. Either way
  # the last segment is a {WrittenName}, and it and everything nested in it
  # has its owner unknown. Redefine reopens the lexical chain (`module Outer;
  # module X`), which never reaches the block's `self`; reopening X through
  # its constant with `class_eval`, as for `self::X = ...` in a builder block,
  # would drop X from `Module.nesting`, so constants its body looks up would not resolve.
  #
  # @param path [Prism::Node] the class/module constant path.
  # @yield the class or module body visit.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:492
  def with_namespace(path); end

  # True when any segment of the namespace is a {WrittenName}.
  #
  # @param namespace [Array<String>] namespace segments.
  # @return [Boolean]
