    # pkg:gem/mutineer#lib/mutineer/cli.rb:1409
    def unmutated_summary(unmutated, subjects, since:); end

    # Flag validation: every flag/usage failure exits 2, consistent with the
    # taxonomy above. CI can tell "mistyped flag" from "tests too weak."
    #
    # @api private
    # @param config [Mutineer::Config] run configuration.
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/cli.rb:508
    def validate!(config); end

    # --daemon selects the persistent-daemon backend (boot once, fork per mutant,
    # per-worker DB isolation on SQLite, Postgres, and MySQL). Usage errors exit 2:
    # cannot combine with --test-command; requires --rails or --boot; minitest only;
    # reload strategy only (redefine needs a shared VM surgical path the daemon
    # does not ship).
    #
    # @api private
    # @param config [Mutineer::Config] run configuration.
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/cli.rb:605
    def validate_daemon!(config); end

    # --matrix runs on the in-process backend and needs every mutant's whole
    # covering run, so a backend that cannot name the failing test, or a run that
    # stops early, is a usage error (exit 2), never a quietly partial matrix.
    #
    # @api private
    # @param config [Mutineer::Config] run configuration.
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/cli.rb:696
    def validate_matrix!(config); end

    # Validate path existence up front so a typo is a clean usage error (exit 2),
    # not an Errno::ENOENT backtrace from deep in the run. Flag checks run first
    # so a bad flag still reports the flag, not the missing file.
    #
    # @api private
    # @param config [Mutineer::Config] run configuration.
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/cli.rb:753
    def validate_paths!(config); end

    # --since needs a real git repo and a resolvable ref; either failure is a
    # usage error (exit 2) so CI sees "bad invocation," not "tests too weak."
    #
    # @api private
    # @param config [Mutineer::Config] run configuration.
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/cli.rb:728
    def validate_since!(config); end

    # --test-command runs the target suite in the app's own runtime. Validate its
    # shape up front (usage errors → exit 2) and force serial execution: each
    # subprocess boots the app and opens its own fixture transaction against the
    # same DB, so --jobs > 1 would corrupt results (fixture-contention hazard).
    # Unlike --rails, this path has NO per-worker DB isolation to opt into, so an
    # explicit --jobs N is forced to 1 rather than honored.
    #
    # @api private
    # @param config [Mutineer::Config] run configuration.
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/cli.rb:560
    def validate_test_command!(config); end

    # The --test-command text must not be blank and must contain %{files}.
    # It prints nothing when the text is valid, so a second call is safe.
    #
    # @api private
    # @param config [Mutineer::Config] run configuration.
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/cli.rb:585
    def validate_test_command_shape!(config); end

    # Warns once when the loaded .mutineer.yml sits outside the run directory
    # (#126). Mutant ids hash each file's path relative to the run directory,
    # but the config is found by walking up, so a run from a subdirectory loads
    # the same ignore list while its ids no longer match. A config in the home
    # directory is a personal default, not a project root, so it never warns.
    #
    # @param file_path [String] the .mutineer.yml that was loaded.
    # @param project_root [String] the run directory ids are relative to.
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/cli.rb:1179
    def warn_config_root_mismatch(file_path, project_root); end

    # Says why a run has no mutants, on stderr for every format. A --since run
    # whose sources had mutants before scoping is a stated success: the changes
    # held no mutable Ruby code. Any other empty run is a likely mistake (wrong
    # path, operators that never match), which 2.0 fails unless --allow-empty
    # says it is expected.
    #
    # @param config [Mutineer::Config] run configuration.
    # @param extras [Hash] the run extras; `:unscoped_mutants` counts the mutants (run and
    #   suppressed) before --since, `:declined` the candidates each operator did not mutate,
    #   and `:subjects` the methods found (#386).
    # @param unpaired [Hash{String => Integer, nil}] file => mutant count for sources
    #   pairing skipped. nil means the count failed.
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/cli.rb:1103
    def warn_empty_run(config, extras, unpaired = T.unsafe(nil)); end

    # Warns once that the --baseline file stores old-format ids (#126), so the
    # diff fell back to matching on them. Called only when a survivor matched
    # through an old id alone.
    #
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/cli.rb:1283
    def warn_legacy_baseline; end

    # Warns once per old-format `ignore:` entry (#126), naming each new id it
    # matched with that mutant's file and subject. mutineer cannot tell a full
    # run from a narrowed one, so the text always says the list covers only this
    # run's mutants. An entry that matched more than one distinct mutant (in
    # other files, or same-named methods in one file) over-matched: the old id
    # could not tell them apart, so replacing it with every new id would keep
    # suppressing the mutants it hid by accident.
    #
    # @param matches [Hash{String => Array<Hash{Symbol => String}>}] old-format
    #   entry => one `{id:, file:, subject:}` hash per matched mutant.
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/cli.rb:1261
    def warn_legacy_ignore_matches(matches); end

    # Warns once per `ignore:` entry that matched no mutant (#377). The text
    # says the list covers only this run, so a run of some files does not
    # claim an entry is stale in the rest of the project. The exit code does
    # not change. `--only` passes an empty list ({unmatched_ignore_ids}).
    #
    # @param ids [Array<String>] unmatched ids, in file order.
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/cli.rb:1243
    def warn_unmatched_ignores(ids); end

    # Prints one stderr line per source whose mutant count failed.
    # The report still lists that source with no count. The run continues.
    #
    # @api private
    # @param failures [Array<Hash>] `{file:, error:}` rows from {JobPlan.unpaired_counts}.
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/cli.rb:1391
    def warn_unpaired_count_failures(failures); end

    # Warns when `--coverage-from` is set on a run that captures no coverage.
    #
    # @api private
    # @param config [Mutineer::Config] run configuration.
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/cli.rb:641
    def warn_unused_coverage_from(config); end

    # `--dry-run` prints a candidate list; `--format html` never renders one,
    # and `--output` only writes when `--format json` builds that list (#362).
    #
    # @api private
    # @param config [Mutineer::Config] run configuration.
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/cli.rb:656
    def warn_unused_dry_run_settings(config); end

    # A backend that never reads a setting the user set would silently do
    # nothing with it, so say so. `--test-command` builds no coverage map and
    # has its own runtime, so it reads none of {UNUSED_SETTING_SCOPE}; the
    # daemon reads the capture limit and the cache directory but keeps its own
    # per-mutant limit.
    #
    # @api private
    # @param config [Mutineer::Config] run configuration.
    # @param backend [String] the backend's flag.
    # @param keys [Array<Symbol>] the settings that backend ignores.
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/cli.rb:680
    def warn_unused_settings(config, backend, keys); end
  end
end

# Command-line usage banner.
#
# pkg:gem/mutineer#lib/mutineer/cli.rb:41
Mutineer::CLI::BANNER = T.let(T.unsafe(nil), String)

# Settings `mutineer config` prints. The GitHub Action asks for these
# (#394), so it does not copy the CLI's precedence and flag rules.
#
# pkg:gem/mutineer#lib/mutineer/cli.rb:322
Mutineer::CLI::PRINTABLE_SETTINGS = T.let(T.unsafe(nil), Array)

# How to run a source that pairing skipped.
# The reporter keeps its own copy of the longer hint.
#
# pkg:gem/mutineer#lib/mutineer/cli.rb:38
Mutineer::CLI::UNPAIRED_RUN_HINT = T.let(T.unsafe(nil), String)

# Where each setting a backend may ignore applies, for the warning.
#
# pkg:gem/mutineer#lib/mutineer/cli.rb:629
Mutineer::CLI::UNUSED_SETTING_SCOPE = T.let(T.unsafe(nil), Hash)

# Config file name.
#
# pkg:gem/mutineer#lib/mutineer/config.rb:120
Mutineer::CONFIG_FILE = T.let(T.unsafe(nil), String)

# The option schema. Config.parse is the only place that turns a raw value
# (a CLI string or a YAML scalar) into a typed one, so a value is checked once,
# at the boundary, whichever layer wrote it. Row order fixes the order of
# KNOWN_KEYS in warnings.
#
# @api private
#
# pkg:gem/mutineer#lib/mutineer/config.rb:44
Mutineer::CONFIG_OPTIONS = T.let(T.unsafe(nil), Array)

# Maps each source file to the set of NEW-side line numbers changed since a
# git ref.
#
# By parsing `git diff --unified=0`, this restricts mutations to only the
# diff (issue #2): on a PR you care whether the changed code is tested, so
# mutating just those lines is fast and actionable.
#
# git is an external tool, not a gem dependency — shelling out is fine. The
# `parse` carries the logic; `git_diff` is injectable so it stays testable
# without invoking git.
#
# pkg:gem/mutineer#lib/mutineer/changed_lines.rb:18
module Mutineer::ChangedLines
  private

  # Builds a per-file map of changed new-side lines.
  #
  # @param ref [String] git ref to diff against.
  # @param files [Array<String>] source files to inspect.
  # @param project_root [String] repository root for `git -C`.
  # @param runner [#call] injectable diff producer.
  # @return [Hash<String, Set<Integer>>] absolute file path to changed lines.
  #
  # pkg:gem/mutineer#lib/mutineer/changed_lines.rb:52
  def for(ref:, files:, project_root:, runner: T.unsafe(nil)); end

  # Returns the stdout of `git -C <root> diff --unified=0 <ref> -- <file>`.
  # A file that is not in the index has no usable diff, so `new_file_diff`
  # supplies one that marks every line new. That includes a file the ref still
  # has, deleted and then written again: git prints only a deletion hunk for it.
  # A Git-ignored file outside the index contributes no changed lines, with a
  # warning, so the skip does not look like a file with no changes.
  # Paths are literal, so a name such as `file[1].rb` is not read as a glob.
  #
  # A failure is warned, never silent: an empty result means "no changed
  # lines", which under `--since` removes every mutant for the file — a green
  # gate must not be manufactured by a broken diff without a trace.
  #
  # @param ref [String] git ref to diff against.
  # @param abs_file [String] absolute path of the file being diffed.
  # @param project_root [String] repository root for `git -C`.
  # @return [String] diff text, or `""` on failure (after a stderr warning).
  #
  # pkg:gem/mutineer#lib/mutineer/changed_lines.rb:75
  def git_diff(ref, abs_file, project_root); end

  # Tells whether Git ignores the file (`.gitignore`, `.git/info/exclude` or
  # the global excludes file).
  #
  # @param abs_file [String] absolute path of the file.
  # @param project_root [String] repository root for `git -C`.
  # @return [Boolean] true when Git ignores the file. False when Git cannot
  #   tell, such as for a path beyond a symlink or inside a submodule (exit
  #   128): that file is scored in full, as a file Git does not ignore is.
  #
  # pkg:gem/mutineer#lib/mutineer/changed_lines.rb:116
  def ignored?(abs_file, project_root); end

  # Tells whether the index holds the file. Only then is git's own diff the
  # truth; the diff text cannot tell, because a mode-only diff must stay empty.
  #
  # @param abs_file [String] absolute path of the file being diffed.
  # @param project_root [String] repository root for `git -C`.
  # @return [Boolean] true when the index holds the file.
  #
  # pkg:gem/mutineer#lib/mutineer/changed_lines.rb:101
  def indexed?(abs_file, project_root); end

  # Returns a diff that marks a file as entirely new. It returns `""` when
  # the file is empty or cannot be read (after a warning). A file outside the
  # index has every line new; read as "unchanged", `--since` would score
  # nothing and a positive threshold would still exit 0.
  #
  # @param abs_file [String] absolute path of the file being diffed.
  # @return [String] a one-hunk diff header, or `""`.
  #
  # pkg:gem/mutineer#lib/mutineer/changed_lines.rb:130
  def new_file_diff(abs_file); end

  # Parses unified diff text into the set of NEW-side line numbers.
  #
  # With `--unified=0` each hunk's `+c,d` block is exactly the changed lines:
  # `c..c+d-1`. `d` absent means 1 line; `d == 0` is a pure deletion and
  # contributes nothing.
  #
  # @param diff_text [String] raw `git diff --unified=0` output.
  # @return [Set<Integer>] changed line numbers on the new side.
  #
  # pkg:gem/mutineer#lib/mutineer/changed_lines.rb:32
  def parse(diff_text); end

  class << self
    # Builds a per-file map of changed new-side lines.
    #
    # @param ref [String] git ref to diff against.
    # @param files [Array<String>] source files to inspect.
    # @param project_root [String] repository root for `git -C`.
    # @param runner [#call] injectable diff producer.
    # @return [Hash<String, Set<Integer>>] absolute file path to changed lines.
    #
    # pkg:gem/mutineer#lib/mutineer/changed_lines.rb:52
    def for(ref:, files:, project_root:, runner: T.unsafe(nil)); end

    # Returns the stdout of `git -C <root> diff --unified=0 <ref> -- <file>`.
    # A file that is not in the index has no usable diff, so `new_file_diff`
    # supplies one that marks every line new. That includes a file the ref still
    # has, deleted and then written again: git prints only a deletion hunk for it.
    # A Git-ignored file outside the index contributes no changed lines, with a
    # warning, so the skip does not look like a file with no changes.
    # Paths are literal, so a name such as `file[1].rb` is not read as a glob.
    #
    # A failure is warned, never silent: an empty result means "no changed
    # lines", which under `--since` removes every mutant for the file — a green
    # gate must not be manufactured by a broken diff without a trace.
    #
    # @param ref [String] git ref to diff against.
    # @param abs_file [String] absolute path of the file being diffed.
    # @param project_root [String] repository root for `git -C`.
    # @return [String] diff text, or `""` on failure (after a stderr warning).
    #
    # pkg:gem/mutineer#lib/mutineer/changed_lines.rb:75
    def git_diff(ref, abs_file, project_root); end

    # Tells whether Git ignores the file (`.gitignore`, `.git/info/exclude` or
    # the global excludes file).
    #
    # @param abs_file [String] absolute path of the file.
    # @param project_root [String] repository root for `git -C`.
    # @return [Boolean] true when Git ignores the file. False when Git cannot
    #   tell, such as for a path beyond a symlink or inside a submodule (exit
    #   128): that file is scored in full, as a file Git does not ignore is.
    #
    # pkg:gem/mutineer#lib/mutineer/changed_lines.rb:116
    def ignored?(abs_file, project_root); end

    # Tells whether the index holds the file. Only then is git's own diff the
    # truth; the diff text cannot tell, because a mode-only diff must stay empty.
    #
    # @param abs_file [String] absolute path of the file being diffed.
    # @param project_root [String] repository root for `git -C`.
    # @return [Boolean] true when the index holds the file.
    #
    # pkg:gem/mutineer#lib/mutineer/changed_lines.rb:101
    def indexed?(abs_file, project_root); end

    # Returns a diff that marks a file as entirely new. It returns `""` when
    # the file is empty or cannot be read (after a warning). A file outside the
    # index has every line new; read as "unchanged", `--since` would score
    # nothing and a positive threshold would still exit 0.
    #
    # @param abs_file [String] absolute path of the file being diffed.
    # @return [String] a one-hunk diff header, or `""`.
    #
    # pkg:gem/mutineer#lib/mutineer/changed_lines.rb:130
    def new_file_diff(abs_file); end

    # Parses unified diff text into the set of NEW-side line numbers.
    #
    # With `--unified=0` each hunk's `+c,d` block is exactly the changed lines:
    # `c..c+d-1`. `d` absent means 1 line; `d == 0` is a pure deletion and
    # contributes nothing.
    #
    # @param diff_text [String] raw `git diff --unified=0` output.
    # @return [Set<Integer>] changed line numbers on the new side.
    #
    # pkg:gem/mutineer#lib/mutineer/changed_lines.rb:32
    def parse(diff_text); end
  end
end

# Matches unified-diff hunks and captures the new-file start/count.
#
# pkg:gem/mutineer#lib/mutineer/changed_lines.rb:20
Mutineer::ChangedLines::HUNK = T.let(T.unsafe(nil), Regexp)

# Carries one line from a mutant's child to its parent: why the child
# raised. The parent puts it in the errored mutant's `details`, so the JSON
# report names the cause, not only stderr (#388, #417).
#
# The child writes the line to a pipe just before `exit!`; the parent reads
# it after the reap, without blocking, so a grandchild that still holds the
# write end cannot delay the result.
#
# The fork boundary {arm!}s the write end as process-local state so Minitest
# and RSpec can write a cause without a new runner argument (plan KTD3).
#
# Stdlib only: the app-side daemon loads this file without the rest of
# mutineer.
#
# pkg:gem/mutineer#lib/mutineer/child_cause.rb:19
module Mutineer::ChildCause
  private

  # Remembers the cause pipe for this process so suite code can write without
  # holding the IO. Only {#write_error} / {#write_text} from the same pid succeed.
  #
  # @param io [IO] the pipe's write end, with `sync` on.
  # @param owner [Integer] the pid of the mutant's child.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/child_cause.rb:39
  def arm!(io, owner); end

  # @api private
  # @return [Boolean]
  #
  # pkg:gem/mutineer#lib/mutineer/child_cause.rb:134
  def armed_here?; end

  # Clears {arm!}. Safe when nothing was armed.
  #
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/child_cause.rb:47
  def disarm!; end

  # The error as `Class: first non-blank message line`, or the class alone
  # when the message is blank or is the class name. Redacted before the cut,
  # so a cut cannot leave part of a password. Never raises.
  #
  # @param error [Exception]
  # @return [String]
  #
  # pkg:gem/mutineer#lib/mutineer/child_cause.rb:58
  def line(error); end

  # The last complete line in the pipe now, as UTF-8, or nil. Reads without
  # blocking.
  #
  # @param io [IO] the pipe's read end.
  # @return [String, nil]
  #
  # pkg:gem/mutineer#lib/mutineer/child_cause.rb:118
  def read(io); end

  # Write {line} for `error` to the pipe, but only from the mutant's child
  # itself. A grandchild made with a bare `fork` (no block) runs the child's
  # code after the fork, so its error can reach the same rescue; it writes
  # nothing, so `details` never names another process's error. Never
  # raises: a failed write only loses the cause, never the verdict.
  #
  # @param io [IO] the pipe's write end, with `sync` on (the child ends with `exit!`).
  # @param error [Exception]
  # @param owner [Integer] the pid of the mutant's child.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/child_cause.rb:82
  def write(io, error, owner); end

  # Write {line} for `error` to the armed pipe (#417).
  #
  # @param error [Exception]
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/child_cause.rb:92
  def write_error(error); end

  # Write a fixed or already-built cause text to the armed pipe (#417).
  # Redacted and cut like {line}.
  #
  # @param text [String]
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/child_cause.rb:103
  def write_text(text); end

  # @api private
  # @param io [IO]
  # @param text [String]
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/child_cause.rb:142
  def write_to(io, text); end

  class << self
    # Remembers the cause pipe for this process so suite code can write without
    # holding the IO. Only {#write_error} / {#write_text} from the same pid succeed.
    #
    # @param io [IO] the pipe's write end, with `sync` on.
    # @param owner [Integer] the pid of the mutant's child.
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/child_cause.rb:39
    def arm!(io, owner); end

    # @api private
    # @return [Boolean]
    #
    # pkg:gem/mutineer#lib/mutineer/child_cause.rb:134
    def armed_here?; end

    # Clears {arm!}. Safe when nothing was armed.
    #
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/child_cause.rb:47
    def disarm!; end

    # The error as `Class: first non-blank message line`, or the class alone
    # when the message is blank or is the class name. Redacted before the cut,
    # so a cut cannot leave part of a password. Never raises.
    #
    # @param error [Exception]
    # @return [String]
    #
    # pkg:gem/mutineer#lib/mutineer/child_cause.rb:58
    def line(error); end

    # The last complete line in the pipe now, as UTF-8, or nil. Reads without
    # blocking.
    #
    # @param io [IO] the pipe's read end.
    # @return [String, nil]
    #
    # pkg:gem/mutineer#lib/mutineer/child_cause.rb:118
    def read(io); end

    # Write {line} for `error` to the pipe, but only from the mutant's child
    # itself. A grandchild made with a bare `fork` (no block) runs the child's
    # code after the fork, so its error can reach the same rescue; it writes
    # nothing, so `details` never names another process's error. Never
    # raises: a failed write only loses the cause, never the verdict.
    #
    # @param io [IO] the pipe's write end, with `sync` on (the child ends with `exit!`).
    # @param error [Exception]
    # @param owner [Integer] the pid of the mutant's child.
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/child_cause.rb:82
    def write(io, error, owner); end

    # Write {line} for `error` to the armed pipe (#417).
    #
    # @param error [Exception]
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/child_cause.rb:92
    def write_error(error); end

    # Write a fixed or already-built cause text to the armed pipe (#417).
    # Redacted and cut like {line}.
    #
    # @param text [String]
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/child_cause.rb:103
    def write_text(text); end

    private

    # @api private
    # @param io [IO]
    # @param text [String]
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/child_cause.rb:142
    def write_to(io, text); end
  end
end

# The longest line sent, in characters, including the `...` of a cut line.
#
# pkg:gem/mutineer#lib/mutineer/child_cause.rb:21
Mutineer::ChildCause::LIMIT = T.let(T.unsafe(nil), Integer)

# Fixed text when `--matrix` ends early after a serial database error (KTD5).
#
# pkg:gem/mutineer#lib/mutineer/child_cause.rb:24
Mutineer::ChildCause::MATRIX_EARLY_END = T.let(T.unsafe(nil), String)

# Fixed text when RSpec reports an error outside examples (KTD5).
#
# pkg:gem/mutineer#lib/mutineer/child_cause.rb:28
Mutineer::ChildCause::RSPEC_OUTSIDE_EXAMPLES = T.let(T.unsafe(nil), String)

# Lets a test helper start Coverage in a forked mutant child (#248).
#
# Once the coverage map is built, the parent suspends Coverage so mutant
# children do not pay for it (#228). A suspended Coverage reports
# `running? == false`, so a test helper that starts it when it is off
# (SimpleCov's `SimpleCov.start`) calls `Coverage.start`, which raises
# "coverage measurement is already setup" while Coverage is suspended. Every
# mutant then errors before a test runs.
#
# In the child, `Coverage.start` and `Coverage.setup` first stop the
# suspended Coverage, then run as usual. Stopping builds and drops the whole
# result, which walks the heap, so only a child whose helper starts Coverage
# pays for it. Only files loaded after that start are measured. The parent's
# Coverage is untouched.
#
# Stdlib-only, so the app-side daemon can load it.
#
# pkg:gem/mutineer#lib/mutineer/child_coverage.rb:20
module Mutineer::ChildCoverage
  class << self
    # Makes a later `Coverage.start` or `Coverage.setup` work when Coverage is
    # suspended. A running or idle Coverage is left alone.
    #
    # Call it only in a forked child, before any test loads.
    #
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/child_coverage.rb:47
    def allow_start; end
  end
end

# Prepended to Coverage's singleton class in the child: stops a suspended
# Coverage before a start or setup.
#
# pkg:gem/mutineer#lib/mutineer/child_coverage.rb:23
module Mutineer::ChildCoverage::StopBeforeStart
  # Stops a suspended Coverage, then sets it up.
  #
  # @return [nil]
  #
  # pkg:gem/mutineer#lib/mutineer/child_coverage.rb:27
  def setup(*, **, &); end

  # Stops a suspended Coverage, then starts it.
  #
  # @return [nil]
  #
  # pkg:gem/mutineer#lib/mutineer/child_coverage.rb:35
  def start(*, **, &); end
end

# Silences stdout in a forked child that runs tests. Every fork boundary
# calls {.silence} once, right after `fork`, so the test runners themselves
# do not touch stdout. The parent reads each child's result from a separate
# pipe or from the exit status, never from stdout.
#
# Stderr stays open: it carries mutineer's own diagnostics from the child.
#
# Stdlib-only, so the app-side daemon can load it.
#
# pkg:gem/mutineer#lib/mutineer/child_stdout.rb:12
module Mutineer::ChildStdout
  class << self
    # Points fd 1 at File::NULL and makes `$stdout` the real STDOUT again.
    #
    # The reopen goes through STDOUT, not `$stdout`: the parent may have left
    # `$stdout` as a StringIO, which cannot reopen. A test that calls
    # `$stdout.reopen` (Minitest's `capture_subprocess_io`, RSpec's
    # `to_stdout_from_any_process`) then gets a real IO. Child processes of the
    # test inherit the silenced fd 1 too.
    #
    # The reopen takes an open IO, not a path. A path reopen checks the access
    # mode of STDOUT and raises ArgumentError when a parent left STDOUT on a
    # file in another mode (for example the "w+x" Tempfile of Minitest's
    # `capture_subprocess_io`).
    #
    # The null device is binary. A text-mode one still transcodes writes to
    # `Encoding.default_external` once `Encoding.default_internal` is set too.
    # Rails sets both to UTF-8 (`config.encoding`). The reporter's print of a
    # failure message that holds raw bytes (what `assert_response` does with a
    # short body) then raises `Encoding::UndefinedConversionError`, after the
    # test has already failed. The child's rescue scores that `error`, not
    # `killed` (#434). Nothing reads the silenced bytes.
    #
    # Call it only in a child that exits after the tests run. Nothing restores
    # the previous stdout.
    #
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/child_stdout.rb:38
    def silence; end
  end
end

# Lets the reload strategy load a concern file a second time (#256).
#
# ActiveSupport::Concern stores an `included` or `prepended` block once. A
# second block with another `source_location` raises
# `MultipleIncludedBlocks` (or `MultiplePrependBlocks`). Rails reloads keep
# the file's path, but a mutant loads from a temp file beside it, so every
# mutant of a concern with such a block would error. {.forget} removes the
# stored blocks that the source file defined, so the mutant's load stores
# its own. {.replace} wraps the load and puts back any block the load did not
# store again, such as one under an `unless defined?` guard.
#
# ActiveSupport does not run the block again in a class that already includes
# the concern, so that class keeps what the original block defined. For a def
# in the block, the mutant file also passes the mutated def to
# {.store_hook_def}, just before the `included` or `prepended` call. Under
# {.load_mutant} with a `hook_def`, {.store_hook_def} then calls
# {.place_hook_def} at once, which loads only that def into each class that
# has the method (#297). It runs before the rest of the file, so a later
# line of the file that calls the method while the file loads gets the
# mutant (#348). Nothing else in the block runs again. Discovery decides
# which defs can be placed this way (see {Subject#unplaceable?}).
#
# Call it only in a forked child that loads the mutant. Without
# ActiveSupport, {.replace} and {.forget} do nothing; {.store_hook_def} and
# {.place_hook_def} work without it.
#
# Stdlib-only, so the app-side daemon can load it.
#
# pkg:gem/mutineer#lib/mutineer/concern_blocks.rb:33
module Mutineer::ConcernBlocks
  class << self
    # Each other name any module has for the original def: an alias made
    # outside the block. Check independently of {.owners}: a wrapper can replace
    # the original name while its alias keeps the original body, so the mutant
    # could falsely survive even when no current-name owner remains.
    #
    # @param modules [Array<Module>] every module, including singleton classes.
    # @param source_file [String] the file the mutant replaces.
    # @param line [Integer] the original def's first line.
    # @param name [Symbol] the method name.
    # @param singleton [Boolean] true for a class method.
    # @return [Array<Array(Module, Symbol)>] each module and its alias name.
    #
    # pkg:gem/mutineer#lib/mutineer/concern_blocks.rb:224
    def aliases(modules, source_file:, line:, name:, singleton:); end

    # True for Rails' `DeprecatedConstantProxy`: a Module that forwards every
    # call to its target and prints a deprecation warning, so asking it for
    # methods would print one per mutant (#387). `Kernel#class` reads its real
    # class without forwarding.
    #
    # @param mod [Module] a module from the ObjectSpace walk.
    # @return [Boolean]
    #
    # pkg:gem/mutineer#lib/mutineer/concern_blocks.rb:313
    def deprecation_proxy?(mod); end

    # Removes every stored `included` and `prepended` block that the source
    # file defined, from every concern. Blocks from other files stay.
    #
    # @param source_file [String] the file the mutant replaces.
    # @return [Array<Array(Module, Symbol, Proc)>] each concern, where it stored
    #   the block, and the block removed.
    #
    # pkg:gem/mutineer#lib/mutineer/concern_blocks.rb:105
    def forget(source_file); end

    # Loads the mutant file at `path` over `source_file`, through {.replace}
    # inside {ReloadGuards.during_load}, so Rails macros in the class body can
    # run a second time (#378, #383, #384). The load assigns each of the file's
    # constants a second time, so Ruby would warn twice per constant, per
    # mutant (#364). Warnings are off for the load only, and back on before
    # the tests run.
    #
    # With a `hook_def`, the file's {.store_hook_def} call places the mutated
    # def during the load (#348). A load that never reached that call raises.
    # When a handle to the original is live at placement, the kept-handle
    # check runs again after the load, so a handle the file holds only while
    # it loads does not count. Placement leaves no other way to reach the
    # original, so no handle seen then means none after the load.
    #
    # @param source_file [String] the file the mutant replaces.
    # @param path [String] the mutant file to load.
    # @param hook_def [Hash{Symbol => Object}, nil] the original def's `line`,
    #   `name` and `singleton`, from {JobPlan.hook_mutant}.
    # @raise [RuntimeError] from {.place_hook_def}, so the child scores `error`.
    # @return [Object] what `load` returns.
    #
    # pkg:gem/mutineer#lib/mutineer/concern_blocks.rb:74
    def load_mutant(source_file, path, hook_def: T.unsafe(nil)); end

    # True when the heap contains a handle for this original definition. Return
    # only a boolean, so the first check does not itself retain a dead handle
    # across the GC in {.retained_hook_def?}.
    #
    # @param path [String] the source file's real path.
    # @param line [Integer] the original def's first line.
    # @param name [Symbol] the original method name.
    # @return [Boolean]
    #
    # pkg:gem/mutineer#lib/mutineer/concern_blocks.rb:297
    def method_handle_at?(path, line, name); end

    # True when the module's own method `name` starts at this file and line.
    # A prepended method can hide it from `instance_method`, so follow `super`
    # until the lookup reaches the method whose owner is the module itself.
    #
    # @param target [Module] the module or singleton class to read.
    # @param name [Symbol] the method name.
    # @param path [String] the source file's real path.
    # @param line [Integer] the def's first line.
    # @param original_name [Symbol] the name the original definition used;
    #   distinguishes an alias from another definition on the same line.
    # @return [Boolean]
    #
    # pkg:gem/mutineer#lib/mutineer/concern_blocks.rb:245
    def own_method_at?(target, name, path, line, original_name: T.unsafe(nil)); end

    # Each module whose own method `name` (its singleton class's, for a class
    # method) has the original def's file and line: every place the original
    # block defined it. A subclass that overrides the method, or a class that
    # only inherits it, is not one.
    #
    # @param modules [Array<Module>] every module, including singleton classes
    #   into which a concern can be included.
    # @param source_file [String] the file the mutant replaces.
    # @param line [Integer] the original def's first line.
    # @param name [Symbol] the method name.
    # @param singleton [Boolean] true for a class method.
    # @return [Array<Module>]
    #
    # pkg:gem/mutineer#lib/mutineer/concern_blocks.rb:208
    def owners(modules, source_file:, line:, name:, singleton:); end

    # Takes the def {.store_hook_def} kept, clears it, and runs it with
    # `class_eval` in each module whose own method came from the original def
    # (see {.owners}), so that module gets the mutated method and nothing else in
    # the block runs again. Each owner keeps the method's visibility. A class
    # that includes the concern later gets the mutant from the stored block.
    #
    # @param source_file [String] the file the mutant replaces.
    # @param line [Integer] the original def's first line.
    # @param name [Symbol] the method name.
    # @param singleton [Boolean] true for a class method.
    # @param check_retained [Boolean] false when the caller checks for a kept
    #   method handle itself, after the load ({.load_mutant}).
    # @raise [RuntimeError] when no def was kept (the mutant file did not reach
    #   its hook call), or when a module keeps the original under another name
    #   (see {.aliases}) or in a live method handle; the child then scores the
    #   mutant `error`.
    # @return [Integer] how many owners got the mutated def.
    #
    # pkg:gem/mutineer#lib/mutineer/concern_blocks.rb:163
    def place_hook_def(source_file:, line:, name:, singleton:, check_retained: T.unsafe(nil)); end

    # The file's real path, so a symlinked or relative path matches the path
    # Ruby recorded when it loaded the file.
    #
    # @param file [String] a file path.
    # @return [String]
    #
    # pkg:gem/mutineer#lib/mutineer/concern_blocks.rb:327
    def real_path(file); end

    # Raises when a live Method or UnboundMethod keeps the original definition
    # (see {.retained_hook_def?}), so the child scores the mutant `error`.
    #
    # @param source_file [String] the file the mutant replaces.
    # @param line [Integer] the original def's first line.
    # @param name [Symbol] the original method name.
    # @raise [RuntimeError] when such a handle is live.
    # @return [nil]
    #
    # pkg:gem/mutineer#lib/mutineer/concern_blocks.rb:264
    def refuse_retained_hook_def(source_file:, line:, name:); end

    # Forgets the source file's stored blocks, runs the block that loads the
    # mutant, then puts back each forgotten block the load did not store again.
    # A concern the mutant's load skips (an `unless defined?` guard) keeps its
    # original block, so a class that includes it during the tests still gets it.
    #
    # @param source_file [String] the file the mutant replaces.
    # @yield the mutant's load.
    # @return [Object] what the block returns.
    #
    # pkg:gem/mutineer#lib/mutineer/concern_blocks.rb:45
    def replace(source_file); end

    # True when a live Method or UnboundMethod keeps the original definition.
    # A wrapper can call that handle after the named method was replaced, so
    # loading another def cannot make the wrapper test the mutant. A matching
    # but unreachable reflection result is harmless: collect it, then check
    # again. Most mutants have no matching handle and need no explicit GC.
    #
    # @param source_file [String] the file the mutant replaces.
    # @param line [Integer] the original def's first line.
    # @param name [Symbol] the original method name.
    # @return [Boolean]
    #
    # pkg:gem/mutineer#lib/mutineer/concern_blocks.rb:281
    def retained_hook_def?(source_file:, line:, name:); end

    # Keeps the mutated hook-block def for {.place_hook_def}. The mutant file
    # calls it in the concern's body, just before the hook call, so the block has
    # the same constant scope as the hook block (#297). Under {.load_mutant}
    # with a `hook_def`, it places the def now, before the rest of the file
    # runs (#348).
    #
    # @yield the mutated def, run with `class_eval` in each owner.
    # @raise [RuntimeError] from {.place_hook_def}.
    # @return [nil]
    #
    # pkg:gem/mutineer#lib/mutineer/concern_blocks.rb:134
    def store_hook_def(&block); end
  end
end

# `Kernel#class`, unbound, so a proxy that redefines `class` cannot answer.
#
# pkg:gem/mutineer#lib/mutineer/concern_blocks.rb:320
Mutineer::ConcernBlocks::KERNEL_CLASS = T.let(T.unsafe(nil), UnboundMethod)

# Where ActiveSupport::Concern stores each block.
#
# pkg:gem/mutineer#lib/mutineer/concern_blocks.rb:35
Mutineer::ConcernBlocks::STORED_BLOCKS = T.let(T.unsafe(nil), Array)

# Raised when another process already holds exclusive ownership of a source
# file. Aborting beats silently restoring (or capturing) the other run's mutant.
#
# pkg:gem/mutineer#lib/mutineer/file_swap.rb:9
class Mutineer::ConcurrentRunError < ::StandardError
  # @param path [String] the source file the other run already owns.
  # @return [ConcurrentRunError]
  #
  # pkg:gem/mutineer#lib/mutineer/file_swap.rb:12
  def initialize(path); end
end

# Plain run configuration, populated by the CLI (or directly by the
# integration test). `operators` nil means "all default operators";
# `threshold` 0.0 means the CI gate is off (spec §10).
#
# Also holds: jobs (parallel workers), format (human|json), output (report
# file), strategy (reload|redefine), require_paths (extra files to load).
# Config loading and the CLI > file > default precedence merge live here; each
# layer holds only the keys the user wrote, and Config#explicit? reports them.
#
# `matrix` (--matrix) runs every covering test for each mutant and reports
# which tests kill it (see KillMatrix); it never changes a verdict.
#
# `shared_databases` (file only) names test database configs that parallel
# `--daemon` workers may share; see DaemonBackend.worker_count_for.
#
# `test_map` (file key `tests`, no flag) holds checked source→test pattern
# entries that pairing adds to a source's paired tests (#382). Distinct from
# `:tests`, the CLI `--test` file list.
#
# Boot mode adds: boot (a file to require ONCE in the parent so the app env,
# e.g. Rails, is booted before forking; sources are then NOT manually required)
# and rails (sugar: defaults boot to config/environment, prefers redefine without
# a daemon, and reconnects ActiveRecord per fork).
#
# `unpaired_sources` is code only. Pairing stores each source it skips
# because no conventional test exists. An explicit test list leaves it empty.
# There is no flag and no config-file key.
#
# pkg:gem/mutineer#lib/mutineer/config.rb:106
class Mutineer::Config < ::Struct
