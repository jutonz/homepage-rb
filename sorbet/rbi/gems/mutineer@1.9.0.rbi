    # pkg:gem/mutineer#lib/mutineer/minitest_integration/stop_at_first_failure.rb:117
    def disarm!; end

    # True after the outer reporter records a failure or an error.
    #
    # @return [Boolean, nil]
    #
    # pkg:gem/mutineer#lib/mutineer/minitest_integration/stop_at_first_failure.rb:93
    def stopped; end

    # True after the outer reporter records a failure or an error.
    #
    # @return [Boolean, nil]
    #
    # pkg:gem/mutineer#lib/mutineer/minitest_integration/stop_at_first_failure.rb:93
    def stopped=(_arg0); end

    # True when the armed run in this process has stopped.
    #
    # @return [Boolean]
    #
    # pkg:gem/mutineer#lib/mutineer/minitest_integration/stop_at_first_failure.rb:126
    def stopped_here?; end

    private

    # Picks the hook modules for the loaded Minitest.
    #
    # @return [Array(Module, Module), nil] the outer reporter hook and the
    #   skip hook, or nil for an unknown shape.
    #
    # pkg:gem/mutineer#lib/mutineer/minitest_integration/stop_at_first_failure.rb:136
    def hooks_for_loaded_minitest; end
  end
end

