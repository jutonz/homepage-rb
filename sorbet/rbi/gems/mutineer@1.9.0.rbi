  # pkg:gem/mutineer#lib/mutineer/subject.rb:27
  def enclosing_subject=(_); end

  # pkg:gem/mutineer#lib/mutineer/subject.rb:27
  def file; end

  # pkg:gem/mutineer#lib/mutineer/subject.rb:27
  def file=(_); end

  # pkg:gem/mutineer#lib/mutineer/subject.rb:27
