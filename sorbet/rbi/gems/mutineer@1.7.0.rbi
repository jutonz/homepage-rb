  # @param node [Prism::OrNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/boolean_connector.rb:27
  def visit_or_node(node); end

  private

  # Emits a connector mutation when the token is replaceable.
  #
  # @param node [Prism::Node] connector node.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/boolean_connector.rb:38
  def emit(node); end
end

