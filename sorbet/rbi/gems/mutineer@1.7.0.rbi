  # Visits nil literals.
  #
  # @param node [Prism::NilNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/boolean_literal.rb:33
  def visit_nil_node(node); end

  # Visits true literals.
  #
  # @param node [Prism::TrueNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/boolean_literal.rb:15
  def visit_true_node(node); end

