    def runnables; end

    # The loaded test classes of the armed run.
    #
    # @return [Array<Class>, nil]
    #
    # pkg:gem/mutineer#lib/mutineer/minitest_integration/kill_recorder.rb:110
    def runnables=(_arg0); end

