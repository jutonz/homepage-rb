  # pkg:gem/mutineer#lib/mutineer/mutation.rb:10
  def replacement; end

  # pkg:gem/mutineer#lib/mutineer/mutation.rb:10
  def start_offset; end

  # pkg:gem/mutineer#lib/mutineer/mutation.rb:23
