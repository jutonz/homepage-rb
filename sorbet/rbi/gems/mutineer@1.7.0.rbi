  def emit(loc, replacement); end
end

# Negation-removal mutator (Tier-2).
#
# Removes the `!` or `not` of a negation, one mutation per occurrence:
# `!x` becomes `x` and `not x` becomes ` x`. The mutant survives when no
# test depends on the negated value.
#
# pkg:gem/mutineer#lib/mutineer/mutators/negation_removal.rb:12
class Mutineer::Mutators::NegationRemoval < ::Mutineer::Mutators::Base
  # Visits call nodes and emits negation-removal mutations.
  #
  # @param node [Prism::CallNode] call node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/negation_removal.rb:17
  def visit_call_node(node); end

  private

  # Emits a mutation when the node is a prefix `!` or `not`.
  #
  # The explicit form `x.!` is skipped: without its message, `x.` does
  # not parse.
  #
  # @param node [Prism::CallNode] call node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/negation_removal.rb:31
  def emit(node); end
end

# Operand-removal mutator (Tier-2).
#
# Replaces a boolean expression with one of its operands, two mutations
# per `&&`, `||`, `and` or `or`: `a && b` becomes `(a)` and `(b)`. The
# parentheses keep the precedence of `and` and `or`. A surviving mutant
# shows that no test needs the operand that was removed.
#
# pkg:gem/mutineer#lib/mutineer/mutators/operand_removal.rb:13
class Mutineer::Mutators::OperandRemoval < ::Mutineer::Mutators::Base
  # Visits `and` nodes.
  #
  # @param node [Prism::AndNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/operand_removal.rb:22
  def visit_and_node(node); end

  # Visits `or` nodes.
  #
  # @param node [Prism::OrNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/operand_removal.rb:31
  def visit_or_node(node); end

  private

  # Emits one mutation that keeps the left operand, then one that keeps
  # the right operand. The order is fixed, because the two mutants share
  # a token and their occurrence ordinals tell them apart.
  #
  # @param node [Prism::AndNode, Prism::OrNode] connector node.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/operand_removal.rb:44
  def emit(node); end
end

# Node types for jumps. A jump in a value context does not parse, so
# the operator never keeps a jump alone.
#
# pkg:gem/mutineer#lib/mutineer/mutators/operand_removal.rb:16
Mutineer::Mutators::OperandRemoval::JUMPS = T.let(T.unsafe(nil), Array)

# Operator-assignment mutator (Tier-2).
#
# Swaps the operator of a compound assignment, one mutation per
# occurrence: `t += x` -> `t -= x`. Prism parses `t += x` as its own
# node, not as a CallNode, so the arithmetic mutator never sees it.
#
# The mapping is the same as for arithmetic. Other compound operators
# (`||=`, `&&=`, `|=`, `<<=` and the rest) are not changed.
#
# pkg:gem/mutineer#lib/mutineer/mutators/operator_assignment.rb:15
class Mutineer::Mutators::OperatorAssignment < ::Mutineer::Mutators::Base
  # Visits `a.b += x` and `a&.b += x`.
  #
  # @param node [Prism::CallOperatorWriteNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/operator_assignment.rb:79
  def visit_call_operator_write_node(node); end

  # Visits `@@t += x`.
  #
  # @param node [Prism::ClassVariableOperatorWriteNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/operator_assignment.rb:43
  def visit_class_variable_operator_write_node(node); end

  # Visits `T += x`.
  #
  # @param node [Prism::ConstantOperatorWriteNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/operator_assignment.rb:61
  def visit_constant_operator_write_node(node); end

  # Visits `A::T += x` and `::T += x`.
  #
  # @param node [Prism::ConstantPathOperatorWriteNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/operator_assignment.rb:70
  def visit_constant_path_operator_write_node(node); end

  # Visits `$t += x`.
  #
  # @param node [Prism::GlobalVariableOperatorWriteNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/operator_assignment.rb:52
  def visit_global_variable_operator_write_node(node); end

  # Visits `a[i] += x`.
  #
  # @param node [Prism::IndexOperatorWriteNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/operator_assignment.rb:88
  def visit_index_operator_write_node(node); end

  # Visits `@t += x`.
  #
  # @param node [Prism::InstanceVariableOperatorWriteNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/operator_assignment.rb:34
  def visit_instance_variable_operator_write_node(node); end

  # Visits `t += x`.
  #
  # @param node [Prism::LocalVariableOperatorWriteNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/operator_assignment.rb:25
  def visit_local_variable_operator_write_node(node); end

  private

  # Emits a mutation when the node's operator has a replacement.
  #
  # @param node [Prism::Node] a node with `binary_operator` and `binary_operator_loc`.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/operator_assignment.rb:99
  def emit(node); end
end

# Token replacements for compound arithmetic operators.
#
# pkg:gem/mutineer#lib/mutineer/mutators/operator_assignment.rb:17
Mutineer::Mutators::OperatorAssignment::REPLACEMENTS = T.let(T.unsafe(nil), Hash)

# Range mutator (Tier-2).
#
# Swaps `..` with `...` and `...` with `..`, one mutation per range. The
# `..` -> `...` mutant survives when no test checks the last element.
# Flip-flops are FlipFlopNode, not RangeNode, so this mutator skips them.
#
# Endless ranges (`1..`, `1..nil`) are skipped. `(1..)` and `(1...)` give
# the same result for slicing, `include?`, `===`, `size` and patterns, so
# the mutant is equivalent and no normal test can kill it.
#
# pkg:gem/mutineer#lib/mutineer/mutators/range_literal.rb:16
class Mutineer::Mutators::RangeLiteral < ::Mutineer::Mutators::Base
  # Visits range nodes and emits range mutations.
  #
  # @param node [Prism::RangeNode] range node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/range_literal.rb:24
  def visit_range_node(node); end

  private

  # Emits the mutation that swaps the range operator.
  #
  # @param node [Prism::RangeNode] range node to mutate.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/range_literal.rb:43
  def emit(node); end

  # Whether the range has no end: `1..` or `1..nil`.
  #
  # @param node [Prism::RangeNode] range node to inspect.
  # @return [Boolean]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/range_literal.rb:35
  def endless?(node); end
end

# Maps each range operator to its opposite.
#
# pkg:gem/mutineer#lib/mutineer/mutators/range_literal.rb:18
Mutineer::Mutators::RangeLiteral::SWAPS = T.let(T.unsafe(nil), Hash)

# Regular-expression literal mutator (Tier-2).
#
# Conservative, clearly-safe textual swaps inside a plain regex literal:
# drop a leading +^+ anchor, drop a trailing +$+ anchor, and swap the +
# and * quantifiers. Interpolated regexes use a different node type and are
# never visited. Escaped tokens (preceded by a backslash) are left alone.
#
# pkg:gem/mutineer#lib/mutineer/mutators/regex_literal.rb:13
class Mutineer::Mutators::RegexLiteral < ::Mutineer::Mutators::Base
  # Visits regular-expression literals.
  #
  # @param node [Prism::RegularExpressionNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/regex_literal.rb:18
  def visit_regular_expression_node(node); end

  private

  # Emits a regex mutation.
  #
  # @param start_offset [Integer] byte start.
  # @param end_offset [Integer] byte end.
  # @param replacement [String] replacement text.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/regex_literal.rb:62
  def emit(start_offset, end_offset, replacement); end

  # Scans the pattern bytes and emits anchor/quantifier mutations.
  #
  # @param content [String] regex pattern between the slashes.
  # @param base [Integer] byte offset of the pattern start in source.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/regex_literal.rb:32
  def scan(content, base); end

  # Whether the pattern ends with an unescaped +$+ anchor.
  #
  # @param content [String] regex pattern.
  # @return [Boolean] true when a trailing anchor is droppable.
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/regex_literal.rb:52
  def trailing_anchor?(content); end
end

# Return-nil mutator.
#
# Replaces explicit return values and final expressions with nil.
#
# pkg:gem/mutineer#lib/mutineer/mutators/return_nil.rb:10
class Mutineer::Mutators::ReturnNil < ::Mutineer::Mutators::Base
  # Collects return-nil mutations for a subject.
  #
  # @param subject [Mutineer::Subject] subject to inspect.
  # @param source [String] full source text.
  # @return [Array<Mutineer::Mutation>] collected mutations.
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/return_nil.rb:16
  def mutations_for(subject, source); end

  # Visits return nodes.
  #
  # @param node [Prism::ReturnNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/return_nil.rb:32
  def visit_return_node(node); end

  private

  # Emits a return-nil mutation.
  #
  # @param loc [Prism::Location] source location.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/return_nil.rb:62
  def emit(loc); end

  # Mutates a method's final expression to nil when eligible.
  #
  # @param body [Prism::Node] method body node.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/return_nil.rb:49
  def final_expression_nil(body); end
end

# Safe-navigation mutator (Tier-2).
#
# Replaces `&.` with `.`, one mutation per occurrence. The mutant raises
# NoMethodError on a nil receiver, so it survives when no test passes nil.
#
# pkg:gem/mutineer#lib/mutineer/mutators/safe_navigation.rb:11
class Mutineer::Mutators::SafeNavigation < ::Mutineer::Mutators::Base
  # Visits `a&.b &&= 1`.
  #
  # @param node [Prism::CallAndWriteNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/safe_navigation.rb:43
  def visit_call_and_write_node(node); end

  # Visits call nodes and emits safe-navigation mutations.
  #
  # @param node [Prism::CallNode] call node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/safe_navigation.rb:16
  def visit_call_node(node); end

  # Visits `a&.b += 1`, which Prism parses as its own node, not a CallNode.
  #
  # @param node [Prism::CallOperatorWriteNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/safe_navigation.rb:25
  def visit_call_operator_write_node(node); end

  # Visits `a&.b ||= 1`.
  #
  # @param node [Prism::CallOrWriteNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/safe_navigation.rb:34
  def visit_call_or_write_node(node); end

  # Visits a call used as an assignment target, as in `for a&.b in list`.
  #
  # @param node [Prism::CallTargetNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/safe_navigation.rb:52
  def visit_call_target_node(node); end

  private

  # Emits a mutation when the node's call operator is `&.`.
  #
  # @param node [Prism::Node] a node with `safe_navigation?` and `call_operator_loc`.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/safe_navigation.rb:63
  def emit(node); end
end

# Statement-removal mutator.
#
# Replaces each non-final method statement with `nil`.
#
# pkg:gem/mutineer#lib/mutineer/mutators/statement_removal.rb:10
class Mutineer::Mutators::StatementRemoval < ::Mutineer::Mutators::Base
  # Visits statement nodes and emits removals.
  #
  # @param node [Prism::StatementsNode] statement list to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/statement_removal.rb:15
  def visit_statements_node(node); end
end

# String literal mutator (Tier-2).
#
# Empties a non-empty string literal and fills an empty one. Only plain
# quoted strings are touched; interpolated strings, heredocs and %-literals
# are skipped for safety (they re-parse unpredictably).
#
# pkg:gem/mutineer#lib/mutineer/mutators/string_literal.rb:12
class Mutineer::Mutators::StringLiteral < ::Mutineer::Mutators::Base
  # Visits string literals.
  #
  # @param node [Prism::StringNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/string_literal.rb:17
  def visit_string_node(node); end
end

# Ends a forked child's process group once the process that forked it is
# gone (#101). A mutant or capture child leads its own process group, so a
# parent that dies, or is killed by a client that gave up on it, does not
# take the child's tests with it; without this, a hung test would run on and
# keep its worker database open. Needs no other part of Mutineer, so the
# app-side daemon can load it.
#
# pkg:gem/mutineer#lib/mutineer/orphan_guard.rb:10
module Mutineer::OrphanGuard
  class << self
    # True when a daemon mutant file still belongs to a live process. A boot
    # sweep must leave it alone. The database lock is taken later, so the
    # sweep is the step that used to delete another run's file.
    #
    # The creating pid is in the file name. A process that still holds the
    # file lock counts too, even when that pid is already gone. A dead pid
    # and a free lock is an orphan a killed child left behind.
    #
    # @param path [String] absolute path of a `.mutineer_daemon*.rb` file.
    # @return [Boolean]
    #
    # pkg:gem/mutineer#lib/mutineer/orphan_guard.rb:42
    def mutant_file_in_use?(path); end

    # Starts the watchdog in the current (child) process.
    #
    # @param parent [Integer] the parent's pid, read in the parent before
    #   `fork`, so a parent that dies before this call is still noticed.
    # @return [Thread]
    #
    # pkg:gem/mutineer#lib/mutineer/orphan_guard.rb:23
    def start(parent); end

    private

    # True when the pid embedded in a daemon mutant file name is still running.
    # Pid 0 is this process group, so it is never treated as an owner.
    #
    # @param path [String]
    # @return [Boolean]
    #
    # pkg:gem/mutineer#lib/mutineer/orphan_guard.rb:51
    def creator_alive?(path); end

    # True when another process holds an exclusive lock on `path`. A lock the
    # kernel rejects as unsupported is not ownership: the pid check still applies.
    # A file we cannot inspect is left in place.
    #
    # @param path [String]
    # @return [Boolean]
    #
    # pkg:gem/mutineer#lib/mutineer/orphan_guard.rb:89
    def locked_by_another?(path); end

    # True when `pid` has exited but nobody reaped it. A container whose pid 1
    # does not reap orphans keeps a dead mutant child as a zombie for good, and
    # `Process.kill(0)` still finds it (#250). Linux only: elsewhere there is no
    # `/proc`, so a zombie still counts as running.
    #
    # @param pid [Integer]
    # @return [Boolean]
    #
    # pkg:gem/mutineer#lib/mutineer/orphan_guard.rb:73
    def zombie?(pid); end
  end
end

# `Tempfile.create([".mutineer_daemon", ".rb"])` names the file
# `.mutineer_daemon<YYYYMMDD>-<pid>-<rand>.rb` (without the dot before #253).
# The pid is the child that is loading the mutant.
#
# pkg:gem/mutineer#lib/mutineer/orphan_guard.rb:16
Mutineer::OrphanGuard::DAEMON_TEMP_PID = T.let(T.unsafe(nil), Regexp)

# Seconds between checks. A forked child gets no signal on parent death.
#
# pkg:gem/mutineer#lib/mutineer/orphan_guard.rb:12
Mutineer::OrphanGuard::POLL = T.let(T.unsafe(nil), Float)

# Source -> test pairing by path convention (#11). Pure stdlib path logic:
# no Rails, no class loading, no process. Two jobs:
#   * expand_sources — a directory argument becomes its sorted **/*.rb files;
#                     a file inside the root becomes its root-relative path.
#   * infer_tests    — a source's test files by convention (app/ and lib/
#                     sources map to test/.../_test.rb, test/.../<name>_*_test.rb,
#                     test/.../test_*.rb or spec/.../_spec.rb), preserving
#                     namespaced subdirectories. The first EXISTING exact
#                     candidate stays first. Split Minitest files join a
#                     Minitest match. A matched spec is left as that one file.
#
# Independently unit-testable: every method is pure in/out over the
# filesystem, so the pairing contract is exercised with plain fixtures, no
# Rails, no fork.
#
# pkg:gem/mutineer#lib/mutineer/pairing.rb:20
module Mutineer::Pairing
  private

  # Ordered candidate test paths: _test.rb, then Minitest's test_*.rb, then
  # _spec.rb. lib/ sources also get the test/lib/... and spec/lib/... layouts.
  #
  # @param base [String] logical source path without extension.
  # @param lib [Boolean] whether the source originated from lib/.
  # @param prefer [String] preferred framework name.
  # @return [Array<String>] candidate test paths in preferred order.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:134
  def candidates(base, lib, prefer); end

  # True when a longer source file on disk owns this split test. `user.rb`
  # does not take `user_session_test.rb` when `user_session.rb` exists in the
  # same directory, under `app/`, or under `lib/`. An intermediate file
  # counts: `bar_upsert.rb` owns `bar_upsert_guards_test.rb`, so `bar.rb`
  # does not.
  #
  # @param root [String] expanded project root.
  # @param base [String] logical source path without extension.
  # @param entry [String] test file basename.
  # @param scanned_dir [String, nil] relative test directory being scanned.
  #   When set, a longer source claims the file only if that source searches
  #   this directory. An `app/` source does not take a `test/lib/` file.
  # @return [Boolean]
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:234
  def claimed_by_longer_source?(root, base, entry, scanned_dir = T.unsafe(nil)); end

  # An existing file's root-relative path, or nil outside the root. Tries the
  # path as given, then with its directory resolved, so a path typed through
  # a symlinked parent (or macOS `/var` under a `/private/var` root) matches.
  # The file's own name is kept, so a symlinked file is not renamed.
  #
  # @param abs [String] expanded absolute path of an existing file.
  # @param roots [Array<String>] the project root, expanded and real.
  # @return [String, nil] root-relative path, or nil outside the root.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:56
  def existing_relative(abs, roots); end

  # Expand each positional source: a directory -> its sorted **/*.rb files
  # (relative to project_root); a file (or glob, or anything non-directory)
  # -> its path relative to project_root, so `./lib/x.rb` and an absolute
  # path pair like `lib/x.rb` (#104). A missing file, or one outside the
  # root, stays as typed. Flattened, deduped, order-stable.
  #
  # @param args [Array<String>] source paths or directories.
  # @param project_root [String] repository root for relative expansion.
  # @return [Array<String>] flattened, deduped source file list.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:32
  def expand_sources(args, project_root:); end

  # The first test path {#infer_tests} would run for a source, or nil.
  # `prefer` is the resolved framework ("minitest" | "rspec"): its candidates
  # are tried first, the other framework's as fallback, so a minitest default
  # still finds a spec and vice-versa.
  #
  # @param source_rel [String] relative source path.
  # @param project_root [String] repository root for existence checks.
  # @param prefer [String] preferred framework name.
  # @return [String, nil] existing test path or nil.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:86
  def infer_test(source_rel, project_root:, prefer: T.unsafe(nil)); end

  # Every test file convention pairs with a source. The first existing exact
  # candidate from {#candidates} stays first. Each `<basename>_*_test.rb` in
  # the mirrored test directory is added after it (#87). A spec that the exact
  # rules already found is left alone: split Minitest names do not join it
  # and do not replace it.
  #
  # @param source_rel [String] relative source path.
  # @param project_root [String] repository root for existence checks.
  # @param prefer [String] preferred framework name.
  # @return [Array<String>] existing test paths, exact candidate first.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:100
  def infer_tests(source_rel, project_root:, prefer: T.unsafe(nil)); end

  # True when `dir_abs` is the project root or a directory inside it.
  # A source path such as `../../evil.rb` must not list tests outside the project.
  #
  # @param dir_abs [String] expanded directory.
  # @param root_abs [String] expanded project root.
  # @return [Boolean]
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:203
  def inside_project?(dir_abs, root_abs); end

  # Strip the source root to a logical path (no ".rb") and flag lib/
  # sources. app/foo/bar.rb and lib/foo/bar.rb both -> "foo/bar"; anything
  # else -> the path minus ".rb" (still attempted). Namespaced subdirs are
  # preserved verbatim — structural, never constant resolution.
  #
  # @param source_rel [String] relative source path.
  # @return [Array(String, Boolean)] logical base path and whether it came from lib/.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:116
  def logical_path(source_rel); end

  # True when `entry` is the exact test, or a split test with a non-empty
  # piece, for `stem`. `user_session__test.rb` is neither for
  # `user_session`, so that source does not take it from `user.rb`.
  #
  # @param entry [String] test file basename.
  # @param stem [String] longer source basename without extension.
  # @return [Boolean]
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:259
  def longer_owns_entry?(entry, stem); end

  # True when a longer source file exists beside this logical path.
  # The logical directory itself is checked, so `src/user_session.rb` owns
  # `test/src/user_session_test.rb`. `app/` and `lib/` are checked too, so an
  # `app/` source still yields the name to a `lib/` sibling and the reverse.
  #
  # @param root [String] expanded project root.
  # @param dir [String] logical directory, or `.` when the source has none.
  # @param stem [String] longer source basename without extension.
  # @param scanned_dir [String, nil] relative test directory being scanned.
  # @return [Boolean]
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:273
  def longer_source_exists?(root, dir, stem, scanned_dir = T.unsafe(nil)); end

  # Relative test directory for a logical source path. A source with no
  # subdirectory (`calc`) maps to `prefix` itself, not `prefix/.`.
  #
  # @param prefix [String] `test` or `test/lib`.
  # @param base [String] logical source path without extension.
  # @return [String] relative directory.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:170
  def mirror_dir(prefix, base); end

  # `abs` relative to the first of `roots` it is under, or nil. Text only: a
  # symlinked source keeps its own name (realpath would rename it to its
  # target and pair the wrong test). `roots` holds the root's real path too,
  # so the macOS `/var` vs `/private/var` alias still matches.
  #
  # @param abs [String] expanded absolute path.
  # @param roots [Array<String>] the project root, expanded and real.
  # @return [String, nil] root-relative path, or nil outside the root.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:69
  def root_relative(abs, roots); end

  # True when pairing this source looks in `scanned_dir`.
  #
  # @param source_rel [String] project-relative source path.
  # @param scanned_dir [String] relative test directory.
  # @return [Boolean]
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:291
  def source_searches_dir?(source_rel, scanned_dir); end

  # True when `entry` is `<name>_<piece>_test.rb` and not the exact
  # `<name>_test.rb` file.
  #
  # @param entry [String] test file basename.
  # @param name [String] source basename without extension.
  # @return [Boolean]
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:214
  def split_entry?(entry, name); end

  # `<basename>_*_test.rb` files in each mirrored test directory (#87). The
  # exact `<basename>_test.rb` name is not included. `lib/` sources also look
  # under `test/lib/`. Names are matched as text, not as a glob, so a basename
  # that contains `*` stays literal. `test/` comes before `test/lib/`, and
  # each directory is sorted.
  #
  # @param base [String] logical source path without extension.
  # @param lib [Boolean] whether the source originated from lib/.
  # @param root [String] expanded project root.
  # @return [Array<String>] relative split-test paths.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:157
  def split_test_files(base, lib, root); end

  # Split test files directly inside `dir_rel` (not in subdirectories).
  #
  # @param root [String] expanded project root.
  # @param dir_rel [String] relative directory.
  # @param name [String] source basename without extension.
  # @param base [String] logical source path without extension.
  # @return [Array<String>] sorted relative paths.
  #
  # pkg:gem/mutineer#lib/mutineer/pairing.rb:182
  def split_tests_in(root, dir_rel, name, base); end

  class << self
    # Ordered candidate test paths: _test.rb, then Minitest's test_*.rb, then
    # _spec.rb. lib/ sources also get the test/lib/... and spec/lib/... layouts.
    #
    # @param base [String] logical source path without extension.
    # @param lib [Boolean] whether the source originated from lib/.
    # @param prefer [String] preferred framework name.
    # @return [Array<String>] candidate test paths in preferred order.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:134
    def candidates(base, lib, prefer); end

    # True when a longer source file on disk owns this split test. `user.rb`
    # does not take `user_session_test.rb` when `user_session.rb` exists in the
    # same directory, under `app/`, or under `lib/`. An intermediate file
    # counts: `bar_upsert.rb` owns `bar_upsert_guards_test.rb`, so `bar.rb`
    # does not.
    #
    # @param root [String] expanded project root.
    # @param base [String] logical source path without extension.
    # @param entry [String] test file basename.
    # @param scanned_dir [String, nil] relative test directory being scanned.
    #   When set, a longer source claims the file only if that source searches
    #   this directory. An `app/` source does not take a `test/lib/` file.
    # @return [Boolean]
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:234
    def claimed_by_longer_source?(root, base, entry, scanned_dir = T.unsafe(nil)); end

    # An existing file's root-relative path, or nil outside the root. Tries the
    # path as given, then with its directory resolved, so a path typed through
    # a symlinked parent (or macOS `/var` under a `/private/var` root) matches.
    # The file's own name is kept, so a symlinked file is not renamed.
    #
    # @param abs [String] expanded absolute path of an existing file.
    # @param roots [Array<String>] the project root, expanded and real.
    # @return [String, nil] root-relative path, or nil outside the root.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:56
    def existing_relative(abs, roots); end

    # Expand each positional source: a directory -> its sorted **/*.rb files
    # (relative to project_root); a file (or glob, or anything non-directory)
    # -> its path relative to project_root, so `./lib/x.rb` and an absolute
    # path pair like `lib/x.rb` (#104). A missing file, or one outside the
    # root, stays as typed. Flattened, deduped, order-stable.
    #
    # @param args [Array<String>] source paths or directories.
    # @param project_root [String] repository root for relative expansion.
    # @return [Array<String>] flattened, deduped source file list.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:32
    def expand_sources(args, project_root:); end

    # The first test path {#infer_tests} would run for a source, or nil.
    # `prefer` is the resolved framework ("minitest" | "rspec"): its candidates
    # are tried first, the other framework's as fallback, so a minitest default
    # still finds a spec and vice-versa.
    #
    # @param source_rel [String] relative source path.
    # @param project_root [String] repository root for existence checks.
    # @param prefer [String] preferred framework name.
    # @return [String, nil] existing test path or nil.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:86
    def infer_test(source_rel, project_root:, prefer: T.unsafe(nil)); end

    # Every test file convention pairs with a source. The first existing exact
    # candidate from {#candidates} stays first. Each `<basename>_*_test.rb` in
    # the mirrored test directory is added after it (#87). A spec that the exact
    # rules already found is left alone: split Minitest names do not join it
    # and do not replace it.
    #
    # @param source_rel [String] relative source path.
    # @param project_root [String] repository root for existence checks.
    # @param prefer [String] preferred framework name.
    # @return [Array<String>] existing test paths, exact candidate first.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:100
    def infer_tests(source_rel, project_root:, prefer: T.unsafe(nil)); end

    # True when `dir_abs` is the project root or a directory inside it.
    # A source path such as `../../evil.rb` must not list tests outside the project.
    #
    # @param dir_abs [String] expanded directory.
    # @param root_abs [String] expanded project root.
    # @return [Boolean]
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:203
    def inside_project?(dir_abs, root_abs); end

    # Strip the source root to a logical path (no ".rb") and flag lib/
    # sources. app/foo/bar.rb and lib/foo/bar.rb both -> "foo/bar"; anything
    # else -> the path minus ".rb" (still attempted). Namespaced subdirs are
    # preserved verbatim — structural, never constant resolution.
    #
    # @param source_rel [String] relative source path.
    # @return [Array(String, Boolean)] logical base path and whether it came from lib/.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:116
    def logical_path(source_rel); end

    # True when `entry` is the exact test, or a split test with a non-empty
    # piece, for `stem`. `user_session__test.rb` is neither for
    # `user_session`, so that source does not take it from `user.rb`.
    #
    # @param entry [String] test file basename.
    # @param stem [String] longer source basename without extension.
    # @return [Boolean]
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:259
    def longer_owns_entry?(entry, stem); end

    # True when a longer source file exists beside this logical path.
    # The logical directory itself is checked, so `src/user_session.rb` owns
    # `test/src/user_session_test.rb`. `app/` and `lib/` are checked too, so an
    # `app/` source still yields the name to a `lib/` sibling and the reverse.
    #
    # @param root [String] expanded project root.
    # @param dir [String] logical directory, or `.` when the source has none.
    # @param stem [String] longer source basename without extension.
    # @param scanned_dir [String, nil] relative test directory being scanned.
    # @return [Boolean]
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:273
    def longer_source_exists?(root, dir, stem, scanned_dir = T.unsafe(nil)); end

    # Relative test directory for a logical source path. A source with no
    # subdirectory (`calc`) maps to `prefix` itself, not `prefix/.`.
    #
    # @param prefix [String] `test` or `test/lib`.
    # @param base [String] logical source path without extension.
    # @return [String] relative directory.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:170
    def mirror_dir(prefix, base); end

    # `abs` relative to the first of `roots` it is under, or nil. Text only: a
    # symlinked source keeps its own name (realpath would rename it to its
    # target and pair the wrong test). `roots` holds the root's real path too,
    # so the macOS `/var` vs `/private/var` alias still matches.
    #
    # @param abs [String] expanded absolute path.
    # @param roots [Array<String>] the project root, expanded and real.
    # @return [String, nil] root-relative path, or nil outside the root.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:69
    def root_relative(abs, roots); end

    # True when pairing this source looks in `scanned_dir`.
    #
    # @param source_rel [String] project-relative source path.
    # @param scanned_dir [String] relative test directory.
    # @return [Boolean]
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:291
    def source_searches_dir?(source_rel, scanned_dir); end

    # True when `entry` is `<name>_<piece>_test.rb` and not the exact
    # `<name>_test.rb` file.
    #
    # @param entry [String] test file basename.
    # @param name [String] source basename without extension.
    # @return [Boolean]
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:214
    def split_entry?(entry, name); end

    # `<basename>_*_test.rb` files in each mirrored test directory (#87). The
    # exact `<basename>_test.rb` name is not included. `lib/` sources also look
    # under `test/lib/`. Names are matched as text, not as a glob, so a basename
    # that contains `*` stays literal. `test/` comes before `test/lib/`, and
    # each directory is sorted.
    #
    # @param base [String] logical source path without extension.
    # @param lib [Boolean] whether the source originated from lib/.
    # @param root [String] expanded project root.
    # @return [Array<String>] relative split-test paths.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:157
    def split_test_files(base, lib, root); end

    # Split test files directly inside `dir_rel` (not in subdirectories).
    #
    # @param root [String] expanded project root.
    # @param dir_rel [String] relative directory.
    # @param name [String] source basename without extension.
    # @param base [String] logical source path without extension.
    # @return [Array<String>] sorted relative paths.
    #
    # pkg:gem/mutineer#lib/mutineer/pairing.rb:182
    def split_tests_in(root, dir_rel, name, base); end
  end
end

# Raised only for I/O failures while reading a source file.
#
# Prism syntax errors are NOT raised — they are in-band via ParseResult#errors.
#
# pkg:gem/mutineer#lib/mutineer/parser.rb:9
class Mutineer::ParseError < ::StandardError; end

# Thin boundary around Prism.
#
# The parse methods return a Prism::ParseResult so all callers use
# result.value, result.source.source (raw bytes), and result.errors
# uniformly. No wrapping struct.
#
# pkg:gem/mutineer#lib/mutineer/parser.rb:16
class Mutineer::Parser
  class << self
    # The comments of source text, without building its syntax tree: a few
    # times cheaper than {.parse_string} for a caller that needs only these.
    #
    # @param source [String] source text.
    # @return [Array<Prism::Comment>] its comments, in source order.
    #
    # pkg:gem/mutineer#lib/mutineer/parser.rb:41
    def comments(source); end

    # Parses a file with Prism.
    #
    # @param path [String] source file path.
    # @return [Prism::ParseResult] Prism parse result.
    # @raise [Mutineer::ParseError] when file I/O fails.
    #
    # pkg:gem/mutineer#lib/mutineer/parser.rb:22
    def parse_file(path); end

    # Parses source text with Prism.
    #
    # @param source [String] source text.
    # @return [Prism::ParseResult] Prism parse result.
    #
    # pkg:gem/mutineer#lib/mutineer/parser.rb:32
    def parse_string(source); end
  end
end

# Coarse run progress on stderr: one line per 10% step of completed mutants
# (which means every completion on a run smaller than ten). Shared by every
# backend so a long run is never silent between config resolution and the
# report. Thread-safe so the daemon's parallel workers can share one instance.
# Writes only to stderr, keeping `--format json` stdout and `--output` files
# byte-exact per the Reporter's stream contract.
#
# pkg:gem/mutineer#lib/mutineer/progress.rb:10
class Mutineer::Progress
  # Builds a progress counter for a run of `total` mutants.
  #
  # @param total [Integer] number of mutants that will run.
  # @param io [IO] destination stream (defaults to stderr; injectable for tests).
  #
  # pkg:gem/mutineer#lib/mutineer/progress.rb:15
  def initialize(total, io: T.unsafe(nil)); end

  # Records one completed mutant and prints when a 10% boundary is crossed.
  # A zero-total counter never prints (guards the division, and an empty run
  # has nothing to report).
  #
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/progress.rb:28
  def tick; end
end

# Subject discovery: parse each path and walk its AST for method definitions,
# tracking the enclosing class/module namespace.
#
# pkg:gem/mutineer#lib/mutineer/project.rb:11
class Mutineer::Project
  class << self
    # Discovers subjects from source paths.
    #
    # @param paths [Array<String>] source file paths.
    # @param only [String, nil] optional qualified-name filter.
    # @return [Array<Mutineer::Subject>] discovered subjects.
    #
    # pkg:gem/mutineer#lib/mutineer/project.rb:17
    def discover(paths, only: T.unsafe(nil)); end
  end
end

# Walks an AST, maintaining a namespace stack, emitting Subjects.
# Nested inside Project to signal its private role.
#
# pkg:gem/mutineer#lib/mutineer/project.rb:30
class Mutineer::Project::SubjectVisitor < ::Prism::Visitor
  # Builds a subject visitor.
  #
  # @param file [String] source file path being visited.
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:64
  def initialize(file); end

  # Promote `module_function :name` / `module_function def name` subjects to
  # singleton after the full walk — the naming call may appear before or after
  # the def, so it can't be decided at visit_def_node time (#20). Only methods
  # of the module that made the call are promoted (#98), matched by {#module_key}.
  #
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:95
  def promote_module_functions!; end

  # pkg:gem/mutineer#lib/mutineer/project.rb:59
  def subjects; end

  # A block that does not build a class may run with any `self` (`class_eval`,
  # `instance_eval`, a callback), so a `class << self` in it names a singleton
  # class Mutineer cannot be sure of (#216). A lambda is treated the same.
  #
  # @param node [Prism::BlockNode, Prism::LambdaNode] block or lambda node.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:183
  def visit_block_node(node); end

  # Track `module_function` so its methods are recorded as singletons (#20) —
  # the called form is the singleton method on the module object. Bareword
  # `module_function` flips all SUBSEQUENT defs in this body; the argument
  # forms (`:sym`, `def`) name methods promoted after the walk. A builder
  # block's defs belong to the class it builds; one not assigned to a
  # constant has no name, so its subjects are marked `owner_unknown`, and a
  # `module_function :name` in it promotes nothing. Elsewhere it promotes the
  # methods of the same module, matched by {#module_key}. A module that runs
  # `extend ActiveSupport::Concern` is a concern from then on in this file. A
  # `class_methods` block in its body (see {#concern_block}) is visited like a
  # builder block that builds the module's `ClassMethods`, so its defs belong to
  # that module (#252). The defs in any other such block have their owner unknown.
  #
  # @param node [Prism::CallNode] call node.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:133
  def visit_call_node(node); end

  # Visits class nodes and tracks namespace nesting.
  #
  # @param node [Prism::ClassNode] class node.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:106
  def visit_class_node(node); end

  # pkg:gem/mutineer#lib/mutineer/project.rb:217
  def visit_constant_and_write_node(node); end

  # pkg:gem/mutineer#lib/mutineer/project.rb:216
  def visit_constant_or_write_node(node); end

  # pkg:gem/mutineer#lib/mutineer/project.rb:219
  def visit_constant_path_and_write_node(node); end

  # pkg:gem/mutineer#lib/mutineer/project.rb:218
  def visit_constant_path_or_write_node(node); end

  # pkg:gem/mutineer#lib/mutineer/project.rb:215
  def visit_constant_path_write_node(node); end

  # Names the class a builder block assigned to this constant builds (see {#builds_class?}).
  #
  # `=`, `||=` and `&&=` store the class, so each names it; `+=` stores what `+`
  # returns, so its builder is left unnamed.
  #
  # @param node [Prism::ConstantWriteNode, Prism::ConstantPathWriteNode, Prism::ConstantOrWriteNode,
  #   Prism::ConstantAndWriteNode, Prism::ConstantPathOrWriteNode, Prism::ConstantPathAndWriteNode]
  #   constant assignment.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:203
  def visit_constant_write_node(node); end

  # Records a discovered method definition.
  #
  # @param node [Prism::DefNode] method definition node.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:246
  def visit_def_node(node); end

  # pkg:gem/mutineer#lib/mutineer/project.rb:192
  def visit_lambda_node(node); end

  # Visits module nodes and tracks namespace nesting.
  #
  # @param node [Prism::ModuleNode] module node.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:114
  def visit_module_node(node); end

  # Methods inside `class << self` are class methods of the enclosing
  # namespace, but their def nodes have no receiver — track the singleton
  # context so they're recorded as singleton (so redefine targets the
  # singleton_class, not instances). `class << some_other_obj` can't be
  # represented against the namespace, so its defs are skipped (not recursed).
  #
  # @param node [Prism::SingletonClassNode] singleton-class node.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:229
  def visit_singleton_class_node(node); end

  private

  # Resolves the constant an assignment writes the way Ruby does. `X` is in the
  # current namespace, `::X` and a path at the top level start from Object, and
  # `self::X` is under the current class (the built class inside a builder
  # block). In a block that does not build a class, `self` may be any object,
  # so `self::X` there has its owner unknown (#229). Any other path is
  # looked up at run time, so its owner is unknown
  # and the subject is named as written. Lexically inside `class << self`,
  # even within a builder block there, the constant belongs to the singleton
  # class, which has no constant path, so its owner is unknown too, as is
  # `X` or `self::X` in a class or module opened there (#208). A `::X` there
  # is named `X`, still unknown (see {#with_namespace}).
  #
  # @param node [Prism::Node] constant assignment.
  # @return [Array(String, Array<String>, Boolean)] owner, namespace, unknown.
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:392
  def assigned_owner(node); end

  # The value an assignment stores: the last statement inside parentheses or a
  # `begin` without `rescue`, which Ruby returns from them.
  #
  # @param node [Prism::Node] assigned expression.
  # @return [Prism::Node, nil]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:459
  def assigned_value(node); end

  # True when the node is `Data.define`, `Struct.new`, `Class.new` or `Module.new` with a block.
  #
  # @param node [Prism::Node, nil] node.
  # @return [Boolean]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:476
  def builds_class?(node); end

  # Sorts an ActiveSupport::Concern block by where redefine can load its defs.
  # ActiveSupport evaluates a `class_methods` block in the module's `ClassMethods`,
  # which it extends onto every includer, so the test calls `Includer.name` on
  # that module's method, not on the concern (#252). In a class or module body,
  # or a builder block, with a known owner, that module is `<namespace>::ClassMethods`.
  # The block keeps the lexical scope, so redefine reopens the concern's chain and
  # loads the mutant with `::Concern::ClassMethods.class_eval`. In a def, a block
  # that does not build a class (Rails' `concerning :Name do`), `class << self`, or
  # under an owner no constant names (an unassigned `Module.new`), no constant here
  # names that `ClassMethods`. ActiveSupport evaluates an `included` or `prepended`
  # block in each includer, which no constant names either. The call has no
  # receiver or `self`, no arguments, and a block.
  #
  # Another library can define methods with these names and run the block in
  # the module itself. So a `class_methods` block counts only in a module that ran
  # `extend ActiveSupport::Concern` earlier in this file, in this body or an earlier
  # one ({#module_key}). Any other block with these names is unplaceable: guessing
  # its owner would load a mutant where the tests never call it.
  #
  # @param node [Prism::CallNode] call node.
  # @return [Symbol, nil] `:class_methods` when redefine can name the module,
  #   `:owner_unknown` for any other Concern block, or nil for any other call.
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:503
  def concern_block(node); end

  # Extracts a constant name from a Prism constant node.
  #
  # @api private
  # @param node [Prism::Node] constant node.
  # @return [String, nil] constant name.
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:570
  def extract_constant_name(node); end

  # True for an `included` or `prepended` block of a module that ran `extend
  # ActiveSupport::Concern` earlier in this file (see {#concern_block}).
  # ActiveSupport runs the block only when a class first includes or prepends
  # the concern, so loading the file again stores the new block but never
  # runs it in a class that already has the concern (#256). Everything the
  # block defines, a nested class or a builder block included, stays as the
  # original wrote it under `--strategy reload`.
  #
  # @param node [Prism::CallNode] a call {#concern_block} sorted as a concern block.
  # @return [Boolean]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:521
  def hook_block?(node); end

  # The module a `module_function` call and a def are matched by: its joined
  # namespace, so a module reopened later in the file matches (#216), and
  # `module A::B` matches nested `module A; module B`. An unknown owner that an
  # anonymous builder block owns, or whose name has no {WrittenName} segment
  # and is not built only from constant names (see {#named_segment?}), may be
  # shared by another module, so it is matched only within this body (#208).
  # Otherwise a name with a {WrittenName}
  # segment is matched by that segment's scope and text, so openings under one
  # `self` match each other, but not those under another, whether the owner is
  # known or not (#229).
  #
  # @return [String, Object]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:282
  def module_key; end

  # The owner for a resolved namespace, root-anchored so the redefine
  # wrapper loads onto that constant from any nesting.
  #
  # @param namespace [Array<String>] resolved namespace.
  # @return [Array(String, Array<String>, Boolean)]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:450
  def named_owner(namespace); end

  # True when a namespace segment is a constant name, or a singleton class
  # (`#<Class:App::M>`) of constant names. A written path or `#<anonymous>` is
  # not, nor is a singleton class name built on one ({WrittenName}).
  #
  # @param segment [String] namespace segment.
  # @return [Boolean]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:305
  def named_segment?(segment); end

  # Runs the block and then restores every {SCOPE_STATE} variable, so a
  # nested body's state never leaks out of it.
  #
  # @yield the nested visit.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:371
  def preserving_scope; end

  # True when a constant path starts with `::` (e.g. `::X` or `::A::B`).
  #
  # @param node [Prism::Node] constant path node.
  # @return [Boolean]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:560
  def root_anchored?(node); end

  # True when a constant path starts with `self` (e.g. `self::X`).
  #
  # @param node [Prism::Node] constant path node.
  # @return [Boolean]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:551
  def self_rooted?(node); end

  # Names the singleton class that owns the constants written here: `class << self`
  # opens that of the current class (the built class inside a builder block),
  # and a builder block inside `class << self` keeps the enclosing one. A block
  # not assigned to a constant builds a class with no name, written `#<anonymous>`.
  # Each nested `class << self` opens the singleton class of the one around it.
  # A name built on a written path or `#<anonymous>`, or opened where `self` may
  # be another object (in a def or a non-builder block), is a {WrittenName} (see {#module_key}).
  #
  # @return [String] e.g. `#<Class:App>`, or `#<Class:#<Class:App>>` two deep.
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:436
  def singleton_name; end

  # Runs the block with the defs it visits owned by the class a builder block builds.
  # The block body defines instance methods of that class, even inside `class << self`,
  # but its constants still land where the enclosing `class << self` puts them.
  #
  # @param owner [Array(String, Array<String>, Boolean)] the owner as written, its namespace,
  #   and whether that name is unknown.
  # @param anonymous [Boolean] true when the block is not assigned to a constant.
  # @yield the builder call visit.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:534
  def with_block_owner(owner, anonymous); end

  # Runs the block with `path` pushed as the current namespace. A
  # root-anchored path (`module ::X` / `class ::X`) names the top-level X,
  # not X nested in the enclosing scope, so the namespace restarts there.
  # Bareword `module_function` state does not cross a class or module
  # boundary: each body starts without it, and the outer state returns after.
  # A class or module `X` opened inside `class << self`, even within a builder
  # block there, is a constant of the singleton class, which has no constant
  # path. It and everything nested in it is named under `#<Class:...>` with
  # its owner unknown (#208), and its body defines instance methods again.
  # A compact `Foo::X` or a top-level `::X` there is named as written, and
  # its owner is unknown too: redefine reopens the lexical chain without the
  # singleton class, so constants the body looks up through it would not resolve.
  # A `self::X` in any block is under the block's `self`, not the namespace
  # around the block (#229). In a builder block that is the built class, so
  # it is named under the builder's constant; in any other block (`class_eval`,
  # a callback) `self` may be any object, so it is named under the innermost
  # enclosing builder's constant, or else the enclosing namespace. Either way
  # the last segment is a {WrittenName}, and it and everything nested in it
  # has its owner unknown. Redefine reopens the lexical chain (`module Outer;
  # module X`), which never reaches the block's `self`; reopening X through
  # its constant with `class_eval`, as for `self::X = ...` in a builder block,
  # would drop X from `Module.nesting`, so constants its body looks up would not resolve.
  #
  # @param path [Prism::Node] the class/module constant path.
  # @yield the class or module body visit.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:336
  def with_namespace(path); end

  # True when any segment of the namespace is a {WrittenName}.
  #
  # @param namespace [Array<String>] namespace segments.
  # @return [Boolean]
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:295
  def written?(namespace); end
end

# Calls whose block is the body of the class they build: receiver name => method.
#
# pkg:gem/mutineer#lib/mutineer/project.rb:32
Mutineer::Project::SubjectVisitor::CLASS_BUILDERS = T.let(T.unsafe(nil), Hash)

# ActiveSupport::Concern calls whose block another module or class runs (see {#concern_block}).
#
# pkg:gem/mutineer#lib/mutineer/project.rb:35
Mutineer::Project::SubjectVisitor::CONCERN_BLOCKS = T.let(T.unsafe(nil), Array)

# A constant name, or a path of them; Ruby allows Unicode in both.
#
# pkg:gem/mutineer#lib/mutineer/project.rb:38
Mutineer::Project::SubjectVisitor::CONSTANT_PATH = T.let(T.unsafe(nil), Regexp)

# Visitor state a class/module body or builder block sets for what it contains.
#
# pkg:gem/mutineer#lib/mutineer/project.rb:362
Mutineer::Project::SubjectVisitor::SCOPE_STATE = T.let(T.unsafe(nil), Array)

# A name that reads like a constant name but may not be one (#216). It is
# the singleton class name of a `class << self` opened inside a def or a
# block that does not build a class, or built on a written path or
# `#<anonymous>` (`#<Class:Foo::X>` from `class Foo::X` inside `class << self`);
# or the `X` of `module self::X` or `self::X = ...` in a def or a block. The segment carries that mark (see
# {#singleton_name}, {#with_namespace}, {#assigned_owner}), and `scope`, the
# def or block whose `self` the name is under, or a new object when unknown.
#
# pkg:gem/mutineer#lib/mutineer/project.rb:47
class Mutineer::Project::SubjectVisitor::WrittenName < ::String
  # @param name [String] the name as built.
  # @param scope [Object] the def or block node whose `self` the name is under.
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:53
  def initialize(name, scope = T.unsafe(nil)); end

  # @return [Object] the def or block node whose `self` the name is under.
  #
  # pkg:gem/mutineer#lib/mutineer/project.rb:49
  def scope; end
end

# Realpath-based path normalization against a project root. Shared by the
# coverage cache (map keys) and mutant ids (the path hashed into each id), so
# `lib/x.rb`, `./lib/x.rb`, an absolute path and a path through a symlinked
# root all resolve to the same key. Realpaths on both sides also absorb the
# macOS `/var` vs `/private/var` alias.
#
# pkg:gem/mutineer#lib/mutineer/project_path.rb:9
module Mutineer::ProjectPath
  private

  # Expands `path` against `root`, resolved to its real path when it exists.
  #
  # @param path [String] relative (to `root`) or absolute path.
  # @param root [String] project root.
  # @return [String] absolute path.
  #
  # pkg:gem/mutineer#lib/mutineer/project_path.rb:32
  def absolute(path, root); end

  # Path of `path` relative to the real project root. A path outside the root
  # comes back as its absolute real path.
  #
  # @param path [String] relative (to `root`) or absolute path.
  # @param root [String] project root.
  # @return [String] root-relative path, or an absolute path when outside `root`.
  #
  # pkg:gem/mutineer#lib/mutineer/project_path.rb:18
  def relative(path, root); end

  # Canonical project root (`/var` vs `/private/var`). Any file system error
  # (missing, unreadable, a symlink loop) falls back to the expanded path, so
  # a caller such as the CLI's run-root warning never crashes on it.
  #
  # @param root [String] project root.
  # @return [String] realpath of the root when it exists, else its expanded path.
  #
  # pkg:gem/mutineer#lib/mutineer/project_path.rb:51
  def root_real(root); end

  class << self
    # Expands `path` against `root`, resolved to its real path when it exists.
    #
    # @param path [String] relative (to `root`) or absolute path.
    # @param root [String] project root.
    # @return [String] absolute path.
    #
    # pkg:gem/mutineer#lib/mutineer/project_path.rb:32
    def absolute(path, root); end

    # Path of `path` relative to the real project root. A path outside the root
    # comes back as its absolute real path.
    #
    # @param path [String] relative (to `root`) or absolute path.
    # @param root [String] project root.
    # @return [String] root-relative path, or an absolute path when outside `root`.
    #
    # pkg:gem/mutineer#lib/mutineer/project_path.rb:18
    def relative(path, root); end

    # Canonical project root (`/var` vs `/private/var`). Any file system error
    # (missing, unreadable, a symlink loop) falls back to the expanded path, so
    # a caller such as the CLI's run-root warning never crashes on it.
    #
    # @param root [String] project root.
    # @return [String] realpath of the root when it exists, else its expanded path.
    #
    # pkg:gem/mutineer#lib/mutineer/project_path.rb:51
    def root_real(root); end
  end
end

# Pins the environment Rails and Spring read during a mutant run.
#
# Rails reads +PARALLEL_WORKERS+ inside +parallelize+ and uses it instead of
# the +workers:+ argument. A value of 1 keeps that run in one process.
# +--test-command+ also sets +DISABLE_SPRING+ so the Spring preloader does
# not start. {pin_process!} prints the replacement line once. The caller
# puts the process value back with {restore_process!} when the run ends.
#
# pkg:gem/mutineer#lib/mutineer/rails_run_env.rb:11
module Mutineer::RailsRunEnv
  class << self
    # Forces +PARALLEL_WORKERS+ on a child environment.
    # +spring+ also sets +DISABLE_SPRING+. The hash is the spawn delta or the
    # full daemon environment. This does not change the parent process.
    #
    # @param env [Hash{String => String, nil}]
    # @param spring [Boolean] set +DISABLE_SPRING+ when true.
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/rails_run_env.rb:49
    def pin_child!(env, spring: T.unsafe(nil)); end

    # Sets +PARALLEL_WORKERS+ to {PARALLEL_WORKERS} in this process.
    # Prints one line when the previous value is set and is not already 1.
    #
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/rails_run_env.rb:22
    def pin_process!; end

    # Puts the caller's +PARALLEL_WORKERS+ back. +nil+ means it was unset.
    #
    # @param previous [String, nil]
    # @return [void]
    #
    # pkg:gem/mutineer#lib/mutineer/rails_run_env.rb:33
    def restore_process!(previous); end

    private

    # True when Mutineer must replace a +PARALLEL_WORKERS+ value the user set.
    #
    # @param current [String, nil]
    # @return [Boolean]
    #
    # pkg:gem/mutineer#lib/mutineer/rails_run_env.rb:59
    def replace?(current); end

    # The one line printed when {replace?} is true.
    #
    # @param current [String]
    # @return [String]
    #
    # pkg:gem/mutineer#lib/mutineer/rails_run_env.rb:67
    def replacement_line(current); end
  end
end

# Value of +DISABLE_SPRING+ that stops the Spring preloader.
#
# pkg:gem/mutineer#lib/mutineer/rails_run_env.rb:16
Mutineer::RailsRunEnv::DISABLE_SPRING = T.let(T.unsafe(nil), String)

# Value of +PARALLEL_WORKERS+ that keeps Rails test workers off.
#
# pkg:gem/mutineer#lib/mutineer/rails_run_env.rb:13
Mutineer::RailsRunEnv::PARALLEL_WORKERS = T.let(T.unsafe(nil), String)

# Hides database credentials in text bound for a terminal: an error reply,
# a log line, a warning. Rails parses DATABASE_URL itself, so an error about
# a malformed one can quote the whole URL.
#
# Stdlib only: the app-side daemon loads this file without the rest of
# mutineer.
#
# pkg:gem/mutineer#lib/mutineer/redaction.rb:12
module Mutineer::Redaction
  private

  # Split DATABASE_URL into its `scheme://user:` head and its raw password.
  # Read by position, not URI or a pattern, because the URL may be the
  # malformed one and its password may hold any character: the password runs
  # from the first `:` after `scheme://` to the last `@`.
  #
  # @param url [String]
  # @return [Array(String, String), nil]
  #
  # pkg:gem/mutineer#lib/mutineer/redaction.rb:49
  def database_url_parts(url); end

  # The password as it may appear in a message: raw, percent-decoded, and
  # each `inspect` escaped. Longest first, so a longer form is replaced
  # before a form it contains.
  #
  # @param raw [String]
  # @return [Array<String>]
  #
  # pkg:gem/mutineer#lib/mutineer/redaction.rb:67
  def password_forms(raw); end

  # Hide what follows each `head` while it matches the start of `secret`,
  # for a message that cut the URL short inside the password.
  #
  # @param text [String]
  # @param head [String] the DATABASE_URL `scheme://user:` prefix, raw or
  #   `inspect` escaped.
  # @param secret [String]
  # @return [String]
  #
  # pkg:gem/mutineer#lib/mutineer/redaction.rb:85
  def redact_prefixes(text, head, secret); end

  # Hide the password in any URL, and the DATABASE_URL password wherever it
  # appears: whole, percent-decoded, `inspect` escaped, or cut short after
  # its `scheme://user:` prefix.
  #
  # @param text [#to_s]
  # @param env [Hash{String => String}] where DATABASE_URL is read.
  # @return [String]
  #
  # pkg:gem/mutineer#lib/mutineer/redaction.rb:29
  def text(text, env: T.unsafe(nil)); end

  class << self
    # Split DATABASE_URL into its `scheme://user:` head and its raw password.
    # Read by position, not URI or a pattern, because the URL may be the
    # malformed one and its password may hold any character: the password runs
    # from the first `:` after `scheme://` to the last `@`.
    #
    # @param url [String]
    # @return [Array(String, String), nil]
    #
    # pkg:gem/mutineer#lib/mutineer/redaction.rb:49
    def database_url_parts(url); end

    # The password as it may appear in a message: raw, percent-decoded, and
    # each `inspect` escaped. Longest first, so a longer form is replaced
    # before a form it contains.
    #
    # @param raw [String]
    # @return [Array<String>]
    #
    # pkg:gem/mutineer#lib/mutineer/redaction.rb:67
    def password_forms(raw); end

    # Hide what follows each `head` while it matches the start of `secret`,
    # for a message that cut the URL short inside the password.
    #
    # @param text [String]
    # @param head [String] the DATABASE_URL `scheme://user:` prefix, raw or
    #   `inspect` escaped.
    # @param secret [String]
    # @return [String]
    #
    # pkg:gem/mutineer#lib/mutineer/redaction.rb:85
    def redact_prefixes(text, head, secret); end

    # Hide the password in any URL, and the DATABASE_URL password wherever it
    # appears: whole, percent-decoded, `inspect` escaped, or cut short after
    # its `scheme://user:` prefix.
    #
    # @param text [#to_s]
    # @param env [Hash{String => String}] where DATABASE_URL is read.
    # @return [String]
    #
    # pkg:gem/mutineer#lib/mutineer/redaction.rb:29
    def text(text, env: T.unsafe(nil)); end
  end
end

# What replaces a hidden password.
#
# pkg:gem/mutineer#lib/mutineer/redaction.rb:18
Mutineer::Redaction::REDACTED = T.let(T.unsafe(nil), String)

# The password in a `scheme://user:password@host` URL. Greedy up to the last
# `@` before an unescaped quote or line end, so a malformed password with a
# space, an unescaped `@`, or a quote `inspect` escaped (`\"`) is hidden too.
#
# pkg:gem/mutineer#lib/mutineer/redaction.rb:16
Mutineer::Redaction::URL_PASSWORD = T.let(T.unsafe(nil), Regexp)

# Renders an AggregateResult: the summary block, mutation score, and per-file
# survivor diffs. Stream discipline: the report goes to `out` (stdout),
# diagnostics/warnings go to `err` (stderr), so `mutineer ... > report.txt`
# captures only the report.
#
# `source_map` is { file_path => raw source string }, used to extract the
# containing source line for each survivor diff.
#
# pkg:gem/mutineer#lib/mutineer/reporter.rb:16
class Mutineer::Reporter
  # @param aggregate [Mutineer::AggregateResult] the run's results.
  # @param source_map [Hash{String => String}] source file path => source text.
  # @param matrix [Mutineer::KillMatrix, nil] the kill matrix of a `--matrix`
  #   run; nil leaves every format exactly as it is without the flag.
  #
  # pkg:gem/mutineer#lib/mutineer/reporter.rb:42
  def initialize(aggregate, source_map, matrix: T.unsafe(nil)); end

  # 0 pass / 1 below threshold or untestable-with-errors. Usage errors (exit 2)
  # are the CLI's job. When the score is nil (nothing killed or survived), pure
  # no_coverage / all-ignored / empty still skip the gate; if any mutant was
  # errored, timed out, or uncapturable, fail the gate so a broken harness
  # cannot green CI under --threshold.
  #
  # pkg:gem/mutineer#lib/mutineer/reporter.rb:136
  def exit_code(threshold:); end

  # Renders the human report.
  #
  # @param out [IO] output stream.
  # @param err [IO] error stream.
  # @param threshold [Float] score threshold.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/reporter.rb:114
  def human_report(out, err, threshold); end

  # Single entry point. Branches on `format` ("human" | "json" | "html") and
  # routes the rendered report to `output` (a file, with a stderr confirmation)
  # or to `out`. Diagnostics always go to `err`. `scoped` marks a diff-scoped
  # (`--since`) run; the JSON report records it so a consumer (or a later
  # `--baseline` load) knows the score covers only the changed-line mutants.
  # `legacy_id_matches` (`{ignore:, baseline:}`) counts stored ids still in the
  # old format (#126); only the JSON report records it (`summary.legacy_id_matches`).
  #
  # pkg:gem/mutineer#lib/mutineer/reporter.rb:55
  def report(out: T.unsafe(nil), err: T.unsafe(nil), threshold: T.unsafe(nil), format: T.unsafe(nil), output: T.unsafe(nil), baseline: T.unsafe(nil), scoped: T.unsafe(nil), legacy_id_matches: T.unsafe(nil)); end

  # Errors are out of the score, so a run with no --threshold passes however
  # many mutants errored. Say so, and say what --threshold would enforce.
  #
  # @api private
  # @param err [IO] error stream.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/reporter.rb:98
  def warn_errors_without_gate(err); end

  private

  # Mutants that were actually run. Deliberately not `total`: no_coverage,
  # skipped-invalid and ignored mutants are not counted (a #254 no_coverage
  # mutant ran its statement's tests but is not a verdict), so counting them
  # would dilute the share and let a broken run slip under the limit.
  #
  # skipped-invalid is excluded from both sides: it means a mutant did not
  # re-parse and was correctly never run, which is a validity outcome rather
  # than a broken harness. Cost: an overwhelmingly-skipped run still scores on
  # what little ran; that is our operator misbehaving and wants its own signal.
  #
  # @api private
  # @return [Integer] killed + survived + no-verdict.
  #
  # pkg:gem/mutineer#lib/mutineer/reporter.rb:832
  def attempted_count; end

  # The same delta facts the human report prints, for dashboards. new_survivors
  # reuse the mutant_json shape (subject/file/line/operator/token/id) and sort
  # byte-stably so output does not depend on --jobs finish order.
  #
  # pkg:gem/mutineer#lib/mutineer/reporter.rb:570
  def baseline_json(delta); end

  # The --baseline delta, appended after the normal report. Names every NEW
  # survivor (subject (file:line) operator) and the score delta when it dropped,
  # then a one-line REGRESSION/OK verdict so CI logs show which gate fired.
  #
  # pkg:gem/mutineer#lib/mutineer/reporter.rb:884
  def baseline_section(out, delta); end

  # Human-readable counts of the states that produced no verdict. Used by both
  # the nil-score message and the completeness gate, so they agree.
  #
  # @api private
  # @return [String]
  #
  # pkg:gem/mutineer#lib/mutineer/reporter.rb:852
  def broken_counts_detail; end

  # True when nil score is due to errors/timeouts/uncapturable (gate must fail).
  #
  # @api private
  # @return [Boolean]
  #
  # pkg:gem/mutineer#lib/mutineer/reporter.rb:795
  def broken_nil_score?; end

  # Mutants that were attempted but produced no verdict, over everything
  # attempted. Above the limit the score describes too small a slice of the run
  # to gate on. A few flaky mutants in a large run stay under it.
  #
  # @api private
  # @return [Boolean] true when too much of the run failed to produce a verdict.
  #
  # pkg:gem/mutineer#lib/mutineer/reporter.rb:806
  def broken_share_exceeded?; end

  # The `-` or `+` lines of one side. A line with no newline is the file's
  # last, so it gets the unified diff's no-newline marker (#106).
  #
  # @api private
  # @param sign [String] "-" or "+".
  # @param lines [Array<String>] the side's lines, with their endings.
  # @return [String]
  #
  # pkg:gem/mutineer#lib/mutineer/reporter.rb:653
  def diff_body(sign, lines); end

  # Builds a line-aligned diff for a mutation whose byte range may span several
  # lines (e.g. statement-removal of a multi-line statement). Returns the
  # mutation's 1-based start line, the full original line-block it touches, the
  # spliced mutated block, and a single-line token label for the header.
  #
  # pkg:gem/mutineer#lib/mutineer/reporter.rb:708
  def diff_for(m, source); end

  # HTML-escapes any text destined for the document (stdlib CGI).
  #
  # pkg:gem/mutineer#lib/mutineer/reporter.rb:565
  def esc(text); end

  # One self-contained HTML file (inline CSS, no external assets): the overall
  # score + summary counts, a per-source table, and every surviving mutant with
  # its stable id and diff. All source/diff/identifier text is HTML-escaped
  # (CGI.escapeHTML) so a `<`/`>` in source can never break the markup. Reuses
  # survivor_json/per_source_json so one run yields one set of facts regardless
  # of --format.
  #
  # pkg:gem/mutineer#lib/mutineer/reporter.rb:257
  def html_report; end

  # One side of a unified diff hunk header: `start` for one line, else
  # `start,count`; an empty side is `start-1,0` (#106).
  #
  # @api private
  # @param start_line [Integer] 1-based first line of the block.
  # @param lines [Array<String>] the block's lines.
  # @return [String] the range, e.g. "3", "3,2" or "2,0".
  #
  # pkg:gem/mutineer#lib/mutineer/reporter.rb:664
  def hunk_range(start_line, lines); end

  # Ignored mutants, each with its id and its reason when the user gave one.
  #
  # @api private
  # @return [String] HTML, or "" when none were ignored.
  #
  # pkg:gem/mutineer#lib/mutineer/reporter.rb:366
  def ignored_html; end

  # One ignored mutant. `reason` is present only when the user wrote one.
  #
  # @api private
  # @param result [Mutineer::Result] an ignored result.
  # @return [Hash]
  #
  # pkg:gem/mutineer#lib/mutineer/reporter.rb:675
  def ignored_json(result); end

  # Canonical machine-readable schema. survivors/no_coverage are sorted by
  # (file, line, operator) so output is byte-stable regardless of --jobs
  # worker finish order.
  #
  # @api private
  # @param baseline [Mutineer::Baseline::Delta, nil] baseline delta.
  # @param scoped [Boolean] the run was diff-scoped (`--since`), so its score
  #   covers only the changed-line mutants (additive `summary.scoped` key).
  # @param legacy_id_matches [Hash{Symbol => Integer}] `{ignore:, baseline:}`:
