  # pkg:gem/mutineer#lib/mutineer/mutators/return_nil.rb:62
  def emit(loc); end

  # Mutates a method's final expression to nil when eligible.
  #
  # @param body [Prism::Node] method body node.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/return_nil.rb:49
  def final_expression_nil(body); end
end

# Safe-navigation mutator (Tier-2).
#
# Replaces `&.` with `.`, one mutation per occurrence. The mutant raises
# NoMethodError on a nil receiver, so it survives when no test passes nil.
#
# pkg:gem/mutineer#lib/mutineer/mutators/safe_navigation.rb:11
class Mutineer::Mutators::SafeNavigation < ::Mutineer::Mutators::Base
  # Visits `a&.b &&= 1`.
  #
  # @param node [Prism::CallAndWriteNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/safe_navigation.rb:43
  def visit_call_and_write_node(node); end

  # Visits call nodes and emits safe-navigation mutations.
