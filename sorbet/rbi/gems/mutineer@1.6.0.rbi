end

# Token replacements for comparison operators.
#
# pkg:gem/mutineer#lib/mutineer/mutators/comparison.rb:12
Mutineer::Mutators::Comparison::REPLACEMENTS = T.let(T.unsafe(nil), Hash)

# Condition-forcing mutator: the condition becomes `false` (Tier-2).
#
# An `if` branch never runs; an `unless` branch always runs. The mutant
# survives when no test needs the branch the condition guards (for an
# `if`) or skips it (for an `unless`).
#
# pkg:gem/mutineer#lib/mutineer/mutators/condition_forcing.rb:127
class Mutineer::Mutators::ConditionFalse < ::Mutineer::Mutators::ConditionForcing; end

# The operator name mutations carry.
#
# pkg:gem/mutineer#lib/mutineer/mutators/condition_forcing.rb:131
Mutineer::Mutators::ConditionFalse::OPERATOR = T.let(T.unsafe(nil), Symbol)

# The literal the condition is replaced with.
#
# pkg:gem/mutineer#lib/mutineer/mutators/condition_forcing.rb:129
Mutineer::Mutators::ConditionFalse::VALUE = T.let(T.unsafe(nil), FalseClass)

# Shared base of the condition-forcing mutators (Tier-2).
#
# Replaces the condition of an `if`, `elsif`, `unless`, ternary, modifier
# guard (`x if y`) or `case`/`in` guard with a literal, so its branch always
# runs or never runs. {ConditionTrue} forces `true` and {ConditionFalse}
# forces `false`; one mutation per condition each.
#
# A condition that is already `true`, `false` or `nil`, even in
# parentheses, is left alone: forcing it changes nothing or repeats the
# `boolean_literal` flip. This holds even when `boolean_literal` does not run.
# A condition that holds a heredoc is left alone too: the heredoc body lies
# outside the condition, so it would stay behind as code. A condition that
# assigns a variable keeps its code and only its value is forced.
#
# The never-runs side of an else-less conditional can be the same program
# as the `nil` that `statement_removal` or `return_nil` puts in place of the
# whole conditional. It is still made: dropping it would make the mutants
# of one operator depend on which other operators run, and on what the user
# suppressed for them. The two then get the same verdict.
#
# `condition_negation` wraps the condition in `!( ... )`, which neither
# forced value is.
#
# pkg:gem/mutineer#lib/mutineer/mutators/condition_forcing.rb:29
class Mutineer::Mutators::ConditionForcing < ::Mutineer::Mutators::Base
  # Visits if nodes: `if`, `elsif`, a ternary, a modifier `if` and an
  # `in ... if` guard.
  #
  # @param node [Prism::IfNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/condition_forcing.rb:38
  def visit_if_node(node); end

  # Visits unless nodes: `unless`, a modifier `unless` and an
  # `in ... unless` guard.
  #
  # @param node [Prism::UnlessNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/condition_forcing.rb:48
  def visit_unless_node(node); end

  private

  # Emits the forced condition unless the condition is a literal or holds a
  # heredoc, whose body would stay behind as code.
  #
  # @param node [Prism::IfNode, Prism::UnlessNode] the conditional.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/condition_forcing.rb:60
  def force(node); end

  # Returns the forced value for the condition, always in parentheses, so it
  # cannot fuse with a keyword or a `?` next to it: `x if@a` becomes
  # `x if(true)` and `@a?1:2` becomes `(true)?1:2`. A condition that assigns
  # a variable keeps its code, so later reads still see the variable:
  # `(m = x; true)`.
  #
  # @param predicate [Prism::Node] the condition.
  # @return [String] the replacement source.
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/condition_forcing.rb:81
  def replacement(predicate); end

  # Returns the node inside parentheses that hold exactly one expression,
  # so `(true)` and `((true))` read as `true`.
  #
  # @param node [Prism::Node] the condition.
  # @return [Prism::Node] the innermost wrapped node, or `node` itself.
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/condition_forcing.rb:103
  def unwrap(node); end

  # Returns whether the node writes a variable or constant anywhere inside
  # it: a local, instance, class or global variable, or a constant, in a
  # plain, compound, multiple or pattern write, or a named regex capture.
  #
  # @param node [Prism::Node] the node to inspect.
  # @return [Boolean] true when a write or target node is inside.
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/condition_forcing.rb:92
  def writes?(node); end
end

# Condition nodes that `boolean_literal` already mutates.
#
# pkg:gem/mutineer#lib/mutineer/mutators/condition_forcing.rb:31
Mutineer::Mutators::ConditionForcing::LITERALS = T.let(T.unsafe(nil), Array)

# Condition-negation mutator.
#
# Wraps if/unless predicates in `!( ... )` textually.
#
# pkg:gem/mutineer#lib/mutineer/mutators/condition_negation.rb:10
class Mutineer::Mutators::ConditionNegation < ::Mutineer::Mutators::Base
  # Visits if nodes.
  #
  # @param node [Prism::IfNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/condition_negation.rb:15
  def visit_if_node(node); end

  # Visits unless nodes.
  #
  # @param node [Prism::UnlessNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/condition_negation.rb:24
  def visit_unless_node(node); end

  private

  # Wraps a predicate in negation.
  #
  # @param predicate [Prism::Node, nil] predicate node.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/condition_negation.rb:35
  def wrap(predicate); end
end

# Condition-forcing mutator: the condition becomes `true` (Tier-2).
#
# An `if` branch always runs; an `unless` branch never runs. The mutant
# survives when no test runs the code with the condition false (for an
# `if`) or true (for an `unless`) and checks what changes.
#
# pkg:gem/mutineer#lib/mutineer/mutators/condition_forcing.rb:115
class Mutineer::Mutators::ConditionTrue < ::Mutineer::Mutators::ConditionForcing; end

# The operator name mutations carry.
#
# pkg:gem/mutineer#lib/mutineer/mutators/condition_forcing.rb:119
Mutineer::Mutators::ConditionTrue::OPERATOR = T.let(T.unsafe(nil), Symbol)

# The literal the condition is replaced with.
#
# pkg:gem/mutineer#lib/mutineer/mutators/condition_forcing.rb:117
Mutineer::Mutators::ConditionTrue::VALUE = T.let(T.unsafe(nil), TrueClass)

# Literal mutation mutator.
#
# Mutates integers and strings with the Tier-2 literal rules.
#
# pkg:gem/mutineer#lib/mutineer/mutators/literal_mutation.rb:10
class Mutineer::Mutators::LiteralMutation < ::Mutineer::Mutators::Base
  # Visits integer literals.
  #
  # @param node [Prism::IntegerNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/literal_mutation.rb:15
  def visit_integer_node(node); end

  # Visits string literals.
  #
  # @param node [Prism::StringNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/literal_mutation.rb:27
  def visit_string_node(node); end

  private

  # Emits a literal mutation.
  #
  # @param loc [Prism::Location] source location.
  # @param replacement [String] replacement literal.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/literal_mutation.rb:41
  def emit(loc, replacement); end
end

# Negation-removal mutator (Tier-2).
#
# Removes the `!` or `not` of a negation, one mutation per occurrence:
# `!x` becomes `x` and `not x` becomes ` x`. The mutant survives when no
# test depends on the negated value.
#
# pkg:gem/mutineer#lib/mutineer/mutators/negation_removal.rb:12
class Mutineer::Mutators::NegationRemoval < ::Mutineer::Mutators::Base
  # Visits call nodes and emits negation-removal mutations.
  #
  # @param node [Prism::CallNode] call node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/negation_removal.rb:17
  def visit_call_node(node); end

  private

  # Emits a mutation when the node is a prefix `!` or `not`.
  #
  # The explicit form `x.!` is skipped: without its message, `x.` does
  # not parse.
  #
  # @param node [Prism::CallNode] call node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/negation_removal.rb:31
  def emit(node); end
end

# Operand-removal mutator (Tier-2).
#
# Replaces a boolean expression with one of its operands, two mutations
# per `&&`, `||`, `and` or `or`: `a && b` becomes `(a)` and `(b)`. The
# parentheses keep the precedence of `and` and `or`. A surviving mutant
# shows that no test needs the operand that was removed.
#
# pkg:gem/mutineer#lib/mutineer/mutators/operand_removal.rb:13
class Mutineer::Mutators::OperandRemoval < ::Mutineer::Mutators::Base
  # Visits `and` nodes.
  #
  # @param node [Prism::AndNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/operand_removal.rb:22
  def visit_and_node(node); end

  # Visits `or` nodes.
  #
  # @param node [Prism::OrNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/operand_removal.rb:31
  def visit_or_node(node); end

  private

  # Emits one mutation that keeps the left operand, then one that keeps
  # the right operand. The order is fixed, because the two mutants share
  # a token and their occurrence ordinals tell them apart.
  #
  # @param node [Prism::AndNode, Prism::OrNode] connector node.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/operand_removal.rb:44
  def emit(node); end
end

# Node types for jumps. A jump in a value context does not parse, so
# the operator never keeps a jump alone.
#
# pkg:gem/mutineer#lib/mutineer/mutators/operand_removal.rb:16
Mutineer::Mutators::OperandRemoval::JUMPS = T.let(T.unsafe(nil), Array)

# Operator-assignment mutator (Tier-2).
#
# Swaps the operator of a compound assignment, one mutation per
# occurrence: `t += x` -> `t -= x`. Prism parses `t += x` as its own
# node, not as a CallNode, so the arithmetic mutator never sees it.
#
# The mapping is the same as for arithmetic. Other compound operators
# (`||=`, `&&=`, `|=`, `<<=` and the rest) are not changed.
#
# pkg:gem/mutineer#lib/mutineer/mutators/operator_assignment.rb:15
class Mutineer::Mutators::OperatorAssignment < ::Mutineer::Mutators::Base
  # Visits `a.b += x` and `a&.b += x`.
  #
  # @param node [Prism::CallOperatorWriteNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/operator_assignment.rb:79
  def visit_call_operator_write_node(node); end

  # Visits `@@t += x`.
  #
  # @param node [Prism::ClassVariableOperatorWriteNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/operator_assignment.rb:43
  def visit_class_variable_operator_write_node(node); end

  # Visits `T += x`.
  #
  # @param node [Prism::ConstantOperatorWriteNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/operator_assignment.rb:61
  def visit_constant_operator_write_node(node); end

  # Visits `A::T += x` and `::T += x`.
  #
  # @param node [Prism::ConstantPathOperatorWriteNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/operator_assignment.rb:70
  def visit_constant_path_operator_write_node(node); end

  # Visits `$t += x`.
  #
  # @param node [Prism::GlobalVariableOperatorWriteNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/operator_assignment.rb:52
  def visit_global_variable_operator_write_node(node); end

  # Visits `a[i] += x`.
  #
  # @param node [Prism::IndexOperatorWriteNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/operator_assignment.rb:88
  def visit_index_operator_write_node(node); end

  # Visits `@t += x`.
  #
  # @param node [Prism::InstanceVariableOperatorWriteNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/operator_assignment.rb:34
  def visit_instance_variable_operator_write_node(node); end

  # Visits `t += x`.
  #
  # @param node [Prism::LocalVariableOperatorWriteNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/operator_assignment.rb:25
  def visit_local_variable_operator_write_node(node); end

  private

  # Emits a mutation when the node's operator has a replacement.
  #
  # @param node [Prism::Node] a node with `binary_operator` and `binary_operator_loc`.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/operator_assignment.rb:99
  def emit(node); end
end

# Token replacements for compound arithmetic operators.
#
# pkg:gem/mutineer#lib/mutineer/mutators/operator_assignment.rb:17
Mutineer::Mutators::OperatorAssignment::REPLACEMENTS = T.let(T.unsafe(nil), Hash)

# Range mutator (Tier-2).
#
# Swaps `..` with `...` and `...` with `..`, one mutation per range. The
# `..` -> `...` mutant survives when no test checks the last element.
# Flip-flops are FlipFlopNode, not RangeNode, so this mutator skips them.
#
# Endless ranges (`1..`, `1..nil`) are skipped. `(1..)` and `(1...)` give
# the same result for slicing, `include?`, `===`, `size` and patterns, so
# the mutant is equivalent and no normal test can kill it.
#
# pkg:gem/mutineer#lib/mutineer/mutators/range_literal.rb:16
class Mutineer::Mutators::RangeLiteral < ::Mutineer::Mutators::Base
  # Visits range nodes and emits range mutations.
  #
  # @param node [Prism::RangeNode] range node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/range_literal.rb:24
  def visit_range_node(node); end

  private

  # Emits the mutation that swaps the range operator.
  #
  # @param node [Prism::RangeNode] range node to mutate.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/range_literal.rb:43
  def emit(node); end

  # Whether the range has no end: `1..` or `1..nil`.
  #
  # @param node [Prism::RangeNode] range node to inspect.
  # @return [Boolean]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/range_literal.rb:35
  def endless?(node); end
end

# Maps each range operator to its opposite.
#
# pkg:gem/mutineer#lib/mutineer/mutators/range_literal.rb:18
Mutineer::Mutators::RangeLiteral::SWAPS = T.let(T.unsafe(nil), Hash)

# Regular-expression literal mutator (Tier-2).
#
# Conservative, clearly-safe textual swaps inside a plain regex literal:
# drop a leading +^+ anchor, drop a trailing +$+ anchor, and swap the +
# and * quantifiers. Interpolated regexes use a different node type and are
# never visited. Escaped tokens (preceded by a backslash) are left alone.
#
# pkg:gem/mutineer#lib/mutineer/mutators/regex_literal.rb:13
class Mutineer::Mutators::RegexLiteral < ::Mutineer::Mutators::Base
  # Visits regular-expression literals.
  #
  # @param node [Prism::RegularExpressionNode] node to inspect.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/regex_literal.rb:18
  def visit_regular_expression_node(node); end

  private

  # Emits a regex mutation.
  #
  # @param start_offset [Integer] byte start.
  # @param end_offset [Integer] byte end.
  # @param replacement [String] replacement text.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/regex_literal.rb:62
  def emit(start_offset, end_offset, replacement); end

  # Scans the pattern bytes and emits anchor/quantifier mutations.
  #
  # @param content [String] regex pattern between the slashes.
  # @param base [Integer] byte offset of the pattern start in source.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/regex_literal.rb:32
  def scan(content, base); end

  # Whether the pattern ends with an unescaped +$+ anchor.
  #
  # @param content [String] regex pattern.
  # @return [Boolean] true when a trailing anchor is droppable.
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/regex_literal.rb:52
  def trailing_anchor?(content); end
end

# Return-nil mutator.
#
# Replaces explicit return values and final expressions with nil.
