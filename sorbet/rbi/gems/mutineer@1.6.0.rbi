  #
  # pkg:gem/mutineer#lib/mutineer/mutators/safe_navigation.rb:52
  def visit_call_target_node(node); end

  private

  # Emits a mutation when the node's call operator is `&.`.
  #
  # @param node [Prism::Node] a node with `safe_navigation?` and `call_operator_loc`.
  # @return [void]
  #
  # pkg:gem/mutineer#lib/mutineer/mutators/safe_navigation.rb:63
  def emit(node); end
