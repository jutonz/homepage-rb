# A named source of runtime facts. <tt>archspec reflect</tt> runs each
# producer declared in +Archspec.rb+ in its own process: it boots the
# framework, analyzes the source, lets the producer record what it observes
# through a Facts::Builder, and writes <tt><facts>/<name>.yml</tt>.
#
#   ArchSpec.producer :widgets do
#     inputs "config/widgets.yml"          # global: a change invalidates every fact
#     sources "app/widgets/**/*.rb"        # per file: a change invalidates that file's facts
#     env "WIDGETS_ENV"                    # must match when a check sets it
#
#     boot { |root| require File.join(root, "config/environment") }
#
#     capture do |facts|
#       Widgets.registry.each do |widget, service|
#         facts.reference(source: widget, target: service, location: widget.declaration_site)
#       end
#     end
#   end
#
# Checks never run producers; they read the files they wrote.
#
# pkg:gem/archspec#lib/archspec/producer.rb:24
class ArchSpec::Producer
  # pkg:gem/archspec#lib/archspec/producer.rb:65
  def initialize(name, &block); end

  # pkg:gem/archspec#lib/archspec/producer.rb:94
  def boot(&block); end

  # pkg:gem/archspec#lib/archspec/producer.rb:98
  def capture(&block); end

  # Environment variables whose values shape what the producer observes.
  # They are recorded as captured, so do not name secrets.
  #
  # pkg:gem/archspec#lib/archspec/producer.rb:90
  def env(*names); end

  # pkg:gem/archspec#lib/archspec/producer.rb:25
  def env_names; end

  # pkg:gem/archspec#lib/archspec/producer.rb:25
  def input_patterns; end

  # Files outside the analyzed source whose change invalidates the whole
  # document. The defaults cover +config/+, the Gemfile and lockfile,
  # gemspecs, and the Ruby version.
  #
  # pkg:gem/archspec#lib/archspec/producer.rb:77
  def inputs(*patterns); end

  # pkg:gem/archspec#lib/archspec/producer.rb:25
  def name; end

  # Boots, analyzes, and captures; returns the validated document.
  #
  # pkg:gem/archspec#lib/archspec/producer.rb:103
  def run(definition, root); end

  # pkg:gem/archspec#lib/archspec/producer.rb:25
  def source_patterns; end

  # Analyzed files this producer inspects. A changed, added, or removed file
  # invalidates only the facts it contributed. Files the facts cite are
  # always covered.
  #
  # pkg:gem/archspec#lib/archspec/producer.rb:84
  def sources(*patterns); end

  private

  # pkg:gem/archspec#lib/archspec/producer.rb:128
  def origin(error, root); end

  class << self
    # Requires the file a declaration names, then returns the registered
    # producer. Paths starting with a dot resolve against +Archspec.rb+.
    #
    # pkg:gem/archspec#lib/archspec/producer.rb:38
    def load(name, definition); end

    # The first backtrace frame in the project, which is usually where the
    # fix belongs.
    #
    # pkg:gem/archspec#lib/archspec/producer.rb:58
    def origin(error, root); end

    # pkg:gem/archspec#lib/archspec/producer.rb:32
    def register(name, &block); end

    # pkg:gem/archspec#lib/archspec/producer.rb:28
    def registry; end
  end
end

# The built-in Rails producer. <tt>archspec reflect</tt> boots the
# application in a separate process and records what Rails itself resolved:
# association targets and generated methods, custom validator classes, and
# the effects conditional concern callbacks had on each consumer. Normal
# analysis never requires Rails.
#
# pkg:gem/archspec#lib/archspec/rails_reflector.rb:9
module ArchSpec::RailsReflector
  extend ::ArchSpec::RailsReflector

  # pkg:gem/archspec#lib/archspec/rails_reflector.rb:42
  def associations(facts, models, sites = T.unsafe(nil)); end

  # pkg:gem/archspec#lib/archspec/rails_reflector.rb:24
  def boot(root); end

  # Records every Rails fact for the loaded application.
  #
  # pkg:gem/archspec#lib/archspec/rails_reflector.rb:34
  def capture(facts, models: T.unsafe(nil), validated: T.unsafe(nil)); end

  # Conditional concern callbacks are gaps in static analysis. Once the
  # application is loaded, each consumer shows which candidate mixins and
  # methods it actually received. An effect is recorded only when exactly one
  # candidate explains it; the gap is resolved only when every consumer could
  # be inspected and every observed effect was attributed.
  #
  # pkg:gem/archspec#lib/archspec/rails_reflector.rb:115
  def concerns(facts); end

  # A validation such as <tt>validates :email, email: true</tt> names its
  # validator class only by convention. The loaded model knows the class
  # Rails resolved; the literal +validates+ call supplies the location.
  #
  # pkg:gem/archspec#lib/archspec/rails_reflector.rb:80
  def validators(facts, classes, sites = T.unsafe(nil)); end

  private

  # pkg:gem/archspec#lib/archspec/rails_reflector.rb:154
  def active_record_models; end

  # pkg:gem/archspec#lib/archspec/rails_reflector.rb:252
  def collect_sites(owners, path, node, sites); end

  # Each analyzed consumer with the conditional callbacks it runs: included
  # callbacks for an include, prepended callbacks for a prepend.
  #
  # pkg:gem/archspec#lib/archspec/rails_reflector.rb:199
  def consumers(graph, callbacks); end

  # Loads the application's own code, including engines inside the project,
  # but not installed gems: their models are not analyzed, and loading them
  # can require configuration the chosen environment does not have.
  #
  # pkg:gem/archspec#lib/archspec/rails_reflector.rb:144
  def eager_load_application; end

  # Literal association and validation declarations, found by parsing only
  # the files that define the given classes and their analyzed ancestors.
  #
  # pkg:gem/archspec#lib/archspec/rails_reflector.rb:242
  def macro_sites(graph, classes); end

  # pkg:gem/archspec#lib/archspec/rails_reflector.rb:183
  def observe_methods(facts, node, consumer, callbacks); end

  # Returns the concerns whose observed effects could not be attributed to a
  # single candidate declaration.
  #
  # pkg:gem/archspec#lib/archspec/rails_reflector.rb:166
  def observe_mixins(facts, node, consumer, callbacks); end

  # pkg:gem/archspec#lib/archspec/rails_reflector.rb:222
  def referenced?(graph, ancestors, name); end

  # pkg:gem/archspec#lib/archspec/rails_reflector.rb:211
  def runtime_constant(name); end

  # pkg:gem/archspec#lib/archspec/rails_reflector.rb:226
  def site_source(graph, klass, site); end

  # pkg:gem/archspec#lib/archspec/rails_reflector.rb:231
  def source_node(graph, model, candidates); end

  # pkg:gem/archspec#lib/archspec/rails_reflector.rb:158
  def validated_classes; end

  # pkg:gem/archspec#lib/archspec/rails_reflector.rb:276
  def validation_keys(arguments); end

  # pkg:gem/archspec#lib/archspec/rails_reflector.rb:217
  def validator_key?(key, validator); end
end

