  # pkg:gem/archspec#lib/archspec/todo.rb:79
  def root; end

  class << self
    # pkg:gem/archspec#lib/archspec/todo.rb:15
    def empty(root: T.unsafe(nil)); end

    # pkg:gem/archspec#lib/archspec/todo.rb:19
    def load(path, root:); end

    # pkg:gem/archspec#lib/archspec/todo.rb:44
    def write(path, diagnostics, root:); end
  end
end

# The keys an entry keeps. Anything else in the file, such as the line an
# older format recorded, is dropped so reports have one fixed shape.
#
# pkg:gem/archspec#lib/archspec/todo.rb:13
ArchSpec::Todo::FIELDS = T.let(T.unsafe(nil), Array)

# pkg:gem/archspec#lib/archspec/model.rb:151
ArchSpec::VERBS = T.let(T.unsafe(nil), Hash)

# pkg:gem/archspec#lib/archspec/version.rb:4
ArchSpec::VERSION = T.let(T.unsafe(nil), String)
