# The top-level DSL. Declare the project, its components, an architecture
# preset, and global rules.
#
#   root "."
#   source "app/**/*.rb", "lib/**/*.rb"
#   ignore "app/legacy/**/*.rb"
#   todo "archspec_todo.yml"
#
#   component :models, in: "app/models/**/*.rb"
#   component :controllers, in: "app/controllers/**/*.rb"
#   models.cannot_use :controllers
#
# Declaring a component defines a reader for it, so +models+ and
# +controllers+ above return an ArchSpec::DSL::ComponentProxy you attach
# rules to.
#
# pkg:gem/archspec#lib/archspec/dsl.rb:36
module ArchSpec::DSL::Context
  # Applies a bundled architecture preset, defining its components and
  # rules together.
  #
  #   architecture :rails
  #   architecture :hexagonal
  #   architecture :modular_monolith, components: { ... }, allow: { ... }
  #
  # +preset+ is an alias. Use whichever word fits: +architecture+ reads well
  # for structural bundles like +:rails+, +preset+ for convention packs like
  # +:ruby_conventions+.
  #
  # See ArchSpec::Architectures for every preset and its options.
  #
  # pkg:gem/archspec#lib/archspec/dsl.rb:156
  def architecture(name, **options); end

  # Declares a component: a named set of files, matched by glob, namespace,
  # explicit constant, or semantic ancestry.
  #
  #   component :services, in: "app/services/**/*.rb"
  #   component :workflows, in: "app/models/**/*.rb", except: "app/models/legacy/**/*.rb"
  #   component :billing, namespace: "Billing"
  #   component :legacy, constants: %w[OldReport OldExport]
  #   component :records, descendants_of: "ApplicationRecord"
  #
  # Returns an ArchSpec::DSL::ComponentProxy for attaching rules. The
  # component is also available by name later in the file.
  #
  # pkg:gem/archspec#lib/archspec/dsl.rb:130
  def component(name, in: T.unsafe(nil), except: T.unsafe(nil), namespace: T.unsafe(nil), constants: T.unsafe(nil), descendants_of: T.unsafe(nil)); end

  # Yields each subdirectory matching a glob, so you can declare one
  # component per engine or pack without hardcoding their names. Paths
  # resolve against the +Archspec.rb+ directory, not the working directory,
  # so it does not matter where +archspec+ is run from.
  #
  #   each_directory "engines/*" do |name, path|
  #     component name, in: "#{path}/**/*.rb"
  #   end
  #
  # Yields the directory basename and its root-relative path. Returns the
  # <tt>[name, path]</tt> pairs when called without a block.
  #
  # pkg:gem/archspec#lib/archspec/dsl.rb:108
  def each_directory(glob); end

  # Loads the facts that <tt>archspec reflect</tt> captured from this
  # directory. Checks only read these files; they never boot the app.
  #
  # pkg:gem/archspec#lib/archspec/dsl.rb:75
  def facts(path = T.unsafe(nil)); end

  # Adds glob patterns for files to skip. Combines with the built-in
  # ignores for +.git+, +.bundle+, +tmp+, +vendor+, and +node_modules+.
  # A built-in ignore steps aside for a component pattern whose literal
  # leading directories sit inside it, such as
  # <tt>vendor/engines/*/**/*.rb</tt>; patterns declared here always win.
  #
  # pkg:gem/archspec#lib/archspec/dsl.rb:57
  def ignore(*patterns); end

  # pkg:gem/archspec#lib/archspec/dsl.rb:181
  def method_missing(name, *, **, &); end

  # Forbids dependency cycles between components. Pass +among:+ to limit the
  # check to a subset; omit it to check every declared component.
  #
  #   no_cycles
  #   no_cycles among: %i[billing catalog shared]
  #
  # Rule id: +dependencies.no_cycles+.
  #
  # pkg:gem/archspec#lib/archspec/dsl.rb:169
  def no_cycles(among: T.unsafe(nil), because: T.unsafe(nil)); end

  # pkg:gem/archspec#lib/archspec/dsl.rb:160
  def preset(name, **options); end

  # Chooses the producers <tt>archspec reflect</tt> runs, and turns on
  # facts in +archspec_facts+ unless #facts names another directory.
  # Without it, a facts directory is filled by the built-in +:rails+
  # producer. Load your own producer from a gem or a project file:
  #
  #   reflect :rails
  #   reflect :widgets, require: "widgets/archspec"
  #   reflect :billing, require: "./lib/archspec/billing_facts"
  #
  # With <tt>auto: true</tt>, +check+ and +explain+ run the producer
  # themselves when its facts are missing or stale, which boots the app.
  # Leave it off where checks must not boot anything, such as CI.
  #
  # pkg:gem/archspec#lib/archspec/dsl.rb:91
  def reflect(*names, require: T.unsafe(nil), auto: T.unsafe(nil)); end

  # Sets or reads the project root that file patterns resolve against.
  # Defaults to the directory of the +Archspec.rb+ file.
  #
  # pkg:gem/archspec#lib/archspec/dsl.rb:39
  def root(path = T.unsafe(nil)); end

  # Adds a custom rule object. A rule responds to +id+ and
  # <tt>evaluate(graph)</tt>, returning ArchSpec::Diagnostic objects. Use
  # this to extend ArchSpec with project-specific checks.
  #
  # pkg:gem/archspec#lib/archspec/dsl.rb:177
  def rule(rule, because: T.unsafe(nil)); end

  # Adds glob patterns for the files ArchSpec parses. Defaults cover
  # +app+, +lib+, packs, and engines. Component patterns are always
  # analyzed, so most projects never need this.
  #
  # pkg:gem/archspec#lib/archspec/dsl.rb:48
  def source(*patterns); end

  # Points at a todo file of accepted violations. Diagnostics recorded there
  # are subtracted from future runs, so you can adopt ArchSpec in an existing
  # app without fixing everything first, then burn the list down.
  #
  #   todo "archspec_todo.yml"
  #
  # Write or refresh it with <tt>archspec check --update-todo</tt>; flag
  # entries that no longer match with <tt>archspec check --check-todo</tt>.
  #
  # pkg:gem/archspec#lib/archspec/dsl.rb:69
  def todo(path = T.unsafe(nil)); end

  private

  # pkg:gem/archspec#lib/archspec/dsl.rb:187
  def respond_to_missing?(name, include_private = T.unsafe(nil)); end
end

