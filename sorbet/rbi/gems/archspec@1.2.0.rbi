# The <tt>archspec</tt> command line. Backs the +exe/archspec+ executable and
# dispatches the +init+, +check+, +explain+, +reflect+, and +version+ subcommands.
#
#   archspec init
#   archspec check [PATHS...] [--config PATH] [--format text|json] [--update-todo|--check-todo] [--reflect]
#   archspec explain PATH_OR_CONSTANT [--reflect]
#
# #run returns the process exit status: 0 when clean, 1 when violations are
# found (or, with <tt>--check-todo</tt>, when the todo lists violations that
# no longer occur).
#
# pkg:gem/archspec#lib/archspec/cli.rb:18
module ArchSpec::CLI
  extend ::ArchSpec::CLI

  # Evaluates an +Archspec.rb+ file and returns the definition and its root.
  #
  # pkg:gem/archspec#lib/archspec/cli.rb:203
  def load_definition(config_path); end

  # pkg:gem/archspec#lib/archspec/cli.rb:31
  def run(argv, output: T.unsafe(nil), error: T.unsafe(nil)); end

  private

  # Analyzes with facts, first running the producers that --reflect or
  # <tt>reflect auto: true</tt> select when their documents are missing,
  # then again for any whose documents turn out stale.
  #
  # pkg:gem/archspec#lib/archspec/cli.rb:255
  def analyze_with_facts(definition, root, options, output); end

  # pkg:gem/archspec#lib/archspec/cli.rb:105
  def check(argv, output, error); end

  # pkg:gem/archspec#lib/archspec/cli.rb:175
  def explain(argv, output, error); end

  # pkg:gem/archspec#lib/archspec/cli.rb:331
  def formatter_for(name); end

  # pkg:gem/archspec#lib/archspec/cli.rb:65
  def help(argv, output); end

  # pkg:gem/archspec#lib/archspec/cli.rb:76
  def init(argv, output); end

  # pkg:gem/archspec#lib/archspec/cli.rb:227
  def reflect(argv, output); end

  # pkg:gem/archspec#lib/archspec/cli.rb:272
  def require_facts(definition, config_path); end

  # Runs each producer in its own process, in parallel, and reports every
  # failure after the others finish.
  #
  # pkg:gem/archspec#lib/archspec/cli.rb:280
  def run_producers(names, config_path, root, output, environment: T.unsafe(nil)); end

  # pkg:gem/archspec#lib/archspec/cli.rb:314
  def scope_entries_to_paths(entries, paths, root); end

  # A stale facts document affects every path, so it is always reported.
  #
  # pkg:gem/archspec#lib/archspec/cli.rb:304
  def scope_to_paths(diagnostics, paths, root, graph); end

  # pkg:gem/archspec#lib/archspec/cli.rb:325
  def todo_path_for(definition, root); end

  # pkg:gem/archspec#lib/archspec/cli.rb:342
  def usage(command = T.unsafe(nil)); end

  # pkg:gem/archspec#lib/archspec/cli.rb:321
  def within?(path, scopes); end
end

