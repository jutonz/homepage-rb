# A file of accepted existing violations. ArchSpec still checks the files
# these come from, but subtracts the recorded violations so you can adopt it
# in an existing app and burn the list down over time. Matched by
# ArchSpec::Diagnostic#fingerprint, so entries survive edits that shift lines.
#
# pkg:gem/archspec#lib/archspec/todo.rb:10
class ArchSpec::Todo
  # pkg:gem/archspec#lib/archspec/todo.rb:57
  def initialize(ids, root:); end

  # pkg:gem/archspec#lib/archspec/todo.rb:62
  def include?(diagnostic); end

  private

  # pkg:gem/archspec#lib/archspec/todo.rb:68
  def ids; end

  # pkg:gem/archspec#lib/archspec/todo.rb:68
  def root; end

  class << self
    # pkg:gem/archspec#lib/archspec/todo.rb:11
    def empty(root: T.unsafe(nil)); end

    # pkg:gem/archspec#lib/archspec/todo.rb:15
    def load(path, root:); end

    # pkg:gem/archspec#lib/archspec/todo.rb:39
    def write(path, diagnostics, root:); end
  end
end

