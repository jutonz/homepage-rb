# Backs ArchSpec::DSL::ComponentProxy#public_api. Flags references from
# outside the component to constants that are not part of its public API.
#
# pkg:gem/archspec#lib/archspec/rules/privacy_rule.rb:7
class ArchSpec::Rules::PublicApiRule
  # pkg:gem/archspec#lib/archspec/rules/privacy_rule.rb:10
  def initialize(source, files: T.unsafe(nil), constants: T.unsafe(nil), namespaces: T.unsafe(nil)); end

  # pkg:gem/archspec#lib/archspec/rules/privacy_rule.rb:8
  def constants; end

  # pkg:gem/archspec#lib/archspec/rules/privacy_rule.rb:32
  def evaluate(graph); end

  # pkg:gem/archspec#lib/archspec/rules/privacy_rule.rb:8
  def file_patterns; end

  # pkg:gem/archspec#lib/archspec/rules/privacy_rule.rb:28
  def id; end

  # pkg:gem/archspec#lib/archspec/rules/privacy_rule.rb:21
  def merge!(other); end

  # pkg:gem/archspec#lib/archspec/rules/privacy_rule.rb:17
  def merge_key; end

  # pkg:gem/archspec#lib/archspec/rules/privacy_rule.rb:8
  def namespaces; end

  # pkg:gem/archspec#lib/archspec/rules/privacy_rule.rb:8
  def source; end

  private

  # pkg:gem/archspec#lib/archspec/rules/privacy_rule.rb:76
  def normalize_constant(value); end

  # Names from public files and constants: match exactly. Reopened
  # namespace modules land in public files too, so prefix matching there
  # would make the whole namespace public. Use namespace: for prefixes.
  #
  # pkg:gem/archspec#lib/archspec/rules/privacy_rule.rb:68
  def public?(name, public_names); end

  # pkg:gem/archspec#lib/archspec/rules/privacy_rule.rb:56
  def public_constant_names(graph); end
end

# Attaches a human reason to any rule without coupling that metadata to the
# rule's implementation or to diagnostic fingerprints.
#
# pkg:gem/archspec#lib/archspec/rules/reasoned.rb:7
module ArchSpec::Rules::Reasoned
  # pkg:gem/archspec#lib/archspec/rules/reasoned.rb:8
  def archspec_because; end

  # pkg:gem/archspec#lib/archspec/rules/reasoned.rb:10
  def archspec_because=(reason); end

  # pkg:gem/archspec#lib/archspec/rules/reasoned.rb:22
  def evaluate(graph); end
end

# Tarjan's algorithm: the components that mutually reach each other, in one
# pass over the graph.
#
# pkg:gem/archspec#lib/archspec/rules/cycle_rule.rb:124
class ArchSpec::Rules::StronglyConnectedComponents
  # pkg:gem/archspec#lib/archspec/rules/cycle_rule.rb:129
  def initialize(adjacency); end

  # pkg:gem/archspec#lib/archspec/rules/cycle_rule.rb:139
  def components; end

  private

  # pkg:gem/archspec#lib/archspec/rules/cycle_rule.rb:157
  def follow(node, target); end

  # pkg:gem/archspec#lib/archspec/rules/cycle_rule.rb:166
  def pop_component(root); end

  # pkg:gem/archspec#lib/archspec/rules/cycle_rule.rb:146
  def visit(node); end

  class << self
    # pkg:gem/archspec#lib/archspec/rules/cycle_rule.rb:125
    def of(adjacency); end
  end
end

