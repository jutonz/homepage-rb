#!/usr/bin/env bash
# Create a sandbox and attach to it, or attach to one that already exists.
#
# A sandbox holds its own PostgreSQL, gems, node modules, and port 3000, so
# two of them cannot corrupt each other's data. See README.md.

. "$(dirname "$0")/host-lib.sh"

wait_only=no

if [ "${1:-}" = --wait ]; then
  wait_only=yes
  shift
fi

if [ "$#" -eq 0 ]; then
  echo "usage: .sbx/sandbox [--wait] NAME [sbx flags...]" >&2
  exit 1
fi

name="$1"
shift

if [ "$USE_TEMPLATE" = yes ] && ! template_exists; then
  say "no $TEMPLATE_TAG template; this sandbox builds from scratch," >&2
  say "which takes minutes rather than seconds." >&2
  say "run .sbx/build-template to make later sandboxes fast." >&2
fi

if [ "$wait_only" = no ]; then
  run_sandbox "$name" "$@"
  exit
fi

# sbx reports the status "running" before the startup scripts install the
# dependencies and prepare the databases. A caller that starts work at that
# moment races them, so wait for the kit to report the checkout ready.
if [ -z "$(sbx_state "$name")" ]; then
  create_sandbox "$name" "$@"
else
  # sbx has no start command. An exec starts a stopped sandbox.
  sbx exec "$name" true >/dev/null 2>&1 || true
fi

wait_until_ready "$name"
