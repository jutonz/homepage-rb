#!/usr/bin/env bash
# Create a sandbox and attach to it, or attach to one that already exists.
#
# A sandbox holds its own PostgreSQL, gems, node modules, and port 3000, so
# two of them cannot corrupt each other's data. See README.md.

. "$(dirname "$0")/host-lib.sh"

if [ "$#" -eq 0 ]; then
  echo "usage: .sbx/sandbox NAME [--agent $(echo $AGENTS | tr ' ' '|')]" \
    "[sbx flags...]" >&2
  exit 1
fi

name="$1"
shift

passthrough_argv=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --agent)
      AGENT="$2"
      shift 2
      ;;
    --agent=*)
      AGENT="${1#--agent=}"
      shift
      ;;
    *)
      passthrough_argv+=("$1")
      shift
      ;;
  esac
done

check_agent

if [ "$USE_TEMPLATE" = yes ] && ! template_exists; then
  say "no $(template_tag) template; this sandbox builds from scratch," >&2
  say "which takes minutes rather than seconds." >&2
  say "run .sbx/build-template $AGENT to make later sandboxes fast." >&2
fi

if [ "${#passthrough_argv[@]}" -eq 0 ]; then
  run_sandbox "$name"
else
  run_sandbox "$name" "${passthrough_argv[@]}"
fi
