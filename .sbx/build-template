#!/usr/bin/env bash
# Rebuild the local sandbox templates from the kit, on any Mac, with one
# command. A template is a cache, never a shipped artifact: it holds the
# toolchain and the gem and npm caches, and no repository state.
#
# There is one template per agent, because a template belongs to the agent
# whose sandbox it was saved from and sbx refuses it for any other. Name
# agents to build only those: .sbx/build-template claude
#
# No template is saved until the suite passes, so a broken environment can
# never become the thing every later sandbox starts from.

. "$(dirname "$0")/host-lib.sh"

# A build that started from the previous template would bake its mistakes in
# again. This always builds from the stock agent image.
USE_TEMPLATE=no

# A saved Template is shared by every later sandbox, so it must never carry
# the builder's own Linear identity even when they have LINEAR_API_KEY set.
FORWARD_LINEAR_KEY=no

# The build sandbox gets no staging mount, and IMPORT_SKILLS=no also turns
# off the shared skills mount. The startup step then finds nothing to copy,
# and the builder's personal configuration cannot reach a saved template.
PUSH_AGENT_CONFIG=no
IMPORT_SKILLS=no

if [ "$#" -gt 0 ]; then
  agents_to_build=("$@")
else
  # shellcheck disable=SC2206
  agents_to_build=($AGENTS)
fi

# TEMPLATE_TAG names one template, so it cannot describe a build that saves
# several. Each agent then gets its own derived tag.
if [ "${#agents_to_build[@]}" -gt 1 ]; then
  unset TEMPLATE_TAG
fi

# An agent image can arrive carrying the developer's own login, which a
# saved template would hand to every later sandbox. sbx injects a fresh
# credential at creation, so removing these costs the template nothing.
strip_agent_credentials() {
  local name="$1"

  sbx exec "$name" rm -rf \
    /home/agent/.claude/.credentials.json \
    /home/agent/.claude.json \
    /home/agent/.local/share/opencode/auth.json \
    >/dev/null 2>&1 || true
}

# The name is global so that the EXIT trap still resolves it once the
# function that set the trap has returned.
build_sandbox=

cleanup() {
  if [ -n "$build_sandbox" ]; then
    remove_sandbox "$build_sandbox"
  fi
}

trap cleanup EXIT

build_template() {
  build_sandbox="homepage-rb-template-build-$AGENT"

  local tag
  tag="$(template_tag)"

  remove_sandbox "$build_sandbox"

  say "creating $build_sandbox from the kit"
  create_sandbox "$build_sandbox"

  say "waiting for provisioning to finish"
  wait_until_ready "$build_sandbox"

  # The suite must pass, but not necessarily on the first attempt: one flaky
  # system spec (HPRB-112) would otherwise cost a whole rebuild and become
  # the reason the template is never refreshed.
  local attempt=1
  until in_sandbox "$build_sandbox" "mise exec -- bin/rspec"; do
    attempt=$((attempt + 1))

    if [ "$attempt" -gt "$SUITE_ATTEMPTS" ]; then
      say "the suite failed $SUITE_ATTEMPTS times; not saving $tag" >&2
      return 1
    fi

    say "the suite failed; attempt $attempt of $SUITE_ATTEMPTS"
  done

  strip_agent_credentials "$build_sandbox"

  say "saving $tag"
  sbx stop "$build_sandbox" >/dev/null
  sbx template save "$build_sandbox" "$tag"

  remove_sandbox "$build_sandbox"
  build_sandbox=

  say "$tag is ready; new $AGENT sandboxes will start from it"
}

for agent in "${agents_to_build[@]}"; do
  AGENT="$agent"
  check_agent
  build_template
done
