#!/usr/bin/env bash
# Install the Ruby and Node versions the repository pins, as the agent user so
# that the agent owns the toolchain it runs. Runs once, at sandbox creation.

. /home/agent/.sbx-kit/lib.sh

export MISE_YES=1

ruby_version="$(tool_version ruby)"
node_version="$(tool_version nodejs)"

# A source build of Ruby costs many minutes. Prebuilt binaries exist for this
# platform; if that ever stops being true this setting makes mise fail loudly
# rather than fall back to a silent recompile.
mise settings ruby.compile=false

say "installing ruby@$ruby_version and nodejs@$node_version"
mise install "ruby@$ruby_version" "nodejs@$node_version"
mise use --global "ruby@$ruby_version" "nodejs@$node_version"

# Ruby ships an older Bundler than Gemfile.lock records. Left alone, the first
# `bundle install` upgrades Bundler and restarts itself, and the restarted run
# resolves against the full RubyGems index instead of the compact one, which
# costs more than ten minutes.
pinned_bundler="$(bundler_version)"
say "installing bundler $pinned_bundler"
mise exec -- gem install bundler --version "$pinned_bundler" --no-document

# bin/dev installs foreman itself when it is missing, which would put a gem
# download on the critical path of every sandbox's first `bin/dev`.
say "installing foreman"
mise exec -- gem install foreman --no-document

say "toolchain ready: $(mise exec -- ruby --version)"
